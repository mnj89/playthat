    start_line: 650
    end_line: 796
    content: "                    <button\n                      onClick={() => onSelectSubtitleTrack?.(null)}\n                      className={`text-left px-2 py-1 text-xs rounded flex items-center justify-between ${\n                        !activeSubtitleTrack ? \'bg-blue-600/30 text-blue-400\' : \'hover:bg-slate-800\'\n                      }`}\n                    >\n                      <span>Off</span>\n                      {!activeSubtitleTrack && <Check className=\"w-3.5 h-3.5\" />}\n                    </button>\n                    {availableSubtitleTracks.map((trk) => (\n                      <button\n                        key={trk.id}\n                        onClick={() => onSelectSubtitleTrack?.(trk)}\n                        className={`text-left px-2 py-1 text-xs rounded flex items-center justify-between ${\n                          activeSubtitleTrack?.id === trk.id\n                            ? \'bg-blue-600/30 text-blue-400 font-medium\'\n                            : \'hover:bg-slate-800\'\n                        }`}\n                      >\n                        <span>{trk.label}</span>\n                        {activeSubtitleTrack?.id === trk.id && <Check className=\"w-3.5 h-3.5\" />}\n                      </button>\n                    ))}\n                  </div>\n                </div>\n              )}\n\n              {/* Lock Screen Action */}\n              <button\n                onClick={() => {\n                  setIsLocked(true);\n                  setShowSettingsMenu(false);\n                }}\n                className=\"w-full mt-1 py-1.5 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium flex items-center justify-center gap-2 text-slate-200\"\n              >\n                <Lock className=\"w-3.5 h-3.5\" />\n                <span>Lock Screen Touches</span>\n              </button>\n            </div>\n          )}\n\n          {/* Center Play/Pause Large Action */}\n          <div className=\"flex items-center justify-center pointer-events-none\">\n            <button\n              onClick={togglePlayPause}\n              className=\"pointer-events-auto p-4 rounded-full bg-slate-900/60 backdrop-blur-md text-white hover:bg-slate-900/80 transition-transform active:scale-90 border border-white/20\"\n            >\n              {isPlaying ? <Pause className=\"w-8 h-8\" /> : <Play className=\"w-8 h-8 translate-x-0.5\" />}\n            </button>\n          </div>\n\n          {/* Bottom Bar Controls */}\n          <div className=\"flex flex-col gap-2\">\n            {/* Timeline Scrubbing Bar */}\n            <div className=\"flex items-center gap-3\">\n              <span className=\"text-xs font-mono text-slate-300 w-12 text-right\">\n                {formatTime(currentTime)}\n              </span>\n              <div className=\"relative flex-1 flex items-center\">\n                <input\n                  type=\"range\"\n                  min={0}\n                  max={duration || 100}\n                  step={0.1}\n                  value={currentTime}\n                  onChange={handleSeek}\n                  className=\"w-full h-1.5 bg-slate-700/80 rounded-lg appearance-none cursor-pointer accent-blue-500 hover:h-2 transition-all\"\n                />\n              </div>\n              <span className=\"text-xs font-mono text-slate-400 w-12\">\n                {formatTime(duration)}\n              </span>\n            </div>\n\n            {/* Bottom Button Strip */}\n            <div className=\"flex items-center justify-between text-white\">\n              <div className=\"flex items-center gap-3\">\n                <button\n                  onClick={() => setIsLocked(true)}\n                  className=\"p-1.5 rounded-lg hover:bg-white/20 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Lock touch gestures\"\n                >\n                  <Unlock className=\"w-4 h-4\" />\n                </button>\n\n                <button\n                  onClick={() => {\n                    if (videoRef.current) {\n                      videoRef.current.currentTime = Math.max(0, videoRef.current.currentTime - 10);\n                    }\n                  }}\n                  className=\"p-1.5 rounded-lg hover:bg-white/20 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Rewind 10s\"\n                >\n                  <Rewind className=\"w-4 h-4\" />\n                </button>\n\n                <button\n                  onClick={togglePlayPause}\n                  className=\"p-1.5 rounded-lg hover:bg-white/20 text-slate-300 hover:text-white transition-colors\"\n                >\n                  {isPlaying ? <Pause className=\"w-5 h-5\" /> : <Play className=\"w-5 h-5\" />}\n                </button>\n\n                <button\n                  onClick={() => {\n                    if (videoRef.current) {\n                      videoRef.current.currentTime = Math.min(duration, videoRef.current.currentTime + 10);\n                    }\n                  }}\n                  className=\"p-1.5 rounded-lg hover:bg-white/20 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Forward 10s\"\n                >\n                  <FastForward className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              <div className=\"flex items-center gap-3\">\n                <button\n                  onClick={toggleFullscreen}\n                  className=\"p-1.5 rounded-lg hover:bg-white/20 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Toggle Fullscreen\"\n                >\n                  {isFullscreen ? <Minimize2 className=\"w-4 h-4\" /> : <Maximize2 className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Audio and Video Enhancements Studio Modal */}\n      <EnhancementsModal\n        isOpen={isEnhancementsModalOpen}\n        onClose={() => setIsEnhancementsModalOpen(false)}\n        config={enhancements}\n        onChange={(cfg) => {\n          setEnhancements(cfg);\n          onUpdateEnhancements?.(cfg);\n          if (cfg.decoder !== decoder) setDecoder(cfg.decoder);\n          if (cfg.aspectRatio !== aspectRatio) setAspectRatio(cfg.aspectRatio);\n        }}\n      />\n    </div>\n  );\n};\n"
    num_lines: 797
    num_bytes: 30157
    line_range_bytes: 6197
  }
}
