  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Play, Pause, SkipForward, Music2, Maximize2 } from \'lucide-react\';\nimport { AudioPlayerState, audioPlayerService } from \'../services/audioPlayerService\';\n\ninterface MiniMusicPlayerProps {\n  state: AudioPlayerState;\n  onOpenFullPlayer: () => void;\n}\n\nexport const MiniMusicPlayer: React.FC<MiniMusicPlayerProps> = ({ state, onOpenFullPlayer }) => {\n  const { currentTrack, isPlaying, currentTime, duration } = state;\n\n  if (!currentTrack) return null;\n\n  const progressPercent = duration > 0 ? (currentTime / duration) * 100 : 0;\n\n  return (\n    <div\n      onClick={onOpenFullPlayer}\n      className=\"w-full bg-slate-900/95 backdrop-blur-xl border-t border-slate-800/80 hover:bg-slate-850 transition-colors cursor-pointer select-none relative group z-30 shrink-0\"\n    >\n      {/* Top Progress Line */}\n      <div className=\"absolute top-0 left-0 right-0 h-0.5 bg-slate-800 overflow-hidden\">\n        <div\n          className=\"h-full bg-gradient-to-r from-cyan-400 to-blue-500 transition-all duration-200\"\n          style={{ width: `${Math.min(100, Math.max(0, progressPercent))}%` }}\n        />\n      </div>\n\n      <div className=\"h-14 px-3 flex items-center justify-between gap-3\">\n        {/* Album Art + Title */}\n        <div className=\"flex items-center gap-3 min-w-0 flex-1\">\n          <div className=\"relative w-10 h-10 rounded-xl overflow-hidden shadow-md shrink-0 border border-slate-700/60 bg-slate-800\">\n            {currentTrack.thumbnailUrl ? (\n              <img\n                src={currentTrack.thumbnailUrl}\n                alt={currentTrack.title}\n                referrerPolicy=\"no-referrer\"\n                className={`w-full h-full object-cover transition-transform duration-700 ${\n                  isPlaying ? \'scale-105\' : \'scale-100\'\n                }`}\n              />\n            ) : (\n              <div className=\"w-full h-full flex items-center justify-center bg-blue-950/60\">\n                <Music2 className=\"w-5 h-5 text-blue-400\" />\n              </div>\n            )}\n            {isPlaying && (\n              <div className=\"absolute inset-0 bg-blue-500/10 pointer-events-none\" />\n            )}\n          </div>\n\n          <div className=\"flex flex-col min-w-0\">\n            <span className=\"text-xs font-semibold text-white truncate group-hover:text-cyan-300 transition-colors\">\n              {currentTrack.title}\n            </span>\n            <span className=\"text-[11px] text-slate-400 truncate\">\n              {currentTrack.artist || currentTrack.album || \'PlayThat! Music\'}\n            </span>\n          </div>\n        </div>\n\n        {/* Quick Action Controls */}\n        <div\n          className=\"flex items-center gap-1 shrink-0\"\n          onClick={(e) => e.stopPropagation()}\n        >\n          <button\n            onClick={() => audioPlayerService.togglePlay()}\n            className=\"w-9 h-9 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center shadow-md active:scale-90 transition-transform\"\n            title={isPlaying ? \'Pause\' : \'Play\'}\n            aria-label={isPlaying ? \'Pause\' : \'Play\'}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-4 h-4 fill-white\" />\n            ) : (\n              <Play className=\"w-4 h-4 fill-white ml-0.5\" />\n            )}\n          </button>\n\n          <button\n            onClick={() => audioPlayerService.next()}\n            className=\"p-2 text-slate-400 hover:text-white rounded-full hover:bg-slate-800 active:scale-95 transition-all\"\n            title=\"Next Track\"\n            aria-label=\"Next Track\"\n          >\n            <SkipForward className=\"w-4 h-4\" />\n          </button>\n\n          <button\n            onClick={onOpenFullPlayer}\n            className=\"p-2 text-slate-400 hover:text-cyan-300 rounded-full hover:bg-slate-800 transition-colors hidden sm:flex\"\n            title=\"Expand Full Music Player\"\n          >\n            <Maximize2 className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/MiniMusicPlayer.tsx"
        }
        overwrite: true
      }
    }
