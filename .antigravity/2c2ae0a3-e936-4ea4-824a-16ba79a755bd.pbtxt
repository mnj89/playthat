    content: "export type DecoderMode = \'HW\' | \'HW+\' | \'SW\';\n\nexport type AspectRatioMode = \'fit\' | \'stretch\' | \'16:9\' | \'4:3\' | \'original\' | \'zoom\';\n\nexport interface MediaItem {\n  id: string;\n  title: string;\n  folder: string;\n  sourceType: \'local\' | \'stream\' | \'downloaded\';\n  url: string;\n  blobKey?: string;\n  thumbnailUrl: string;\n  duration: number; // in seconds\n  currentTime: number; // in seconds\n  resolution: string; // e.g., \'4K UHD\', \'1080p\', \'720p\'\n  fileSize: number; // in bytes\n  codec: string; // e.g., \'H.264 / AAC\', \'HEVC\', \'AV1\'\n  decoder: DecoderMode;\n  createdAt: number;\n  lastPlayedAt?: number;\n  isFavorite: boolean;\n  isEncrypted: boolean;\n  subtitleUrl?: string;\n  subtitleFormat?: \'srt\' | \'vtt\';\n}\n\nexport interface SubtitleCue {\n  start: number;\n  end: number;\n  text: string;\n}\n\nexport interface SubtitleTrack {\n  id: string;\n  label: string;\n  language: string;\n  cues: SubtitleCue[];\n  format: \'srt\' | \'vtt\';\n}\n\nexport interface SubtitleSettings {\n  fontSize: number; // in px: 14 to 36\n  textColor: string; // hex or color name\n  backgroundColor: string; // rgba\n  outlineColor: string;\n  outlineWidth: number; // 0 to 4\n  verticalOffset: number; // percent from bottom: 4 to 35\n  delayMs: number; // -5000 to +5000 ms\n}\n\nexport type DownloadStatus = \'downloading\' | \'paused\' | \'completed\' | \'error\' | \'queued\';\n\nexport interface DownloadTask {\n  id: string;\n  title: string;\n  url: string;\n  type: \'mp4\' | \'m3u8\' | \'webm\';\n  status: DownloadStatus;\n  progress: number; // 0 to 100\n  downloadedBytes: number;\n  totalBytes: number;\n  speedBytesPerSec: number;\n  segmentsLoaded?: number;\n  totalSegments?: number;\n  createdAt: number;\n  completedAt?: number;\n  outputBlobUrl?: string;\n  errorMessage?: string;\n  thumbnailUrl?: string;\n  duration?: number;\n  savePath?: string;\n}\n\nexport interface M3U8DownloadTask {\n  id: string;\n  title: string;\n  manifestUrl: string;\n  totalSegments: number;\n  downloadedSegments: number;\n  status: \'idle\' | \'sniffing\' | \'downloading\' | \'muxing\' | \'completed\' | \'error\';\n  errorMessage?: string;\n  speedKbps: number;\n  outputBlobUrl?: string;\n  outputSize?: number;\n  downloadDate?: number;\n  savePath?: string;\n}\n\nexport interface Playlist {\n  id: string;\n  title: string;\n  description?: string;\n  mediaIds: string[];\n  createdAt: number;\n  updatedAt: number;\n}\n\nexport type ActiveTab = \'folders\' | \'browser\' | \'downloads\' | \'playlists\' | \'vault\';\n"
    num_lines: 99
