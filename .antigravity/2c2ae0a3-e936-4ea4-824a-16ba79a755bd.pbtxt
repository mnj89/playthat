  view_file {
    absolute_path_uri: "file:///src/components/FileBrowser.tsx"
    end_line: 159
    content: "import React, { useState } from \'react\';\nimport {\n  Folder,\n  Film,\n  Play,\n  Search,\n  Upload,\n  Radio,\n  Lock,\n  Heart,\n  MoreVertical,\n  LayoutGrid,\n  List,\n  Trash2,\n  X,\n  Music,\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface FileBrowserProps {\n  mediaItems: MediaItem[];\n  onPlayMedia: (item: MediaItem) => void;\n  onOpenVault: () => void;\n  onImportLocalFile: (file: File) => void;\n  onOpenStreamDialog: () => void;\n  onToggleFavorite: (id: string) => void;\n  onDeleteMedia: (id: string) => void;\n  onAddToVault: (item: MediaItem) => void;\n}\n\nexport const FileBrowser: React.FC<FileBrowserProps> = ({\n  mediaItems,\n  onPlayMedia,\n  onOpenVault,\n  onImportLocalFile,\n  onOpenStreamDialog,\n  onToggleFavorite,\n  onDeleteMedia,\n  onAddToVault,\n}) => {\n  const [selectedFolder, setSelectedFolder] = useState<string>(\'All\');\n  const [mediaTypeFilter, setMediaTypeFilter] = useState<\'all\' | \'video\' | \'audio\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<\'grid\' | \'list\'>(\'grid\');\n  const [sortBy, setSortBy] = useState<\'date\' | \'name\' | \'size\' | \'duration\'>(\'date\');\n  const [activeMenuId, setActiveMenuId] = useState<string | null>(null);\n\n  // Calculate unique folders and counts\n  const folders = Array.from(new Set(mediaItems.map((m) => m.folder))).filter(Boolean);\n\n  // Filter media\n  const filteredMedia = mediaItems\n    .filter((item) => {\n      if (item.isEncrypted) return false;\n      const matchesFolder = selectedFolder === \'All\' || item.folder === selectedFolder;\n      const matchesSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase());\n      const isAudio = item.mediaType === \'audio\' || item.folder === \'Music\';\n      const matchesType =\n        mediaTypeFilter === \'all\' ||\n        (mediaTypeFilter === \'audio\' && isAudio) ||\n        (mediaTypeFilter === \'video\' && !isAudio);\n      return matchesFolder && matchesSearch && matchesType;\n    })\n    .sort((a, b) => {\n      if (sortBy === \'name\') return a.title.localeCompare(b.title);\n      if (sortBy === \'size\') return b.fileSize - a.fileSize;\n      if (sortBy === \'duration\') return b.duration - a.duration;\n      return b.createdAt - a.createdAt;\n    });\n\n  const formatDuration = (seconds: number) => {\n    if (isNaN(seconds)) return \'00:00\';\n    const s = Math.floor(seconds);\n    const mins = Math.floor(s / 60);\n    const secs = s % 60;\n    return `${mins}:${secs < 10 ? \'0\' : \'\'}${secs}`;\n  };\n\n  const formatFileSize = (bytes: number) => {\n    if (!bytes) return \'0 MB\';\n    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n  };\n\n  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      onImportLocalFile(file);\n    }\n  };\n\n  return (\n    <div className=\"flex-1 w-full flex flex-col bg-black text-white overflow-hidden\">\n      {/* Top Action Toolbar (Monochrome) */}\n      <div className=\"p-3 bg-zinc-950 border-b border-zinc-850 flex flex-col gap-2.5 shrink-0\">\n        {/* Row 1: Complete Line Search Bar */}\n        <div className=\"relative w-full\">\n          <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search media by title...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full h-10 pl-10 pr-9 bg-zinc-900 border border-zinc-800 focus:border-zinc-500 rounded-2xl text-xs text-white placeholder:text-zinc-500 focus:outline-none transition-all\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors\"\n              title=\"Clear search\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {/* Row 2: Actions & View Controls Strip */}\n        <div className=\"flex items-center justify-between gap-2\">\n          {/* Quick Import & Stream Actions */}\n          <div className=\"flex items-center gap-1.5\">\n            <label\n              className=\"px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 cursor-pointer transition-colors border border-zinc-800 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Open file from device\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-white\" />\n              <span>Open File</span>\n              <input\n                type=\"file\"\n                accept=\"video/*,audio/*\"\n                onChange={handleFileInputChange}\n                className=\"hidden\"\n              />\n            </label>\n\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 transition-colors border border-zinc-800 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-white\" />\n              <span>Stream URL</span>\n            </button>\n          </div>\n\n          {/* Sort Selector & View Mode Toggle */}\n          <div className=\"flex items-center gap-1.5\">\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as any)}\n              className=\"bg-zinc-900 text-zinc-300 text-[11px] font-medium border border-zinc-800 rounded-xl px-2 py-1.5 focus:outline-none focus:border-zinc-600 cursor-pointer\"\n            >\n              <option value=\"date\">Latest</option>\n              <option value=\"name\">Name</option>\n              <option value=\"size\">Size</option>\n              <option value=\"duration\">Duration</option>\n            </select>\n\n            <div className=\"flex items-center bg-zinc-900 rounded-xl p-0.5 border border-zinc-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-lg transition-colors ${"
    num_lines: 452
