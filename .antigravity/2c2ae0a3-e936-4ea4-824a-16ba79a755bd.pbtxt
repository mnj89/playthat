            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (lastTapRef.current && now - lastTapRef.current.time < 300) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
