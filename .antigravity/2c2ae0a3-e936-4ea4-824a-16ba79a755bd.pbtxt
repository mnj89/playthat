  view_file {
    absolute_path_uri: "file:///src/components/AndroidFrame.tsx"
    end_line: 139
    content: "import React, { useState, useEffect } from \'react\';\nimport {\n  Wifi,\n  BatteryMedium,\n  Signal,\n  Smartphone,\n  Monitor,\n  Tablet,\n  Music,\n  Play,\n  Pause,\n  SkipBack,\n  SkipForward,\n  Lock,\n  Unlock,\n  ChevronDown,\n  Bell,\n  Sliders,\n  Volume2,\n  ChevronUp,\n} from \'lucide-react\';\nimport { audioPlayerService, AudioPlayerState } from \'../services/audioPlayerService\';\n\nexport type FrameMode = \'phone\' | \'tablet\' | \'responsive\';\n\ninterface AndroidFrameProps {\n  children: React.ReactNode;\n  frameMode: FrameMode;\n  onFrameModeChange: (mode: FrameMode) => void;\n  isPlayerActive?: boolean;\n  onOpenFullMusicPlayer?: () => void;\n}\n\nexport const AndroidFrame: React.FC<AndroidFrameProps> = ({\n  children,\n  frameMode,\n  onFrameModeChange,\n  isPlayerActive = false,\n  onOpenFullMusicPlayer,\n}) => {\n  const [currentTimeStr, setCurrentTimeStr] = useState<string>(\'12:45\');\n  const [currentDateStr, setCurrentDateStr] = useState<string>(\'Friday, Oct 24\');\n  const [isPhoneLocked, setIsPhoneLocked] = useState<boolean>(false);\n  const [isNotificationShadeOpen, setIsNotificationShadeOpen] = useState<boolean>(false);\n  const [audioState, setAudioState] = useState<AudioPlayerState>(audioPlayerService.getState());\n\n  useEffect(() => {\n    const updateTime = () => {\n      const d = new Date();\n      setCurrentTimeStr(\n        d.toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', hour12: false })\n      );\n      setCurrentDateStr(\n        d.toLocaleDateString([], { weekday: \'long\', month: \'short\', day: \'numeric\' })\n      );\n    };\n    updateTime();\n    const interval = setInterval(updateTime, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  // Subscribe to audio player service\n  useEffect(() => {\n    const unsubscribe = audioPlayerService.subscribe((state) => {\n      setAudioState(state);\n    });\n    return unsubscribe;\n  }, []);\n\n  const formatSecs = (sec: number) => {\n    if (isNaN(sec) || sec < 0) return \'0:00\';\n    const m = Math.floor(sec / 60);\n    const s = Math.floor(sec % 60);\n    return `${m}:${s < 10 ? \'0\' : \'\'}${s}`;\n  };\n\n  const progressPercent =\n    audioState.duration > 0 ? (audioState.currentTime / audioState.duration) * 100 : 0;\n\n  // Render Android Media Notification Card\n  const renderMediaNotificationCard = (isLockscreen = false) => {\n    if (!audioState.currentTrack) return null;\n\n    return (\n      <div\n        className={`w-full rounded-2xl p-3 border transition-all ${\n          isLockscreen\n            ? \'bg-slate-900/80 border-slate-700/60 backdrop-blur-xl shadow-2xl\'\n            : \'bg-slate-800/95 border-slate-700/80 shadow-lg\'\n        }`}\n      >\n        <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-white/10 text-[10px] text-slate-400\">\n          <div className=\"flex items-center gap-1.5\">\n            <div className=\"w-2 h-2 rounded-full bg-blue-400 animate-pulse\" />\n            <span className=\"font-semibold text-slate-200\">PlayThat! Music</span>\n            <span>\302\267</span>\n            <span className=\"text-cyan-400 font-mono\">Hi-Res Audio</span>\n          </div>\n          <span className=\"text-slate-400\">Device Speaker</span>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {/* Thumbnail */}\n          <div\n            onClick={() => onOpenFullMusicPlayer && onOpenFullMusicPlayer()}\n            className=\"w-12 h-12 rounded-xl overflow-hidden bg-slate-950 shrink-0 border border-slate-700 cursor-pointer shadow-md\"\n          >\n            <img\n              src={audioState.currentTrack.thumbnailUrl}\n              alt={audioState.currentTrack.title}\n              referrerPolicy=\"no-referrer\"\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          {/* Title & Artist */}\n          <div\n            onClick={() => onOpenFullMusicPlayer && onOpenFullMusicPlayer()}\n            className=\"flex-1 min-w-0 cursor-pointer\"\n          >\n            <h5 className=\"text-xs font-bold text-white truncate\">\n              {audioState.currentTrack.title}\n            </h5>\n            <p className=\"text-[11px] text-slate-400 truncate\">\n              {audioState.currentTrack.artist || audioState.currentTrack.album || \'PlayThat! Audio\'}\n            </p>\n          </div>\n\n          {/* Quick Notification Controls */}\n          <div className=\"flex items-center gap-1 shrink-0\">\n            <button\n              onClick={() => audioPlayerService.previous()}\n              className=\"p-1.5 text-slate-300 hover:text-white rounded-full hover:bg-white/10 transition-colors\"\n              title=\"Previous\"\n            >\n              <SkipBack className=\"w-4 h-4 fill-slate-300\" />\n            </button>\n\n            <button\n              onClick={() => audioPlayerService.togglePlay()}"
    num_lines: 493
    num_bytes: 20972
    line_range_bytes: 4752
  }
}
