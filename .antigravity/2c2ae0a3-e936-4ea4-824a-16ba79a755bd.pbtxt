            }
            lines {
              text: "                <code>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  npx @bubblewrap/cli init --manifest={appUrl}/manifest.webmanifest<br />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  npx @bubblewrap/cli build"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </code>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
