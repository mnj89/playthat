      original_chunk {
        target_content: "  // 1. EMERGENCY DISGUISE: Functional Android Calculator View (Monochrome)\n  if (isDisguised) {\n    return (\n      <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black text-white animate-in fade-in duration-150\">\n        <div className=\"w-full max-w-sm bg-zinc-950 border border-zinc-800 rounded-[32px] p-6 shadow-2xl flex flex-col justify-between h-[640px]\">\n          {/* Top subtle bar */}\n          <div className=\"flex items-center justify-between text-zinc-500 text-xs font-mono\">\n            <span>Calculator</span>\n            <button\n              onClick={() => setIsDisguised(false)}\n              className=\"p-1 hover:text-white\"\n              title=\"Exit disguise\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n\n          {/* Calculator Screen */}\n          <div className=\"flex flex-col items-end justify-end py-6 px-2 min-h-[140px] border-b border-zinc-850\">\n            <span className=\"text-sm font-mono text-zinc-400\">{calcHistory}</span>\n            <span className=\"text-4xl font-mono font-bold tracking-tight text-white mt-1\">\n              {calcDisplay}\n            </span>\n          </div>\n\n          {/* Calculator Keypad */}\n          <div className=\"grid grid-cols-4 gap-3\">\n            {[\'C\', \'(\', \')\', \'\303\267\', \'7\', \'8\', \'9\', \'\303\227\', \'4\', \'5\', \'6\', \'-\', \'1\', \'2\', \'3\', \'+\', \'0\', \'.\', \'\342\214\253\', \'=\'].map(\n              (btn) => (\n                <button\n                  key={btn}\n                  onClick={() => {\n                    if (btn === \'\342\214\253\') {\n                      setCalcDisplay((prev) => (prev.length > 1 ? prev.slice(0, -1) : \'0\'));\n                    } else {\n                      handleCalcButton(btn);\n                    }\n                  }}\n                  className={`h-14 rounded-2xl text-lg font-mono font-semibold transition-transform active:scale-95 flex items-center justify-center ${\n                    btn === \'=\'\n                      ? \'bg-white text-black font-bold shadow-md\'\n                      : [\'\303\267\', \'\303\227\', \'-\', \'+\'].includes(btn)\n                      ? \'bg-zinc-800 text-white border border-zinc-700\'\n                      : btn === \'C\'\n                      ? \'bg-zinc-900 text-zinc-300 border border-zinc-800\'\n                      : \'bg-zinc-900 text-zinc-200 hover:bg-zinc-850 border border-zinc-850\'\n                  }`}\n                >\n                  {btn}\n                </button>\n              )\n            )}\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-md animate-in fade-in duration-200 text-white\">\n      <div className=\"w-full max-w-md bg-zinc-950 border border-zinc-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col\">\n        {/* Modal Top Bar */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-zinc-850\">\n          <div className=\"flex items-center gap-2.5\">\n            <ShieldCheck className=\"w-5 h-5 text-white\" />\n            <h3 className=\"text-sm font-bold text-white\">\n              {isUnlocked ? \'Private Encrypted Vault\' : \'Secure Vault Authentication\'}\n            </h3>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {isUnlocked && (\n              <button\n                onClick={() => setIsDisguised(true)}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-300 flex items-center gap-1.5 transition-colors border border-zinc-800\"\n                title=\"Quick Disguise as Calculator\"\n              >\n                <Calculator className=\"w-3.5 h-3.5 text-zinc-400\" />\n                <span>Disguise</span>\n              </button>\n            )}\n\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-full hover:bg-zinc-850 text-zinc-400 hover:text-white transition-colors\"\n            >\n              <X className=\"w-4 h-4\" />\n            </button>\n          </div>\n        </div>"
        replacement_content: "  const handleCloseModal = () => {\n    setIsDisguised(false);\n    setPinInput(\'\');\n    setConfirmPinInput(\'\');\n    setErrorMessage(null);\n    onClose();\n  };\n\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'Escape\' && isOpen) {\n        handleCloseModal();\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, [isOpen]);\n\n  // Guard: Do not render if not open\n  if (!isOpen) {\n    return null;\n  }\n\n  // 1. EMERGENCY DISGUISE: Functional Android Calculator View (Monochrome)\n  if (isDisguised) {\n    return (\n      <div\n        onClick={(e) => {\n          if (e.target === e.currentTarget) handleCloseModal();\n        }}\n        className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/90 backdrop-blur-md text-white animate-in fade-in duration-150\"\n      >\n        <div className=\"w-full max-w-sm bg-zinc-950 border border-zinc-800 rounded-[32px] p-6 shadow-2xl flex flex-col justify-between h-[640px]\">\n          {/* Top subtle bar */}\n          <div className=\"flex items-center justify-between text-zinc-500 text-xs font-mono\">\n            <span>Calculator</span>\n            <div className=\"flex items-center gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => setIsDisguised(false)}\n                className=\"px-2 py-0.5 rounded text-[11px] bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors\"\n                title=\"Return to Vault view\"\n              >\n                Vault\n              </button>\n              <button\n                type=\"button\"\n                onClick={handleCloseModal}\n                className=\"p-1 hover:text-white rounded-lg hover:bg-zinc-800 transition-colors\"\n                title=\"Close\"\n                aria-label=\"Close\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Calculator Screen */}\n          <div className=\"flex flex-col items-end justify-end py-6 px-2 min-h-[140px] border-b border-zinc-850\">\n            <span className=\"text-sm font-mono text-zinc-400\">{calcHistory}</span>\n            <span className=\"text-4xl font-mono font-bold tracking-tight text-white mt-1\">\n              {calcDisplay}\n            </span>\n          </div>\n\n          {/* Calculator Keypad */}\n          <div className=\"grid grid-cols-4 gap-3\">\n            {[\'C\', \'(\', \')\', \'\303\267\', \'7\', \'8\', \'9\', \'\303\227\', \'4\', \'5\', \'6\', \'-\', \'1\', \'2\', \'3\', \'+\', \'0\', \'.\', \'\342\214\253\', \'=\'].map(\n              (btn) => (\n                <button\n                  key={btn}\n                  onClick={() => {\n                    if (btn === \'\342\214\253\') {\n                      setCalcDisplay((prev) => (prev.length > 1 ? prev.slice(0, -1) : \'0\'));\n                    } else {\n                      handleCalcButton(btn);\n                    }\n                  }}\n                  className={`h-14 rounded-2xl text-lg font-mono font-semibold transition-transform active:scale-95 flex items-center justify-center ${\n                    btn === \'=\'\n                      ? \'bg-white text-black font-bold shadow-md\'\n                      : [\'\303\267\', \'\303\227\', \'-\', \'+\'].includes(btn)\n                      ? \'bg-zinc-800 text-white border border-zinc-700\'\n                      : btn === \'C\'\n                      ? \'bg-zinc-900 text-zinc-300 border border-zinc-800\'\n                      : \'bg-zinc-900 text-zinc-200 hover:bg-zinc-850 border border-zinc-850\'\n                  }`}\n                >\n                  {btn}\n                </button>\n              )\n            )}\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div\n      onClick={(e) => {\n        if (e.target === e.currentTarget) handleCloseModal();\n      }}\n      className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/85 backdrop-blur-md animate-in fade-in duration-200 text-white\"\n    >\n      <div className=\"w-full max-w-md bg-zinc-950 border border-zinc-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col\">\n        {/* Modal Top Bar */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-zinc-850\">\n          <div className=\"flex items-center gap-2.5\">\n            <ShieldCheck className=\"w-5 h-5 text-white\" />\n            <h3 className=\"text-sm font-bold text-white\">\n              {isUnlocked ? \'Private Encrypted Vault\' : \'Secure Vault Authentication\'}\n            </h3>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {isUnlocked && (\n              <button\n                type=\"button\"\n                onClick={() => setIsDisguised(true)}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-lg bg-zinc-900 hover:bg-zinc-800 text-zinc-300 flex items-center gap-1.5 transition-colors border border-zinc-800\"\n                title=\"Quick Disguise as Calculator\"\n              >\n                <Calculator className=\"w-3.5 h-3.5 text-zinc-400\" />\n                <span>Disguise</span>\n              </button>\n            )}\n\n            <button\n              type=\"button\"\n              onClick={handleCloseModal}\n              className=\"p-2 rounded-full hover:bg-zinc-800 active:bg-zinc-700 text-zinc-400 hover:text-white transition-colors cursor-pointer\"\n              title=\"Close Vault\"\n              aria-label=\"Close\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>"
