    content: "            </label>\n\n            {/* Network Stream URL */}\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>Stream URL</span>\n            </button>\n          </div>\n\n          {/* Sort Selector & View Mode Toggle */}\n          <div className=\"flex items-center gap-1.5\">\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as any)}\n              className=\"bg-slate-950 text-slate-300 text-[11px] font-medium border border-slate-800 rounded-xl px-2 py-1.5 focus:outline-none focus:border-blue-500 cursor-pointer\"\n            >\n              <option value=\"date\">Latest</option>\n              <option value=\"name\">Name</option>\n              <option value=\"size\">Size</option>\n              <option value=\"duration\">Duration</option>\n            </select>\n\n            <div className=\"flex items-center bg-slate-950 rounded-xl p-0.5 border border-slate-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'grid\' ? \'bg-blue-600 text-white shadow-sm\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"Grid View\"\n              >\n                <LayoutGrid className=\"w-3.5 h-3.5\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'list\' ? \'bg-blue-600 text-white shadow-sm\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"List View\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Horizontal Folder Scroller (MX Player style) */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-0.5 text-xs\">\n          <button\n            onClick={() => setSelectedFolder(\'All\')}\n            className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors font-medium ${\n              selectedFolder === \'All\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'bg-slate-800/80 text-slate-400 hover:text-white\'\n            }`}\n          >\n            All Videos ({mediaItems.filter((m) => !m.isEncrypted).length})\n          </button>\n\n          {folders.map((fName) => {\n            const count = mediaItems.filter((m) => m.folder === fName && !m.isEncrypted).length;\n            return (\n              <button\n                key={fName}\n                onClick={() => setSelectedFolder(fName)}\n                className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-medium ${\n                  selectedFolder === fName\n                    ? \'bg-blue-600 text-white shadow-sm\'\n                    : \'bg-slate-800/80 text-slate-400 hover:text-white\'\n                }`}\n              >\n                <Folder className=\"w-3.5 h-3.5 text-amber-400/80\" />\n                <span>{fName}</span>\n                <span className=\"text-[10px] text-slate-400 font-mono\">({count})</span>\n              </button>\n            );\n          })}\n\n          {/* Encrypted Vault Entry Pill */}\n          <button\n            onClick={onOpenVault}\n            className=\"px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/60 hover:bg-emerald-900/60\"\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Private Vault</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Video Grid / List */}\n      <div className=\"flex-1 overflow-y-auto p-4\">\n        {filteredMedia.length === 0 ? (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-12 text-center gap-3 text-slate-400\">\n            <Film className=\"w-12 h-12 text-slate-700\" />\n            <span className=\"text-sm font-semibold text-white\">No media files found</span>\n            <span className=\"text-xs text-slate-400 max-w-xs\">\n              Open a local video from your device or stream an M3U8 link from the top bar.\n            </span>"
    num_lines: 408
    num_bytes: 17859
    line_range_bytes: 4577
  }
}
