      thinking_signature: "\022\266\v\n\263\v\001i\024}\023\346\322,)u\265]Y:\233\265;K\334\346\341}\217y\247\255\201R\377\367V\3455\354\362\231\327\351\325\364\306\00396\336\031\242\2256|~\330\375\337\313^V{\363m}hy\370`\b\334\373\2418\b\220\032h\026\213\307\331p\236\346a|\247\303\362\002I+\260~\207\350h-\023\bI\276P\263\250\265\251\246)\n\372\004\222Hi\327\237\2267\257J`\250{{\303\360f\336\000O\262\266\252\371\254\234\332\037\371\270\377\316\275\256\250Dq\n\331b\300SQ\351\261\370\334\361X\335\316gt\276\\n\026\312\217|\302\264\2171l\251P\267\341\241\3003H7z\001#\r]\222\212\221\003[\'+q\351%\337\270L9\330\033\2273z\006J\305\006\000\255\324\326\361\0029\231Tm1^\367\324\241nz\236\\\220\302<v\306\237\360U.\032\004~V\265$\367\307\370\302F\364\346\001\320\201\002\'\225$\366`SC\b\230\223!\251T\034\2035\305#3\321\373\002\343RH\216\223\376&\\\252U\220\326F\v\005\361\233\017\225\343d\327\262y\322\215\016\204\372\371\231#\341\331\306\271P\264q\247\362\002\343\203\317\306\"\316\234y\254\375\213-^K\031@4\326\200\215\327\030\215x \377\254\227E\251\364Q0\200\204\300y=\2579\370\332\rf\026\022\377{\035\304\335\017r,\271\1778e6\031\373\377\f\222m\037\274fY\310\373;`.\264\\\2036\205\254\232\247\261O\303\250\314q\027\302M\247b\314J\243\f\262\005\256\032\266\030\356-o[\356\177j\003+\201\256\f\353<{F^2\363z\022\177z\373\361\200\271c\000\212\330\324I\317\357\347\326\265\273\251\260[\376\217\342%&\327Y\332\243E\326\266\374\342NF\253\031\205\002K\020Z^\016\207\334\335~2\350<\223\217\311\302\216\316\264\306\337\201\3006\271\021\271\327\352\316,\037\312\376\321%n\235L\'F\212-\302\tB\337\bp\a8m\343\210u\326\317\t\247\232m\026#_<4h\261>#\364\240z0\034`-\v\f\243\333\023`\200\300.I\0335Aj\311Ym\266\336\363\302\263\026\177\bl\266\037\002]\371\213]=\"Mw\351\3253\235\241\324\a\327g*\230\r\307\017!+\255\323\212\230\245*Z>\'\002L\266\267\326MO{\341\343\370\001\251\277\025N\251\252\313d\257\263,Q25\234\213\237Wu\206\377g\017\250\225\020\357\005D\250\310\212\306^-F\177j\024}w\000\372Q\342c\352\303\261\252\275\212\263h\346@\347\356V\244 \363m-\217\254:\230@\220\342\204\337\276\203m\354\345\022\235F\341)\300\216\331\246\\\210\027\00477T\304\006pp\334\230\305\243[\341\264\223\003\3255%\021\024\303\270T\030_r\230\251\256#\031\301\\\207\t2dtH\215\226\307\026\226\037/\314\314\333\212\031{\360\203\316:K\247\337:\263\031\036\317\261\'\003\251}\2628\263\323\004\365\224yl\343>\217\347\237\356eG\001&\267d\2442\267\255\203\'\207{P\336a\305I\366BX\203Z\255\366c\002\262HB\356+\226\225\362\340o\032\201\322\277\241n\237v\311\226\345\340yK\361\037@2\177n[\211\230\224\331#\246$\026\366\351v\2600\244\266K}\256\351\326L2l\217s\313\273\366\251\270\344\005\331s+w|\233(\253\233\000\307\346\343\314zr\223\372\023\333G\336\037\201\037\371|4P\241Dzu\230b*\347\026Aun\3311\334\230\214\021D\320\035`\302\335U4\003\276\256I\230b\275\273L\030\020p\0275\377g\316e]W\023\3075s\211\241\r\332PJ\200@\352M0\205\267\360*\021\\\031\352\234+\374\362\317\352W\244\215\000ZrK\234\214\215;\361,?\32714\315\017J\\\205\302R5 U\275\202\374\217\024\356\b\037z\251U:_\336\3710|x\223\354\215\370D\232J.i\253Wk\326\346h\276\324\212(L\310\242{\213\307\322\002\021Q\267\346\216C`\017\236\264\326BO\303|\314_\031}\377\312\200\371\300\316\212\243\032R\363\310\250\212\351\322=\365\306{#\313=S}\037\274\312n\241\3049\332\205zL\311\375\346\006j Z\222k<\032:\245\312\020\204\275\216\206+\2461\355\316\202T\020\f\006\331\226:1\223\235X\261u\006|\265Z\016\3716\342\344Q\362]\251\233}4\030\v*\240\322s\034\247\256\272^\373\232\000\372\322\210\235g\376\356\231\212io\360\361S\301\351\003\241\330\315\0003\331`\212\017I\327x\346rx\034x\311\212\016a\320|+~xl\263\ftO\306o\016\267NX\377\\\313\237W\261*P\221C\275L\365\034m\211\232\227\226\035\204\266(\275+\r\177\\\344g\264\227@\256\333?q\354\005\271\217\274\256\264\a#\327 +|\022\033\t\326L\366\370_\325\240,\220$U\005\362+x\346\325A\f\304\2143\316\274{\345\257\247\270\362\241\2341\301BA\a+\363`zD\366moI:\304\244R\216\345\364\021x.\037S\332l\021%i\301\305\030a\317c\351:\300P\f\f\234]\205X\316\201\251n\022\207\347\244(\216\b\240\250\263\277#d\"\002$X\311\265PZ\220\0000\255\212\333\276\231\232\343\325\263W\3149Y\376\245\260i5\242\330.+\322J\'\2668=\232\351!(9\210\226\021\267v&\346\235\264\374\314"
