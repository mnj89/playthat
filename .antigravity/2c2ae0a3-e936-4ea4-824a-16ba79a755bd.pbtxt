            lines {
              text: "              <p className=\"text-zinc-400 leading-relaxed text-[11px]\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                If you have Node.js and Android SDK installed on your PC, you can compile the production APK in two commands:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
