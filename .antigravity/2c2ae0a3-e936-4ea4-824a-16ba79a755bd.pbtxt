    content: "                    Add media files from the main library or downloaded streams.\n                  </span>\n                </div>\n              ) : (\n                <div className=\"flex flex-col gap-2\">\n                  {activeMediaList.map((item, index) => (\n                    <div\n                      key={item.id}\n                      onClick={() => onPlayMedia(item)}\n                      className=\"p-3 rounded-2xl bg-zinc-950 border border-zinc-850 hover:border-zinc-700 flex items-center justify-between gap-3 cursor-pointer transition-colors\"\n                    >\n                      <div className=\"flex items-center gap-3 min-w-0\">\n                        <span className=\"text-xs font-mono font-bold text-zinc-500 w-5\">\n                          {index + 1}\n                        </span>\n                        <div className=\"w-16 h-10 rounded-lg bg-black overflow-hidden shrink-0 border border-zinc-800\">\n                          <img\n                            src={item.thumbnailUrl}\n                            alt={item.title}\n                            referrerPolicy=\"no-referrer\"\n                            className=\"w-full h-full object-cover filter grayscale\"\n                          />\n                        </div>\n                        <div className=\"flex flex-col min-w-0\">\n                          <span className=\"text-xs font-semibold text-white truncate\">\n                            {item.title}\n                          </span>\n                          <span className=\"text-[10px] font-mono text-zinc-400\">\n                            {item.artist || item.folder} \302\267 {item.resolution}\n                          </span>\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            onRemoveFromPlaylist(activePlaylist.id, item.id);\n                          }}\n                          className=\"p-1 rounded-lg text-zinc-500 hover:text-white\"\n                          title=\"Remove from playlist\"\n                        >\n                          <X className=\"w-4 h-4\" />\n                        </button>\n                        <button\n                          onClick={(e) => {\n                            e.stopPropagation();\n                            onPlayMedia(item);\n                          }}\n                          className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center hover:bg-zinc-200\"\n                        >\n                          <Play className=\"w-3.5 h-3.5 fill-black ml-0.5\" />\n                        </button>\n                      </div>\n                    </div>\n                  ))}\n                </div>\n              )}\n            </>\n          ) : (\n            <div className=\"p-8 text-center text-zinc-500\">Select a playlist on the left</div>\n          )}\n        </div>\n      </div>\n\n      {/* New Playlist Modal */}\n      {showCreateModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/85 backdrop-blur-md\">\n          <div className=\"w-full max-w-sm bg-zinc-950 border border-zinc-800 rounded-3xl p-6 shadow-2xl flex flex-col gap-4 text-white\">\n            <div className=\"flex items-center justify-between border-b border-zinc-850 pb-3\">\n              <h4 className=\"text-sm font-bold text-white\">Create New Playlist</h4>\n              <button\n                onClick={() => setShowCreateModal(false)}\n                className=\"p-1 rounded-full text-zinc-400 hover:text-white\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <form onSubmit={handleCreate} className=\"flex flex-col gap-3\">"
