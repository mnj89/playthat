    end_line: 514
    content: "            {/* Top Bar (Shown on Media, Browser, Downloads, Playlists) */}\n            {activeTab !== \'settings\' && (\n              <header className=\"h-14 px-4 bg-zinc-950 border-b border-zinc-850 flex items-center justify-between gap-4 shrink-0 select-none\">\n                {/* Brand Wordmark & Icon */}\n                <div className=\"flex items-center gap-2.5\">\n                  <PlayThatIcon size={30} />\n                  <div className=\"flex items-baseline gap-1.5\">\n                    <span className=\"text-base font-black tracking-tight text-white\">\n                      PlayThat!\n                    </span>\n                    <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-zinc-800 text-zinc-300 border border-zinc-700 font-bold\">\n                      PRO\n                    </span>\n                  </div>\n                </div>\n\n                {/* Right Zone Actions in Monochrome */}\n                <div className=\"flex items-center gap-1.5\">\n                  {/* Active Download Badge Trigger */}\n                  <button\n                    onClick={() => setActiveTab(\'downloads\')}\n                    className=\"relative p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors border border-zinc-800\"\n                    title=\"PlayThat! Download Manager\"\n                  >\n                    <ArrowDownToLine className=\"w-4 h-4\" />\n                    {activeDownloadCount > 0 && (\n                      <span className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-white text-black text-[9px] font-bold flex items-center justify-center\">\n                        {activeDownloadCount}\n                      </span>\n                    )}\n                  </button>\n\n                  {/* Audio & Video Enhancements & Font Scaling Studio */}\n                  <button\n                    onClick={() => setIsEnhancementsModalOpen(true)}\n                    className=\"p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors border border-zinc-800\"\n                    title=\"Audio & Video Enhancements & System Font Size\"\n                  >\n                    <Sparkles className=\"w-4 h-4\" />\n                  </button>\n\n                  {/* Encrypted Vault Trigger */}\n                  <button\n                    onClick={() => setIsVaultModalOpen(true)}\n                    className=\"p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-white transition-colors border border-zinc-800\"\n                    title=\"Open Private Vault\"\n                  >\n                    <Lock className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </header>\n            )}\n\n            {/* Active View Router */}\n            <main className=\"flex-1 w-full overflow-hidden flex flex-col bg-black\">\n              {activeTab === \'folders\' && (\n                <FileBrowser\n                  mediaItems={mediaList}\n                  onPlayMedia={handlePlayMedia}\n                  onOpenVault={() => setIsVaultModalOpen(true)}\n                  onImportLocalFile={handleImportLocalFile}\n                  onOpenStreamDialog={() => setIsStreamDialogOpen(true)}\n                  onToggleFavorite={handleToggleFavorite}\n                  onDeleteMedia={handleDeleteMedia}\n                  onAddToVault={handleAddToVault}\n                />\n              )}\n\n              {activeTab === \'browser\' && (\n                <InAppBrowser\n                  onPlayMedia={handlePlayMedia}\n                  onSaveToLibrary={handleSaveToLibrary}\n                />\n              )}\n\n              {activeTab === \'downloads\' && (\n                <UCDownloadManager\n                  onPlayMedia={handlePlayMedia}\n                  onSaveToVault={handleAddToVault}\n                />\n              )}\n\n              {activeTab === \'playlists\' && (\n                <PlaylistManager\n                  playlists={playlists}\n                  mediaItems={mediaList}\n                  onCreatePlaylist={handleCreatePlaylist}\n                  onDeletePlaylist={handleDeletePlaylist}\n                  onPlayMedia={handlePlayMedia}\n                  onRemoveFromPlaylist={handleRemoveFromPlaylist}\n                />\n              )}\n\n              {activeTab === \'settings\' && (\n                <SettingsView\n                  onBack={() => setActiveTab(\'folders\')}\n                  isDarkMode={isDarkMode}\n                  onToggleDarkMode={() => setIsDarkMode(!isDarkMode)}\n                  frameMode={frameMode}\n                  onChangeFrameMode={setFrameMode}\n                  enhancementConfig={enhancementConfig}\n                  onUpdateEnhancements={setEnhancementConfig}\n                  onOpenSubtitlesModal={() => setIsSubtitleModalOpen(true)}\n                  onOpenVaultModal={() => setIsVaultModalOpen(true)}\n                  onShowToast={showToast}\n                />\n              )}\n            </main>\n\n            {/* Docked Mini Music Player (Visible when music is playing in background) */}\n            <MiniMusicPlayer\n              state={audioPlayerState}\n              onOpenFullPlayer={() => setIsFullMusicPlayerOpen(true)}\n            />\n\n            {/* Android Bottom Navigation Bar (5 Columns: Media, Browser, Downloads, Playlists, Settings) */}\n            <nav className=\"h-16 px-1 bg-zinc-950 border-t border-zinc-850 grid grid-cols-5 items-center shrink-0 select-none z-30\">\n              <button\n                onClick={() => setActiveTab(\'folders\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'folders\' ? \'text-white font-bold\' : \'text-zinc-500 hover:text-zinc-300\'\n                }`}\n              >\n                <Folder className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Media</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'browser\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'browser\' ? \'text-white font-bold\' : \'text-zinc-500 hover:text-zinc-300\'\n                }`}\n              >\n                <Globe className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Browser</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'downloads\')}\n                className={`relative flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'downloads\' ? \'text-white font-bold\' : \'text-zinc-500 hover:text-zinc-300\'\n                }`}\n              >\n                <ArrowDownToLine className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Downloads</span>\n                {activeDownloadCount > 0 && (\n                  <span className=\"absolute top-1 right-4 w-2 h-2 rounded-full bg-white animate-ping\" />\n                )}\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'playlists\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'playlists\' ? \'text-white font-bold\' : \'text-zinc-500 hover:text-zinc-300\'\n                }`}\n              >\n                <ListMusic className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Playlists</span>\n              </button>\n\n              {/* Settings Tab (Placed strictly after Playlists as requested) */}\n              <button\n                onClick={() => setActiveTab(\'settings\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'settings\' ? \'text-white font-bold\' : \'text-zinc-500 hover:text-zinc-300\'\n                }`}\n              >\n                <Settings className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Settings</span>\n              </button>\n            </nav>\n          </div>\n        )}\n\n        {/* Dedicated Full Music Player Modal */}\n        <MusicPlayerModal\n          isOpen={isFullMusicPlayerOpen}\n          onClose={() => setIsFullMusicPlayerOpen(false)}\n          state={audioPlayerState}\n          onOpenEnhancements={() => setIsEnhancementsModalOpen(true)}\n          onToggleFavorite={handleToggleFavorite}"
    num_lines: 640
