            lines {
              text: "                className=\"w-full py-3.5 px-4 rounded-xl bg-orange-500 hover:bg-orange-400 text-black font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-orange-500/25 active:scale-[0.99]\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <Download className=\"w-4 h-4 stroke-[2.5]\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span>Install Native WebAPK on this Device Now</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </button>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ) : ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"p-3 rounded-xl bg-zinc-900 border border-zinc-850 flex flex-col gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span className=\"font-bold text-white\">Manual 2-Step Android Install:</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <p className=\"text-zinc-400\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  1. In Android Chrome, tap the <MoreVertical className=\"w-3.5 h-3.5 text-zinc-300 inline\" /> menu in top right.<br />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  2. Tap <strong>\"Install app\"</strong> or <strong>\"Add to Home screen\"</strong>."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
