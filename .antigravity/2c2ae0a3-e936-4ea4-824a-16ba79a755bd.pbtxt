            }
            lines {
              text: "            {/* Direct 1-Click APK Generator Box */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"p-4 rounded-2xl bg-gradient-to-br from-orange-950/40 via-zinc-900 to-zinc-900 border border-orange-500/40 flex flex-col gap-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"flex items-center justify-between\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <div className=\"flex items-center gap-2 text-white font-bold text-sm\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <Package className=\"w-4 h-4 text-orange-400\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  <span>1-Click .APK Generator</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-orange-500/20 text-orange-400 border border-orange-500/30\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  Android APK"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-zinc-400 text-xs leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                Google & Microsoft\'s official <strong>PWABuilder</strong> packages this web app into a signed, ready-to-install Android <code className=\"text-orange-400 font-mono\">.apk</code> file in under 30 seconds."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <a"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                href={pwaBuilderUrl}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                target=\"_blank\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                rel=\"noopener noreferrer\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                className=\"w-full py-3 px-4 rounded-xl bg-orange-500 hover:bg-orange-400 text-black font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-orange-500/25 text-center active:scale-[0.99]\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              >"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <Download className=\"w-4 h-4 stroke-[2.5]\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <span>Generate & Download PlayThat.apk</span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <ExternalLink className=\"w-3.5 h-3.5 stroke-[2.5] ml-1\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
