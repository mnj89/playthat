              text: "      setActiveGesture(\'seek\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const scrubSeconds = Math.round((deltaX / rect.width) * Math.min(180, duration));"
