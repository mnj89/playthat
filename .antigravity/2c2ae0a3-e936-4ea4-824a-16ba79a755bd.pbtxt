  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Folder,\n  Film,\n  Play,\n  Search,\n  SlidersHorizontal,\n  Upload,\n  Radio,\n  Lock,\n  Heart,\n  MoreVertical,\n  Plus,\n  LayoutGrid,\n  List,\n  Clock,\n  HardDrive,\n  Trash2,\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface FileBrowserProps {\n  mediaItems: MediaItem[];\n  onPlayMedia: (item: MediaItem) => void;\n  onOpenVault: () => void;\n  onImportLocalFile: (file: File) => void;\n  onOpenStreamDialog: () => void;\n  onToggleFavorite: (id: string) => void;\n  onDeleteMedia: (id: string) => void;\n  onAddToVault: (item: MediaItem) => void;\n}\n\nexport const FileBrowser: React.FC<FileBrowserProps> = ({\n  mediaItems,\n  onPlayMedia,\n  onOpenVault,\n  onImportLocalFile,\n  onOpenStreamDialog,\n  onToggleFavorite,\n  onDeleteMedia,\n  onAddToVault,\n}) => {\n  const [selectedFolder, setSelectedFolder] = useState<string>(\'All\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<\'grid\' | \'list\'>(\'grid\');\n  const [sortBy, setSortBy] = useState<\'date\' | \'name\' | \'size\' | \'duration\'>(\'date\');\n  const [activeMenuId, setActiveMenuId] = useState<string | null>(null);\n\n  // Calculate unique folders and counts\n  const folders = Array.from(new Set(mediaItems.map((m) => m.folder))).filter(Boolean);\n\n  // Filter media\n  const filteredMedia = mediaItems\n    .filter((item) => {\n      if (item.isEncrypted) return false; // hidden in main library\n      const matchesFolder = selectedFolder === \'All\' || item.folder === selectedFolder;\n      const matchesSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase());\n      return matchesFolder && matchesSearch;\n    })\n    .sort((a, b) => {\n      if (sortBy === \'name\') return a.title.localeCompare(b.title);\n      if (sortBy === \'size\') return b.fileSize - a.fileSize;\n      if (sortBy === \'duration\') return b.duration - a.duration;\n      return b.createdAt - a.createdAt;\n    });\n\n  const formatDuration = (seconds: number) => {\n    if (isNaN(seconds)) return \'00:00\';\n    const s = Math.floor(seconds);\n    const mins = Math.floor(s / 60);\n    const secs = s % 60;\n    return `${mins}:${secs < 10 ? \'0\' : \'\'}${secs}`;\n  };\n\n  const formatFileSize = (bytes: number) => {\n    if (!bytes) return \'0 MB\';\n    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n  };\n\n  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      onImportLocalFile(file);\n    }\n  };\n\n  return (\n    <div className=\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden\">\n      {/* Top Action Toolbar */}\n      <div className=\"p-3 bg-slate-900 border-b border-slate-800 flex flex-col gap-2.5 shrink-0\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Search Box */}\n          <div className=\"relative flex-1\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search local and streamed videos...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500 transition-colors\"\n            />\n          </div>\n\n          {/* Quick Import & Stream Actions */}\n          <div className=\"flex items-center gap-1.5 shrink-0\">\n            {/* Native Local File Import */}\n            <label\n              className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 cursor-pointer transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Play local video from device\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span className=\"hidden sm:inline\">Open File</span>\n              <input\n                type=\"file\"\n                accept=\"video/*,audio/*\"\n                onChange={handleFileInputChange}\n                className=\"hidden\"\n              />\n            </label>\n\n            {/* Network Stream URL */}\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span className=\"hidden sm:inline\">Network Stream</span>\n            </button>\n\n            {/* View Mode Toggle */}\n            <div className=\"flex items-center bg-slate-950 rounded-lg p-0.5 border border-slate-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-md transition-colors ${\n                  viewMode === \'grid\' ? \'bg-blue-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"Grid View\"\n              >\n                <LayoutGrid className=\"w-3.5 h-3.5\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-md transition-colors ${\n                  viewMode === \'list\' ? \'bg-blue-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"List View\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Horizontal Folder Scroller (MX Player style) */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-0.5 text-xs\">\n          <button\n            onClick={() => setSelectedFolder(\'All\')}\n            className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors font-medium ${\n              selectedFolder === \'All\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'bg-slate-800/80 text-slate-400 hover:text-white\'\n            }`}\n          >\n            All Videos ({mediaItems.filter((m) => !m.isEncrypted).length})\n          </button>\n\n          {folders.map((fName) => {\n            const count = mediaItems.filter((m) => m.folder === fName && !m.isEncrypted).length;\n            return (\n              <button\n                key={fName}\n                onClick={() => setSelectedFolder(fName)}\n                className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-medium ${\n                  selectedFolder === fName\n                    ? \'bg-blue-600 text-white shadow-sm\'\n                    : \'bg-slate-800/80 text-slate-400 hover:text-white\'\n                }`}\n              >\n                <Folder className=\"w-3.5 h-3.5 text-amber-400/80\" />\n                <span>{fName}</span>\n                <span className=\"text-[10px] text-slate-400 font-mono\">({count})</span>\n              </button>\n            );\n          })}\n\n          {/* Encrypted Vault Entry Pill */}\n          <button\n            onClick={onOpenVault}\n            className=\"px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-semibold bg-emerald-950/60 text-emerald-400 border border-emerald-800/60 hover:bg-emerald-900/60\"\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Private Vault</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Video Grid / List */}\n      <div className=\"flex-1 overflow-y-auto p-4\">\n        {filteredMedia.length === 0 ? (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-12 text-center gap-3 text-slate-400\">\n            <Film className=\"w-12 h-12 text-slate-700\" />\n            <span className=\"text-sm font-semibold text-white\">No media files found</span>\n            <span className=\"text-xs text-slate-400 max-w-xs\">\n              Open a local video from your device or stream an M3U8 link from the top bar.\n            </span>\n          </div>\n        ) : viewMode === \'grid\' ? (\n          /* Grid View */\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4\">\n            {filteredMedia.map((item) => (\n              <div\n                key={item.id}\n                onClick={() => onPlayMedia(item)}\n                className=\"group relative bg-slate-900 border border-slate-800 hover:border-slate-700 rounded-2xl overflow-hidden shadow-md cursor-pointer transition-all hover:scale-[1.01] flex flex-col\"\n              >\n                {/* Thumbnail Container */}\n                <div className=\"relative aspect-video w-full bg-slate-950 overflow-hidden\">\n                  <img\n                    src={item.thumbnailUrl}\n                    alt={item.title}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-300\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20\" />\n\n                  {/* Play Overlay */}\n                  <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <div className=\"w-12 h-12 rounded-full bg-blue-600/90 text-white flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform\">\n                      <Play className=\"w-5 h-5 fill-white translate-x-0.5\" />\n                    </div>\n                  </div>\n\n                  {/* Duration Pill */}\n                  <div className=\"absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md bg-black/80 text-[10px] font-mono font-bold text-white tracking-wide\">\n                    {formatDuration(item.duration)}\n                  </div>\n\n                  {/* Resolution & Decoder Badges */}\n                  <div className=\"absolute top-2 left-2 flex items-center gap-1\">\n                    <span className=\"px-1.5 py-0.5 rounded bg-blue-950/80 border border-blue-800 text-[9px] font-mono font-bold text-blue-300\">\n                      {item.resolution}\n                    </span>\n                    <span className=\"px-1 py-0.5 rounded bg-slate-900/80 border border-slate-700 text-[9px] font-mono text-cyan-300\">\n                      {item.decoder}\n                    </span>\n                  </div>\n\n                  {/* Favorite indicator */}\n                  {item.isFavorite && (\n                    <div className=\"absolute top-2 right-2 p-1 rounded-full bg-black/60 text-red-400\">\n                      <Heart className=\"w-3.5 h-3.5 fill-red-400\" />\n                    </div>\n                  )}\n\n                  {/* Watch progress bar if partially played */}\n                  {item.currentTime > 0 && item.duration > 0 && (\n                    <div className=\"absolute bottom-0 left-0 right-0 h-1 bg-slate-800\">\n                      <div\n                        className=\"h-full bg-blue-500\"\n                        style={{ width: `${(item.currentTime / item.duration) * 100}%` }}\n                      />\n                    </div>\n                  )}\n                </div>\n\n                {/* Details Footer */}\n                <div className=\"p-3 flex items-start justify-between gap-2\">\n                  <div className=\"flex flex-col min-w-0\">\n                    <span className=\"text-xs font-bold text-white truncate group-hover:text-blue-400 transition-colors\">\n                      {item.title}\n                    </span>\n                    <div className=\"flex items-center gap-2 text-[10px] text-slate-400 font-mono mt-0.5\">\n                      <span>{item.codec}</span>\n                      <span>\302\267</span>\n                      <span>{formatFileSize(item.fileSize)}</span>\n                    </div>\n                  </div>\n\n                  {/* Card Actions Menu */}\n                  <div className=\"relative\">\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        setActiveMenuId(activeMenuId === item.id ? null : item.id);\n                      }}\n                      className=\"p-1 rounded-lg hover:bg-slate-800 text-slate-400 hover:text-white\"\n                    >\n                      <MoreVertical className=\"w-4 h-4\" />\n                    </button>\n\n                    {activeMenuId === item.id && (\n                      <div\n                        onClick={(e) => e.stopPropagation()}\n                        className=\"absolute right-0 bottom-full mb-1 z-30 bg-slate-900 border border-slate-700 rounded-xl p-1.5 shadow-xl w-44 flex flex-col gap-1 text-xs text-slate-200\"\n                      >\n                        <button\n                          onClick={() => {\n                            onToggleFavorite(item.id);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-slate-800 text-left flex items-center gap-2\"\n                        >\n                          <Heart className=\"w-3.5 h-3.5 text-red-400\" />\n                          <span>{item.isFavorite ? \'Unfavorite\' : \'Add to Favorite\'}</span>\n                        </button>\n                        <button\n                          onClick={() => {\n                            onAddToVault(item);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-slate-800 text-left flex items-center gap-2 text-emerald-400\"\n                        >\n                          <Lock className=\"w-3.5 h-3.5\" />\n                          <span>Move to Private Vault</span>\n                        </button>\n                        <button\n                          onClick={() => {\n                            onDeleteMedia(item.id);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-red-950/50 text-left flex items-center gap-2 text-red-400\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                          <span>Delete</span>\n                        </button>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          /* List View */\n          <div className=\"flex flex-col gap-2\">\n            {filteredMedia.map((item) => (\n              <div\n                key={item.id}\n                onClick={() => onPlayMedia(item)}\n                className=\"group p-2.5 rounded-2xl bg-slate-900 border border-slate-800 hover:border-slate-700 flex items-center justify-between gap-3 cursor-pointer transition-all hover:bg-slate-800/60\"\n              >\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"relative w-20 h-12 rounded-xl bg-slate-950 overflow-hidden shrink-0\">\n                    <img\n                      src={item.thumbnailUrl}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-full h-full object-cover\"\n                    />\n                    <div className=\"absolute bottom-1 right-1 px-1 py-0.2 bg-black/80 rounded text-[9px] font-mono text-white\">\n                      {formatDuration(item.duration)}\n                    </div>\n                  </div>\n                  <div className=\"flex flex-col min-w-0\">\n                    <span className=\"text-xs font-semibold text-white truncate group-hover:text-blue-400 transition-colors\">\n                      {item.title}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-slate-400\">\n                      {item.resolution} \302\267 {formatFileSize(item.fileSize)} \302\267 {item.decoder}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-1 shrink-0\">\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      onPlayMedia(item);\n                    }}\n                    className=\"p-2 rounded-xl bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white transition-colors\"\n                  >\n                    <Play className=\"w-4 h-4 fill-current\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/FileBrowser.tsx"
        }
        overwrite: true
      }
    }
