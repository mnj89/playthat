=> (\n                    <div\n                      key={i}\n                      className=\"w-1 rounded-full bg-white transition-all duration-300\"\n                      style={{\n                        height: `${Math.max(15, (h * (0.6 + Math.sin(Date.now() / 200 + i) * 0.4)))}%`,\n                      }}\n                    />\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Audio Format Pill (Black/White/Grey) */}\n            <div className=\"mt-5 inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-zinc-900 border border-zinc-800 text-[11px] font-mono text-zinc-300\">\n              <span className=\"w-2 h-2 rounded-full bg-white animate-pulse\" />\n              <span>{currentTrack.codec || \'MP3 \302\267 320 KBPS \302\267 44.1 KHZ\'}</span>\n              <span>\302\267</span>\n              <span className=\"text-zinc-500 font-sans\">HI-RES</span>\n            </div>\n          </div>\n        )}\n\n        {/* Track Metadata & Favorite */}\n        <div className=\"flex items-center justify-between gap-4 px-1 mb-2\">\n          <div className=\"flex flex-col min-w-0\">\n            <h3 className=\"text-lg font-bold text-white tracking-wide truncate\">\n              {currentTrack.title}\n            </h3>\n            <p className=\"text-xs text-zinc-400 truncate mt-0.5\">\n              {currentTrack.artist || \'Unknown Artist\'} {currentTrack.album ? `\342\200\224 ${currentTrack.album}` : \'\'}\n            </p>\n          </div>\n\n          <button\n            onClick={() => onToggleFavorite && onToggleFavorite(currentTrack.id)}\n            className={`p-2.5 rounded-full border transition-colors shrink-0 ${\n              currentTrack.isFavorite\n                ? \'bg-zinc-800 border-zinc-600 text-white\'\n                : \'bg-zinc-950 border-zinc-800 text-zinc-500 hover:text-white\'\n            }`}\n            title=\"Favorite Track\"\n          >\n            <Heart className={`w-5 h-5 ${currentTrack.isFavorite ? \'fill-white\' : \'\'}`} />\n          </button>\n        </div>\n\n        {/* Interactive Scrubbing Slider */}\n        <div className=\"flex flex-col gap-1 px-1 my-2\">\n          <input\n            type=\"range\"\n            min=\"0\"\n            max={duration || 100}\n            step=\"0.5\"\n            value={activeTime}\n            onMouseDown={() => setIsDraggingSeek(true)}\n            onTouchStart={() => setIsDraggingSeek(true)}\n            onChange={(e) => setSeekValue(Number(e.target.value))}\n            onMouseUp={() => {\n              setIsDraggingSeek(false);\n              audioPlayerService.seek(seekValue);\n            }}\n            onTouchEnd={() => {\n              setIsDraggingSeek(false);\n              audioPlayerService.seek(seekValue);\n            }}\n            className=\"w-full accent-white cursor-pointer h-1.5 bg-zinc-800 rounded-lg appearance-none\"\n          />\n\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-zinc-400 px-0.5\">\n            <span>{formatTime(activeTime)}</span>\n            <span>-{formatTime(remainingTime)}</span>\n          </div>\n        </div>\n\n        {/* Primary Playback Controls in Black, White & Grey */}\n        <div className=\"flex items-center justify-between px-2 py-2\">\n          {/* Shuffle */}\n          <button\n            onClick={() => audioPlayerService.toggleShuffle()}\n            className={`p-3 rounded-full transition-colors ${\n              isShuffle ? \'text-black bg-white\' : \'text-zinc-400 hover:text-white\'\n            }`}\n            title={isShuffle ? \'Shuffle On\' : \'Shuffle Off\'}\n          >\n            <Shuffle className=\"w-5 h-5\" />\n          </button>\n\n          {/* Previous Track */}\n          <button\n            onClick={() => audioPlayerService.previous()}\n            className=\"p-3 text-zinc-200 hover:text-white rounded-full hover:bg-zinc-900 active:scale-95 transition-all\"\n            title=\"Previous Track\"\n          >\n            <SkipBack className=\"w-7 h-7 fill-zinc-200\" />\n          </button>\n\n          {/* Large Pure White Play/Pause Button */}\n          <button\n            onClick={() => audioPlayerService.togglePlay()}\n            className=\"w-16 h-16 rounded-full bg-white hover:bg-zinc-200 text-black flex items-center justify-center shadow-2xl hover:scale-105 active:scale-95 transition-all\"\n            title={isPlaying ? \'Pause\' : \'Play\'}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-7 h-7 fill-black\" />\n            ) : (\n              <Play className=\"w-7 h-7 fill-black ml-1\" />\n            )}\n          </button>\n\n          {/* Next Track */}\n          <button\n            onClick={() => audioPlayerService.next()}\n            className=\"p-3 text-zinc-200 hover:text-white rounded-full hover:bg-zinc-900 active:scale-95 transition-all\"\n            title=\"Next Track\"\n          >\n            <SkipForward className=\"w-7 h-7 fill-zinc-200\" />\n          </button>\n\n          {/* Repeat Mode */}\n          <button\n            onClick={() => audioPlayerService.toggleLoopMode()}\n            className={`p-3 rounded-full transition-colors ${\n              loopMode !== \'off\' ? \'text-black bg-white\' : \'text-zinc-400 hover:text-white\'\n            }`}\n            title={`Repeat: ${loopMode.toUpperCase()}`}\n          >\n            {loopMode === \'one\' ? <Repeat1 className=\"w-5 h-5\" /> : <Repeat className=\"w-5 h-5\" />}\n          </button>\n        </div>\n\n        {/* Bottom MX Volume Boost (up to 200%) in Monochrome */}\n        <div className=\"flex items-center gap-3 px-3.5 py-2.5 bg-zinc-900 border border-zinc-800 rounded-2xl mt-1\">\n          <button\n            onClick={() => audioPlayerService.toggleMute()}\n            className=\"text-zinc-400 hover:text-white\"\n          >\n            <Volume2 className=\"w-4 h-4 text-white\" /