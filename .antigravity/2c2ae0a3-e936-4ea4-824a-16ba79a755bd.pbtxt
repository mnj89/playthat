etDeferredPrompt(null);\n        return true;\n      }\n      return false;\n    } catch {\n      return false;\n    }\n  };\n\n  return {\n    isInstallable: !!deferredPrompt,\n    isInstalled,\n    isIOS,\n    isAndroid,\n    install,\n  };\n}\n"
