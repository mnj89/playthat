  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport {\n  Wifi,\n  BatteryMedium,\n  Signal,\n  Smartphone,\n  Monitor,\n  Tablet,\n  Music,\n  Play,\n  Pause,\n  SkipBack,\n  SkipForward,\n  Lock,\n  Unlock,\n  ChevronDown,\n  Bell,\n  Sliders,\n  Volume2,\n  ChevronUp,\n} from \'lucide-react\';\nimport { audioPlayerService, AudioPlayerState } from \'../services/audioPlayerService\';\n\nexport type FrameMode = \'phone\' | \'tablet\' | \'responsive\';\n\ninterface AndroidFrameProps {\n  children: React.ReactNode;\n  frameMode: FrameMode;\n  onFrameModeChange: (mode: FrameMode) => void;\n  isPlayerActive?: boolean;\n  onOpenFullMusicPlayer?: () => void;\n}\n\nexport const AndroidFrame: React.FC<AndroidFrameProps> = ({\n  children,\n  frameMode,\n  onFrameModeChange,\n  isPlayerActive = false,\n  onOpenFullMusicPlayer,\n}) => {\n  const [currentTimeStr, setCurrentTimeStr] = useState<string>(\'12:45\');\n  const [currentDateStr, setCurrentDateStr] = useState<string>(\'Friday, Oct 24\');\n  const [isPhoneLocked, setIsPhoneLocked] = useState<boolean>(false);\n  const [isNotificationShadeOpen, setIsNotificationShadeOpen] = useState<boolean>(false);\n  const [audioState, setAudioState] = useState<AudioPlayerState>(audioPlayerService.getState());\n\n  useEffect(() => {\n    const updateTime = () => {\n      const d = new Date();\n      setCurrentTimeStr(\n        d.toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', hour12: false })\n      );\n      setCurrentDateStr(\n        d.toLocaleDateString([], { weekday: \'long\', month: \'short\', day: \'numeric\' })\n      );\n    };\n    updateTime();\n    const interval = setInterval(updateTime, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  // Subscribe to audio player service\n  useEffect(() => {\n    const unsubscribe = audioPlayerService.subscribe((state) => {\n      setAudioState(state);\n    });\n    return unsubscribe;\n  }, []);\n\n  const formatSecs = (sec: number) => {\n    if (isNaN(sec) || sec < 0) return \'0:00\';\n    const m = Math.floor(sec / 60);\n    const s = Math.floor(sec % 60);\n    return `${m}:${s < 10 ? \'0\' : \'\'}${s}`;\n  };\n\n  const progressPercent =\n    audioState.duration > 0 ? (audioState.currentTime / audioState.duration) * 100 : 0;\n\n  // Render Android Media Notification Card\n  const renderMediaNotificationCard = (isLockscreen = false) => {\n    if (!audioState.currentTrack) return null;\n\n    return (\n      <div\n        className={`w-full rounded-2xl p-3 border transition-all ${\n          isLockscreen\n            ? \'bg-slate-900/80 border-slate-700/60 backdrop-blur-xl shadow-2xl\'\n            : \'bg-slate-800/95 border-slate-700/80 shadow-lg\'\n        }`}\n      >\n        <div className=\"flex items-center justify-between pb-2 mb-2 border-b border-white/10 text-[10px] text-slate-400\">\n          <div className=\"flex items-center gap-1.5\">\n            <div className=\"w-2 h-2 rounded-full bg-blue-400 animate-pulse\" />\n            <span className=\"font-semibold text-slate-200\">PlayThat! Music</span>\n            <span>\302\267</span>\n            <span className=\"text-cyan-400 font-mono\">Hi-Res Audio</span>\n          </div>\n          <span className=\"text-slate-400\">Device Speaker</span>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          {/* Thumbnail */}\n          <div\n            onClick={() => onOpenFullMusicPlayer && onOpenFullMusicPlayer()}\n            className=\"w-12 h-12 rounded-xl overflow-hidden bg-slate-950 shrink-0 border border-slate-700 cursor-pointer shadow-md\"\n          >\n            <img\n              src={audioState.currentTrack.thumbnailUrl}\n              alt={audioState.currentTrack.title}\n              referrerPolicy=\"no-referrer\"\n              className=\"w-full h-full object-cover\"\n            />\n          </div>\n\n          {/* Title & Artist */}\n          <div\n            onClick={() => onOpenFullMusicPlayer && onOpenFullMusicPlayer()}\n            className=\"flex-1 min-w-0 cursor-pointer\"\n          >\n            <h5 className=\"text-xs font-bold text-white truncate\">\n              {audioState.currentTrack.title}\n            </h5>\n            <p className=\"text-[11px] text-slate-400 truncate\">\n              {audioState.currentTrack.artist || audioState.currentTrack.album || \'PlayThat! Audio\'}\n            </p>\n          </div>\n\n          {/* Quick Notification Controls */}\n          <div className=\"flex items-center gap-1 shrink-0\">\n            <button\n              onClick={() => audioPlayerService.previous()}\n              className=\"p-1.5 text-slate-300 hover:text-white rounded-full hover:bg-white/10 transition-colors\"\n              title=\"Previous\"\n            >\n              <SkipBack className=\"w-4 h-4 fill-slate-300\" />\n            </button>\n\n            <button\n              onClick={() => audioPlayerService.togglePlay()}\n              className=\"w-8 h-8 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center shadow-md active:scale-95 transition-all\"\n              title={audioState.isPlaying ? \'Pause\' : \'Play\'}\n            >\n              {audioState.isPlaying ? (\n                <Pause className=\"w-4 h-4 fill-white\" />\n              ) : (\n                <Play className=\"w-4 h-4 fill-white ml-0.5\" />\n              )}\n            </button>\n\n            <button\n              onClick={() => audioPlayerService.next()}\n              className=\"p-1.5 text-slate-300 hover:text-white rounded-full hover:bg-white/10 transition-colors\"\n              title=\"Next\"\n            >\n              <SkipForward className=\"w-4 h-4 fill-slate-300\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Scrubber in Notification */}\n        <div className=\"mt-2.5 flex flex-col gap-1\">\n          <div className=\"w-full h-1 bg-slate-700/80 rounded-full overflow-hidden\">\n            <div\n              className=\"h-full bg-cyan-400 rounded-full\"\n              style={{ width: `${Math.min(100, Math.max(0, progressPercent))}%` }}\n            />\n          </div>\n          <div className=\"flex items-center justify-between text-[10px] font-mono text-slate-400\">\n            <span>{formatSecs(audioState.currentTime)}</span>\n            <span>{formatSecs(audioState.duration)}</span>\n          </div>\n        </div>\n      </div>\n    );\n  };\n\n  if (frameMode === \'responsive\') {\n    return (\n      <div className=\"w-full min-h-screen bg-slate-950 text-slate-100 flex flex-col\">\n        {/* Subtle Top Device Switcher Floating Bar */}\n        <div className=\"sticky top-0 z-50 px-4 py-2 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">View Mode:</span>\n            <div className=\"flex items-center bg-slate-800/90 rounded-lg p-0.5 border border-slate-700\">\n              <button\n                onClick={() => onFrameModeChange(\'phone\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Phone Mockup\"\n              >\n                <Smartphone className=\"w-3.5 h-3.5\" />\n                <span>Phone</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'tablet\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Tablet Mockup\"\n              >\n                <Tablet className=\"w-3.5 h-3.5\" />\n                <span>Tablet</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'responsive\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md bg-blue-600 text-white shadow-sm flex items-center gap-1.5\"\n                title=\"Adaptive Responsive Mode\"\n              >\n                <Monitor className=\"w-3.5 h-3.5\" />\n                <span>Full Responsive</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Quick Notification Dropdown in Responsive Mode */}\n          <div className=\"flex items-center gap-3\">\n            {audioState.currentTrack && (\n              <button\n                onClick={() => setIsNotificationShadeOpen(!isNotificationShadeOpen)}\n                className=\"relative px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-cyan-300 flex items-center gap-1.5 shadow-sm transition-colors\"\n                title=\"Notifications & Background Audio Controls\"\n              >\n                <Music className=\"w-3.5 h-3.5 text-cyan-400 animate-pulse\" />\n                <span className=\"truncate max-w-[130px] font-medium\">\n                  {audioState.currentTrack.title}\n                </span>\n                <span className=\"text-[10px] text-slate-400\">\302\267</span>\n                <span className=\"text-[10px] text-slate-400\">\n                  {audioState.isPlaying ? \'Playing\' : \'Paused\'}\n                </span>\n                <ChevronDown className=\"w-3 h-3 text-slate-400\" />\n              </button>\n            )}\n\n            <div className=\"hidden sm:flex items-center gap-2 text-xs text-slate-400\">\n              <span>PlayThat! v2.4</span>\n              <span>\302\267</span>\n              <span className=\"text-emerald-400\">Hardware Acceleration Active</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Dropdown Notification Card in Responsive Mode */}\n        {isNotificationShadeOpen && audioState.currentTrack && (\n          <div className=\"fixed top-12 right-4 z-50 w-80 animate-in fade-in slide-in-from-top-2 duration-150\">\n            {renderMediaNotificationCard(false)}\n          </div>\n        )}\n\n        {/* Content body */}\n        <div className=\"flex-1 w-full max-w-7xl mx-auto flex flex-col\">\n          {children}\n        </div>\n      </div>\n    );\n  }\n\n  const isTablet = frameMode === \'tablet\';\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 flex flex-col items-center justify-center p-2 sm:p-4 md:p-6 overflow-x-hidden\">\n      {/* Device Mode Switcher Toolbar */}\n      <div className=\"mb-3 flex items-center gap-3 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-800 shadow-md\">\n        <span className=\"text-xs text-slate-400 font-medium\">Device:</span>\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={() => onFrameModeChange(\'phone\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'phone\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            <span>Phone</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'tablet\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'tablet\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Tablet className=\"w-3.5 h-3.5\" />\n            <span>Tablet</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'responsive\')}\n            className=\"px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors text-slate-400 hover:text-white\"\n          >\n            <Monitor className=\"w-3.5 h-3.5\" />\n            <span>Full View</span>\n          </button>\n        </div>\n\n        {/* Phone Power / Lock Button */}\n        <div className=\"h-4 w-px bg-slate-700 mx-1\" />\n        <button\n          onClick={() => {\n            setIsPhoneLocked(!isPhoneLocked);\n            setIsNotificationShadeOpen(false);\n          }}\n          className={`px-2.5 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n            isPhoneLocked\n              ? \'bg-amber-600 text-white\'\n              : \'bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700\'\n          }`}\n          title={isPhoneLocked ? \'Unlock phone\' : \'Lock phone (music plays in background)\'}\n        >\n          {isPhoneLocked ? <Unlock className=\"w-3.5 h-3.5\" /> : <Lock className=\"w-3.5 h-3.5\" />}\n          <span>{isPhoneLocked ? \'Unlock Phone\' : \'Lock Phone\'}</span>\n        </button>\n      </div>\n\n      {/* Realistic Android Hardware Chassis */}\n      <div\n        className={`relative bg-slate-900 border-[7px] border-slate-800 rounded-[44px] shadow-2xl shadow-cyan-950/20 overflow-hidden flex flex-col transition-all duration-300 ${\n          isTablet\n            ? \'w-full max-w-[960px] h-[780px]\'\n            : isPlayerActive\n            ? \'w-full max-w-[840px] h-[520px] rounded-[36px]\'\n            : \'w-full max-w-[430px] h-[870px]\'\n        }`}\n        style={{\n          boxShadow: \'0 0 0 2px rgba(255, 255, 255, 0.08), 0 25px 60px -15px rgba(0, 0, 0, 0.7)\',\n        }}\n      >\n        {/* Android Hardware Power Button on Right Chassis Side */}\n        <div\n          onClick={() => {\n            setIsPhoneLocked(!isPhoneLocked);\n            setIsNotificationShadeOpen(false);\n          }}\n          className=\"absolute -right-2 top-28 w-2 h-12 bg-slate-700 hover:bg-slate-500 rounded-r-md cursor-pointer z-50 transition-colors\"\n          title=\"Hardware Power / Lock Key\"\n        />\n\n        {/* Android Punch Hole Camera */}\n        <div className=\"absolute top-2.5 left-1/2 -translate-x-1/2 z-50 flex items-center justify-center\">\n          <div className=\"w-4 h-4 rounded-full bg-black border border-slate-800 shadow-inner flex items-center justify-center\">\n            <div className=\"w-1.5 h-1.5 rounded-full bg-slate-900/90\" />\n          </div>\n        </div>\n\n        {/* Android Status Bar (Click to toggle Notification Shade) */}\n        <div\n          onClick={() => {\n            if (!isPhoneLocked) {\n              setIsNotificationShadeOpen(!isNotificationShadeOpen);\n            }\n          }}\n          className=\"h-7 w-full px-6 flex items-center justify-between text-xs text-slate-300 bg-slate-950/80 backdrop-blur-sm shrink-0 z-40 select-none cursor-pointer hover:bg-slate-900/90 transition-colors\"\n          title=\"Tap status bar to pull down notifications\"\n        >\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-semibold tracking-wide text-[11px] font-mono\">\n              {currentTimeStr}\n            </span>\n            {audioState.currentTrack && (\n              <span className=\"flex items-center gap-1 text-[10px] text-cyan-400\">\n                <Music className=\"w-3 h-3 animate-pulse\" />\n                <span className=\"truncate max-w-[70px]\">{audioState.currentTrack.title}</span>\n              </span>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-2 text-slate-300\">\n            <Signal className=\"w-3 h-3\" />\n            <span className=\"text-[10px] font-mono font-medium\">5G</span>\n            <Wifi className=\"w-3 h-3\" />\n            <div className=\"flex items-center gap-0.5\">\n              <span className=\"text-[10px] font-mono font-medium\">94%</span>\n              <BatteryMedium className=\"w-3.5 h-3.5 text-emerald-400\" />\n            </div>\n          </div>\n        </div>\n\n        {/* Notification Shade Drawer Overlay (When user pulls down) */}\n        {isNotificationShadeOpen && !isPhoneLocked && (\n          <div className=\"absolute inset-x-0 top-7 z-40 bg-slate-950/95 backdrop-blur-2xl border-b border-slate-800 p-4 shadow-2xl flex flex-col gap-3 animate-in slide-in-from-top duration-200\">\n            {/* Quick Settings Tiles */}\n            <div className=\"grid grid-cols-4 gap-2 pb-2 border-b border-slate-800\">\n              <div className=\"p-2.5 rounded-2xl bg-blue-600 text-white flex flex-col items-center justify-center gap-1\">\n                <Wifi className=\"w-4 h-4\" />\n                <span className=\"text-[10px] font-medium\">Wi-Fi</span>\n              </div>\n              <div className=\"p-2.5 rounded-2xl bg-slate-800 text-slate-300 flex flex-col items-center justify-center gap-1\">\n                <Volume2 className=\"w-4 h-4 text-emerald-400\" />\n                <span className=\"text-[10px] font-medium\">Sound</span>\n              </div>\n              <div className=\"p-2.5 rounded-2xl bg-slate-800 text-slate-300 flex flex-col items-center justify-center gap-1\">\n                <Bell className=\"w-4 h-4\" />\n                <span className=\"text-[10px] font-medium\">Alerts</span>\n              </div>\n              <div\n                onClick={() => {\n                  setIsPhoneLocked(true);\n                  setIsNotificationShadeOpen(false);\n                }}\n                className=\"p-2.5 rounded-2xl bg-slate-800 text-amber-300 flex flex-col items-center justify-center gap-1 cursor-pointer hover:bg-slate-700\"\n              >\n                <Lock className=\"w-4 h-4\" />\n                <span className=\"text-[10px] font-medium\">Lock</span>\n              </div>\n            </div>\n\n            {/* Notification Media Player Card */}\n            {audioState.currentTrack ? (\n              renderMediaNotificationCard(false)\n            ) : (\n              <div className=\"p-4 rounded-2xl bg-slate-900 border border-slate-800 text-center text-xs text-slate-400\">\n                No active media playback\n              </div>\n            )}\n\n            {/* Close Shade Pill */}\n            <div\n              onClick={() => setIsNotificationShadeOpen(false)}\n              className=\"pt-1 flex items-center justify-center cursor-pointer text-slate-500 hover:text-slate-300\"\n            >\n              <ChevronUp className=\"w-5 h-5\" />\n            </div>\n          </div>\n        )}\n\n        {/* Inner Phone Screen Canvas or Phone Lock Screen */}\n        <div className=\"flex-1 w-full overflow-hidden flex flex-col relative bg-slate-950\">\n          {isPhoneLocked ? (\n            /* Android Lock Screen UI */\n            <div className=\"flex-1 w-full h-full relative flex flex-col justify-between p-6 select-none bg-gradient-to-b from-slate-950 via-[#0b101c] to-black overflow-hidden animate-in fade-in duration-200\">\n              {/* Background Ambient Art if music playing */}\n              {audioState.currentTrack && (\n                <div\n                  className=\"absolute inset-0 bg-cover bg-center opacity-25 filter blur-3xl pointer-events-none\"\n                  style={{ backgroundImage: `url(${audioState.currentTrack.thumbnailUrl})` }}\n                />\n              )}\n\n              {/* Lock Screen Header Clock */}\n              <div className=\"flex flex-col items-center pt-8 z-10 text-center\">\n                <Lock className=\"w-5 h-5 text-slate-400 mb-2\" />\n                <h1 className=\"text-6xl font-light tracking-tight text-white font-sans\">\n                  {currentTimeStr}\n                </h1>\n                <p className=\"text-sm font-medium text-slate-400 mt-1\">{currentDateStr}</p>\n              </div>\n\n              {/* Lock Screen Media Widget (Music plays when locked!) */}\n              <div className=\"my-auto z-10 w-full max-w-sm mx-auto\">\n                {audioState.currentTrack ? (\n                  renderMediaNotificationCard(true)\n                ) : (\n                  <div className=\"text-center text-xs text-slate-500\">\n                    PlayThat! Background Audio Engine Standby\n                  </div>\n                )}\n              </div>\n\n              {/* Lock Screen Bottom Swipe to Unlock */}\n              <div className=\"flex flex-col items-center gap-3 pb-2 z-10\">\n                <button\n                  onClick={() => setIsPhoneLocked(false)}\n                  className=\"w-full py-3 px-6 rounded-full bg-white/10 hover:bg-white/20 backdrop-blur-md border border-white/20 text-xs font-semibold text-white flex items-center justify-center gap-2 shadow-xl active:scale-95 transition-all\"\n                >\n                  <Unlock className=\"w-4 h-4\" />\n                  <span>Tap to Unlock</span>\n                </button>\n                <span className=\"text-[11px] text-slate-400\">\n                  {audioState.isPlaying\n                    ? \'Music is playing smoothly in the background\'\n                    : \'Device locked\'}\n                </span>\n              </div>\n            </div>\n          ) : (\n            /* Running App Canvas */\n            children\n          )}\n        </div>\n\n        {/* Android Navigation Gesture Pill */}\n        <div className=\"h-5 w-full flex items-center justify-center bg-slate-950 shrink-0 z-40 select-none\">\n          <div\n            onClick={() => {\n              if (isPhoneLocked) setIsPhoneLocked(false);\n            }}\n            className=\"w-32 h-1 bg-slate-600/80 rounded-full hover:bg-slate-400 transition-colors cursor-pointer\"\n          />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
