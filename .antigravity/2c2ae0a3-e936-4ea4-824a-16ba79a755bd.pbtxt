    content: "    const valid = await verifyVaultPIN(enteredPin);\n    if (valid) {\n      setIsUnlocked(true);\n      setCurrentPin(enteredPin);\n      setPinInput(\'\');\n      setErrorMessage(null);\n      await loadVaultItems();\n    } else {\n      setErrorMessage(\'Incorrect PIN. Please try again.\');\n      setPinInput(\'\');\n    }\n  };\n\n  const handleSetupPin = async () => {\n    if (pinInput.length < 4) {\n      setErrorMessage(\'PIN must be at least 4 digits\');\n      return;\n    }\n\n    if (!confirmPinInput) {\n      setConfirmPinInput(pinInput);\n      setPinInput(\'\');\n      return;\n    }\n\n    if (pinInput !== confirmPinInput) {\n      setErrorMessage(\'PINs do not match. Please start over.\');\n      setConfirmPinInput(\'\');\n      setPinInput(\'\');\n      return;\n    }\n\n    // Set PIN\n    await setVaultPIN(pinInput);\n    setIsConfigured(true);\n    setIsSettingUp(false);\n    setIsUnlocked(true);\n    setCurrentPin(pinInput);\n    setPinInput(\'\');\n    setConfirmPinInput(\'\');\n    await loadVaultItems();\n  };\n\n  // Calculator disguise logic\n  const handleCalcButton = (val: string) => {\n    // Secret unlock shortcut in calculator: type PIN and press \'=\'\n    if (val === \'=\') {\n      try {\n        if (calcDisplay === currentPin && currentPin) {\n          setIsDisguised(false);\n          setIsUnlocked(true);\n          return;\n        }\n        const sanitized = calcDisplay.replace(/\303\227/g, \'*\').replace(/\303\267/g, \'/\');\n        // eslint-disable-next-line no-eval\n        const result = eval(sanitized);\n        setCalcHistory(calcDisplay + \' =\');\n        setCalcDisplay(String(result));\n      } catch {\n        setCalcDisplay(\'Error\');\n      }"
