    content: "              </button>\n\n              {/* Subtitles Button */}\n              <button\n                onClick={onOpenSubtitleSettings}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Subtitle Customization\"\n              >\n                <Subtitles className=\"w-5 h-5\" />\n              </button>\n\n              {/* Settings Dropdown Toggle */}\n              <button\n                onClick={() => setShowSettingsMenu(!showSettingsMenu)}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Playback Settings\"\n              >\n                <Settings className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Settings Menu Modal */}\n          {showSettingsMenu && (\n            <div className=\"absolute top-16 right-4 z-50 bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl p-4 shadow-2xl w-64 text-slate-200 flex flex-col gap-3\">\n              <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Playback Settings\n              </div>\n\n              {/* Speed Controller */}\n              <div className=\"flex flex-col gap-1.5\">\n                <span className=\"text-xs font-medium\">Speed: {playbackRate}x</span>\n                <div className=\"grid grid-cols-4 gap-1\">\n                  {[0.5, 1.0, 1.5, 2.0].map((rate) => (\n                    <button\n                      key={rate}\n                      onClick={() => {\n                        setPlaybackRate(rate);\n                        if (videoRef.current) videoRef.current.playbackRate = rate;\n                      }}\n                      className={`py-1 text-xs rounded font-mono ${\n                        playbackRate === rate\n                          ? \'bg-blue-600 text-white font-bold\'\n                          : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\n                      }`}\n                    >\n                      {rate}x\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Subtitle Track Selector */}\n              {availableSubtitleTracks.length > 0 && (\n                <div className=\"flex flex-col gap-1.5 border-t border-slate-800 pt-2\">\n                  <span className=\"text-xs font-medium\">Subtitle Track:</span>"
