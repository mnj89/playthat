1 text-xs font-medium rounded-md bg-white/10 hover:bg-white/20 text-slate-200 transition-colors\\\"\\n                title=\\\"Aspect Ratio\\\"\\n              >\\n                {aspectRatio.toUpperCase()}\\n              </button>\\n\\n              {/* Subtitles Button */}\\n              <button\\n                onClick={onOpenSubtitleSettings}\\n                className=\\\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\\\"\\n                title=\\\"Subtitle Customization\\\"\\n              >\\n                <Subtitles className=\\\"w-5 h-5\\\" />\\n              </button>\\n\\n              {/* Audio & Video Enhancements Button */}\\n              <button\\n                onClick={() => setIsEnhancementsModalOpen(true)}\\n                className=\\\"p-2 rounded-full hover:bg-white/20 text-cyan-300 hover:text-white transition-colors\\\"\\n                title=\\\"Audio & Video Enhancement Studio\\\"\\n              >\\n                <Sparkles className=\\\"w-5 h-5\\\" />\\n              </button>\\n\\n              {/* Settings Dropdown Toggle */}\\n              <button\\n                onClick={() => setShowSettingsMenu(!showSettingsMenu)}\\n                className=\\\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\\\"\\n                title=\\\"Playback Settings\\\"\\n              >\\n                <Settings className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Settings Menu Modal */}\\n          {showSettingsMenu && (\\n            <div className=\\\"absolute top-16 right-4 z-50 bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl p-4 shadow-2xl w-68 text-slate-200 flex flex-col gap-3\\\">\\n              <div className=\\\"text-xs font-semibold text-slate-400 uppercase tracking-wider\\\">\\n                Playback Settings\\n              </div>\\n\\n              {/* A/V Enhancements Studio Button */}\\n              <button\\n                onClick={() => {\\n                  setIsEnhancementsModalOpen(true);\\n                  setShowSettingsMenu(false);\\n                }}\\n                className=\\\"w-full py-2 px-3 rounded-xl bg-cyan-950/70 hover:bg-cyan-900/70 text-xs font-bold flex items-center justify-between text-cyan-300 border border-cyan-800/60 transition-colors shadow-sm\\\"\\n              >\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <Sparkles className=\\\"w-4 h-4 text-cyan-400\\\" />\\n                  <span>A/V Enhancements</span>\\n                </div>\\n                <span className=\\\"text-[10px] font-mono text-cyan-300 font-bold\\\">HW+ & Boost</span>\\n              </button>\\n\\n              {/* Speed Controller */}\\n              <div className=\\\"flex flex-col gap-1.5\\\">\\n                <span className=\\\"text-xs font-medium\\\">Speed: {playbackRate}x</span>\\n                <div className=\\\"grid grid-cols-4 gap-1\\\">\\n                  {[0.5, 1.0, 1.5, 2.0].map((rate) => (\\n                    <button\\n                      key={rate}\\n                      onClick={() => {\\n                        setPlaybackRate(rate);\\n                        if (videoRef.current) videoRef.current.playbackRate = rate;\\n                      }}\\n                      className={`py-1 text-xs rounded font-mono ${\\n                        playbackRate === rate\\n                          ? \'bg-blue-600 text-white font-bold\'\\n                          : \'bg-slate-800 text-slate-300 hover:bg-slate-700\'\\n                      }`}\\n                    >\\n                      {rate}x\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              {/* Subtitle Track Selector */}\\n              {availableSubtitleTracks.length > 0 && (\\n                <div className=\\\"flex flex-col gap-1.5 border-t border-slate-800 pt-2\\\">\\n                  <span className=\\\"text-xs font-medium\\\">Subtitle Track:</span>\\n                  <div className=\\\"flex flex-col gap-1 max-h-32 overflow-y-auto\\\">\\n                    <button\\n                      onClick={() => onSelectSubtitleTrack?.(null)}\\n                      className={`text-left px-2 py-1 text-xs rounded flex items-center justify-between ${\\n                        !activeSubtitleTrack ? \'bg-blue-600/30 text-blue-400\' : \'hover:bg-slate-800\'\\n                      }`}\\n                    >\\n                      <span>Off</span>\\n                      {!activeSubtitleTrack && <Check className=\\\"w-3.5 h-3.5\\\" />}\\n                    </button>\\n                    {availableSubtitleTracks.map((trk) => (\\n                      <button\\n                        key={trk.id}\\n                        onClick={() => onSelectSubtitleTrack?.(trk)}\\n                        className={`text-left px-2 py-1 text-xs rounded flex items-center justify-between ${\\n                          activeSubtitleTrack?.id === trk.id\\n                            ? \'bg-blue-600/30 text-blue-400 font-medium\'\\n                            : \'hover:bg-slate-800\'\\n                        }`}\\n                      >\\n                        <span>{trk.label}</span>\\n                        {activeSubtitleTrack?.id === trk.id && <Check className=\\\"w-3.5 h-3.5\\\" />}\\n                      </button>\\n                    ))}\\n                  </div>\\n                </div>\\n              )}\\n\\n              {/* Lock Screen Action */}\\n              <button\\n                onClick={() => {\\n                  setIsLocked(true);\\n                  setShowSettingsMenu(false);\\n                }}\\n                className=\\\"w-full mt-1 py-1.5 px-3 rounded-lg bg-slate-800 hover:bg-slate-700 text-xs font-medium flex items-center justify-center gap-2 text-slate-200\\\"\\n              >\\n                <Lock className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Lock Screen Touches</span>\\n              </button>\\n            </div>\\n          )}\\n\\n          {/* Center Play/Pause Large Action */}\\n          <div className=\\\"flex items-center justify-center pointer-events-none\\\">\\n            <button\\n              onClick={togglePlayPause}\\n              className=\\\"pointer-events-auto p-4 rounded-full bg-slate-900/60 backdrop-blur-md text-white hover:bg-slate-900/80 transition-transform active:scale-90 border border-white/20\\\"\\n            >\\n              {isPlaying ? <Pause className=\\\"w-8 h-8\\\" /> : <Play className=\\\"w-8 h-8 translate-x-0.5\\\" />}\\n            </button>\\n          </div>\\n\\n          {/* Bottom Bar Controls */}\\n          <div className=\\\"flex flex-col gap-2\\\">\\n            {/* Timeline Scrubbing Bar */}\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <span className=\\\"text-xs font-mono text-slate-300 w-12 text-right\\\">\\n                {formatTime(currentTime)}\\n              </span>\\n              <div className=\\\"relative flex-1 flex items-center\\\">\\n                <input\\n                  type=\\\"range\\\"\\n                  min={0}\\n                  max={duration || 100}\\n                  step={0.1}\\n                  value={currentTime}\\n                  onChange={handleSeek}\\n                  className=\\\"w-full h-1.5 bg-slate-700/80 rounded-lg appearance-none cursor-pointer accent-blue-500 hover:h-2 transition-all\\\"\\n                />\\n              </div>\", \"TargetFile\":\"/src/components/MXPlayer.tsx\", \"toolAction\":\"Updating MXPlayer colors\", \"toolSummary\":\"Update MXPlayer colors\"}"
      thinking_signature: "\022\375\005\n\372\005\001i\024}\023\021\023z$NgQ7\206\a\"\200X\006\255\232\2224\rYta\377\302\003\375\367+KJS\351(_\302cWQ\351f\031\234&k\307\316\204\232\275\267bi<Gm\231j:;.\355\247B\224\aA\003\265+\2230\005\2621\242\314\356\341\206\177\021\a\203{V\202B\306{\377\006ny@\324\254\331(\230\031z\345J\223\223\305\251\257oX\362D\212\230\2744<f\025\025#\216\032\001\320M\006\247\260!\"\212b\253\262\202\036;qf]@X\311Z\245\312H\035\340\366\024\242WZS\214dlF\303\244]~\2145F\314@\240\216\243H\"\255\212\344\265\032\033\t\247\204\251\261\v\355_e\220\217}H\221\031\237\245\223\251\312\344\373&\320\033*{h\b\000\246\277?A\236W]\024\354*\037C\203\205\364\314\343\027\036\336 9Q>\350W\235\021\023\330*&\205\371\201<C\264i\353O\024\201\275\376\006\017\'\206A\b\253^\300\031v\355I@4z\323\023.\260\372\260}-\255\202\252\256b\377N*\265\272\001\340OtZ\366?hE\276\261\375\235\346\215 \364\311\256@\033\310\311\276\316\343\305\026\024\0237\'\274\006\352\237\3524m\307\344\341.[_28\325M\252\325**\3349\354\355\022NM\364\022=\301\327\257p\312\022\347\v\266Q\227\251\005\016-\352\vO\342#|\b\001Yh4\272\274\353\213;\000a5\020\330L9&i\371\030\315\372\310\214\t\257\254e\271\302^\336M[\204l\235\305\260A*\325F\000\316\316\223D\017\245\265X\257Fu}\270t\005\374\322\335\252\273Pn\336\224\020\276n\036?AKX\v\177\313\211\325\033rAJ\220\031\316\332\205\257F/\332\243\233\323xN\027\nsL1\306v\bu\vC?D\326\026\257\351s{\2303\352;+\314s\022\362\v\257=\2220\202j\370k\306\241S\321z\250Z\262G\005\245\22221\373\022J\364\203\333\326\272te\340#\343\254\226\354\342\277\020\022\0261\301>YH\254\327\233\030$,\005F\240=\255\343\300?\247\035*=\360\302\305l\314\314\352\202p#<\353\205\372\264\311k]\301\000\207\210P\ro\2345\223\037\260\361\224\303\037\325\323\002^\264B\314\231\301\205}\034uH\274RR\240\f\252&7i.\254\221\376\203K\226\211\300%\276\220}\255e!\206\256\236\225L\321xs[P\312dAB\363\334T{\236\376\225\356\371\023/\343\260S`E\020\322\031r\216\r\274\350\244K\275\'/m\036>:Z\301\304\315\217\347\336I9\202\257