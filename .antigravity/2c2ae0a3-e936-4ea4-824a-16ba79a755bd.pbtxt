    content: "\n                  {/* Encrypted Vault Trigger */}\n                  <button\n                    onClick={() => setIsVaultModalOpen(true)}\n                    className=\"p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-300 hover:text-orange-400 transition-colors border border-zinc-800 hover:border-orange-500/40\"\n                    title=\"Open Private Vault\"\n                  >\n                    <Lock className=\"w-4 h-4\" />\n                  </button>\n\n                  {/* Android .APK & Install Trigger */}\n                  <button\n                    onClick={() => setIsInstallModalOpen(true)}\n                    className=\"p-1.5 px-2.5 rounded-xl bg-orange-500/10 hover:bg-orange-500/20 text-orange-400 transition-colors border border-orange-500/40 flex items-center gap-1.5\"\n                    title=\"Download PlayThat! .APK for Android\"\n                  >\n                    <Smartphone className=\"w-4 h-4 text-orange-400\" />\n                    <span className=\"text-[11px] font-bold text-orange-400\">Get .APK</span>\n                  </button>\n                </div>\n              </header>\n            )}\n\n            {/* Active View Router */}\n            <main className=\"flex-1 w-full overflow-hidden flex flex-col bg-black\">\n              {activeTab === \'folders\' && (\n                <FileBrowser\n                  mediaItems={mediaList}\n                  onPlayMedia={handlePlayMedia}\n                  onOpenVault={() => setIsVaultModalOpen(true)}\n                  onImportLocalFile={handleImportLocalFile}\n                  onOpenStreamDialog={() => setIsStreamDialogOpen(true)}\n                  onToggleFavorite={handleToggleFavorite}\n                  onDeleteMedia={handleDeleteMedia}\n                  onAddToVault={handleAddToVault}\n                />"
