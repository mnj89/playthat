  code_action {
    action_spec {
      create_file {
        instruction: "/**\n * PlayThat! - Android Media Player & Stream Downloader\n * Signature MX Player gesture controls, in-app Chromium browser with M3U8/MP4 converter,\n * UC-style turbo download manager, custom subtitles, and AES-GCM encrypted private vault.\n */\n\nimport React, { useState, useEffect } from \'react\';\nimport {\n  Folder,\n  Globe,\n  ArrowDownToLine,\n  ListMusic,\n  Lock,\n  Sun,\n  Moon,\n  Radio,\n  Search,\n  CheckCircle,\n  X,\n  Play,\n  Film,\n  Sparkles,\n} from \'lucide-react\';\nimport {\n  MediaItem,\n  SubtitleSettings,\n  SubtitleTrack,\n  Playlist,\n  ActiveTab,\n} from \'./types\';\nimport {\n  INITIAL_MEDIA_ITEMS,\n  DEFAULT_SUBTITLE_SETTINGS,\n} from \'./data/sampleMedia\';\nimport { SAMPLE_SUBTITLES } from \'./services/subtitleParser\';\nimport { downloadManager } from \'./services/downloadManagerService\';\nimport { PlayThatIcon } from \'./components/PlayThatIcon\';\nimport { AndroidFrame, FrameMode } from \'./components/AndroidFrame\';\nimport { MXPlayer } from \'./components/MXPlayer\';\nimport { FileBrowser } from \'./components/FileBrowser\';\nimport { InAppBrowser } from \'./components/InAppBrowser\';\nimport { UCDownloadManager } from \'./components/UCDownloadManager\';\nimport { PlaylistManager } from \'./components/PlaylistManager\';\nimport { PrivateVaultModal } from \'./components/PrivateVaultModal\';\nimport { SubtitleCustomizerModal } from \'./components/SubtitleCustomizerModal\';\n\nexport default function App() {\n  // Theme & Layout state\n  const [isDarkMode, setIsDarkMode] = useState<boolean>(true);\n  const [frameMode, setFrameMode] = useState<FrameMode>(\'phone\');\n  const [activeTab, setActiveTab] = useState<ActiveTab>(\'folders\');\n\n  // Media Library state\n  const [mediaList, setMediaList] = useState<MediaItem[]>(() => {\n    const saved = localStorage.getItem(\'playthat_media_items\');\n    if (saved) {\n      try {\n        return JSON.parse(saved);\n      } catch {\n        return INITIAL_MEDIA_ITEMS;\n      }\n    }\n    return INITIAL_MEDIA_ITEMS;\n  });\n\n  // Playlists state\n  const [playlists, setPlaylists] = useState<Playlist[]>([\n    {\n      id: \'pl-1\',\n      title: \'Action & Sci-Fi Highlights\',\n      description: \'High-bitrate cinema demos with 4K HDR\',\n      mediaIds: [\'media-2\', \'media-3\'],\n      createdAt: Date.now() - 86400000,\n      updatedAt: Date.now() - 86400000,\n    },\n    {\n      id: \'pl-2\',\n      title: \'Animation Classics\',\n      description: \'Family friendly open movie projects\',\n      mediaIds: [\'media-1\'],\n      createdAt: Date.now() - 86400000 * 2,\n      updatedAt: Date.now() - 86400000 * 2,\n    },\n  ]);\n\n  // Active Player state\n  const [activePlayingMedia, setActivePlayingMedia] = useState<MediaItem | null>(null);\n\n  // Subtitle state\n  const [subtitleSettings, setSubtitleSettings] = useState<SubtitleSettings>(DEFAULT_SUBTITLE_SETTINGS);\n  const [isSubtitleModalOpen, setIsSubtitleModalOpen] = useState<boolean>(false);\n  const [availableSubtitleTracks, setAvailableSubtitleTracks] = useState<SubtitleTrack[]>(\n    SAMPLE_SUBTITLES.default\n  );\n  const [activeSubtitleTrack, setActiveSubtitleTrack] = useState<SubtitleTrack | null>(\n    SAMPLE_SUBTITLES.default[0]\n  );\n\n  // Vault state\n  const [isVaultModalOpen, setIsVaultModalOpen] = useState<boolean>(false);\n\n  // Network Stream Dialog state\n  const [isStreamDialogOpen, setIsStreamDialogOpen] = useState<boolean>(false);\n  const [streamDialogUrl, setStreamDialogUrl] = useState<string>(\'\');\n  const [streamDialogTitle, setStreamDialogTitle] = useState<string>(\'\');\n\n  // Toast feedback\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Download tasks listener for header badge\n  const [activeDownloadCount, setActiveDownloadCount] = useState<number>(0);\n\n  useEffect(() => {\n    const unsubscribe = downloadManager.subscribe((tasks) => {\n      const active = tasks.filter((t) => t.status === \'downloading\').length;\n      setActiveDownloadCount(active);\n    });\n    return unsubscribe;\n  }, []);\n\n  // Persist library\n  useEffect(() => {\n    localStorage.setItem(\'playthat_media_items\', JSON.stringify(mediaList));\n  }, [mediaList]);\n\n  const showToast = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => setToastMessage(null), 3500);\n  };\n\n  // Play media item\n  const handlePlayMedia = (item: MediaItem) => {\n    setActivePlayingMedia(item);\n  };\n\n  // Add downloaded or converted stream to library\n  const handleSaveToLibrary = (item: MediaItem) => {\n    setMediaList((prev) => [item, ...prev]);\n    showToast(`Saved \"${item.title}\" to library!`);\n  };\n\n  // Local file import handler\n  const handleImportLocalFile = (file: File) => {\n    const fileUrl = URL.createObjectURL(file);\n    const isAudio = file.type.startsWith(\'audio\');\n    const newItem: MediaItem = {\n      id: `local-file-${Date.now()}`,\n      title: file.name.replace(/\\.[^/.]+$/, \'\'),\n      folder: \'Camera\',\n      sourceType: \'local\',\n      url: fileUrl,\n      thumbnailUrl: isAudio\n        ? \'https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=600&q=80\'\n        : \'https://images.unsplash.com/photo-1478760329108-5c3ed9d495a0?auto=format&fit=crop&w=600&q=80\',\n      duration: 180, // estimated until metadata loads\n      currentTime: 0,\n      resolution: isAudio ? \'Audio Stream\' : \'1080p FHD\',\n      fileSize: file.size,\n      codec: file.type || \'MP4 Video\',\n      decoder: \'HW\',\n      createdAt: Date.now(),\n      isFavorite: false,\n      isEncrypted: false,\n    };\n\n    setMediaList((prev) => [newItem, ...prev]);\n    showToast(`Loaded ${file.name} into PlayThat!`);\n    handlePlayMedia(newItem);\n  };\n\n  // Direct Network Stream Submit\n  const handleStreamSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!streamDialogUrl.trim()) return;\n\n    const url = streamDialogUrl.trim();\n    const title = streamDialogTitle.trim() || \'Live Network Stream\';\n    const isM3U8 = url.includes(\'.m3u8\');\n\n    const newItem: MediaItem = {\n      id: `stream-url-${Date.now()}`,\n      title,\n      folder: \'Stream Captures\',\n      sourceType: \'stream\',\n      url,\n      thumbnailUrl: \'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\',\n      duration: 3600,\n      currentTime: 0,\n      resolution: isM3U8 ? \'HLS Multi-bitrate\' : \'1080p Stream\',\n      fileSize: 120000000,\n      codec: isM3U8 ? \'HLS / AAC\' : \'H.264 / AAC\',\n      decoder: \'HW\',\n      createdAt: Date.now(),\n      isFavorite: true,\n      isEncrypted: false,\n    };\n\n    setMediaList((prev) => [newItem, ...prev]);\n    setIsStreamDialogOpen(false);\n    setStreamDialogUrl(\'\');\n    setStreamDialogTitle(\'\');\n    handlePlayMedia(newItem);\n  };\n\n  const handleToggleFavorite = (id: string) => {\n    setMediaList((prev) =>\n      prev.map((m) => (m.id === id ? { ...m, isFavorite: !m.isFavorite } : m))\n    );\n  };\n\n  const handleDeleteMedia = (id: string) => {\n    setMediaList((prev) => prev.filter((m) => m.id !== id));\n    showToast(\'Video removed from library\');\n  };\n\n  const handleAddToVault = (item: MediaItem) => {\n    setIsVaultModalOpen(true);\n    showToast(`Opening Encrypted Vault to protect \"${item.title}\"`);\n  };\n\n  const handleCreatePlaylist = (title: string, description?: string) => {\n    const newPl: Playlist = {\n      id: `pl-${Date.now()}`,\n      title,\n      description,\n      mediaIds: [],\n      createdAt: Date.now(),\n      updatedAt: Date.now(),\n    };\n    setPlaylists((prev) => [newPl, ...prev]);\n    showToast(`Created playlist \"${title}\"`);\n  };\n\n  const handleDeletePlaylist = (id: string) => {\n    setPlaylists((prev) => prev.filter((p) => p.id !== id));\n    showToast(\'Playlist deleted\');\n  };\n\n  const handleRemoveFromPlaylist = (playlistId: string, mediaId: string) => {\n    setPlaylists((prev) =>\n      prev.map((p) =>\n        p.id === playlistId ? { ...p, mediaIds: p.mediaIds.filter((id) => id !== mediaId) } : p\n      )\n    );\n  };\n\n  const handleAddCustomTrack = (track: SubtitleTrack) => {\n    setAvailableSubtitleTracks((prev) => [track, ...prev]);\n    setActiveSubtitleTrack(track);\n    showToast(`Loaded custom subtitle: ${track.label}`);\n  };\n\n  return (\n    <div className={isDarkMode ? \'dark\' : \'\'}>\n      <AndroidFrame\n        frameMode={frameMode}\n        onFrameModeChange={setFrameMode}\n        isPlayerActive={!!activePlayingMedia}\n      >\n        {activePlayingMedia ? (\n          /* Full MX Player Mode */\n          <MXPlayer\n            media={activePlayingMedia}\n            onBack={() => setActivePlayingMedia(null)}\n            subtitleSettings={subtitleSettings}\n            onOpenSubtitleSettings={() => setIsSubtitleModalOpen(true)}\n            activeSubtitleTrack={activeSubtitleTrack}\n            onSelectSubtitleTrack={setActiveSubtitleTrack}\n            availableSubtitleTracks={availableSubtitleTracks}\n          />\n        ) : (\n          /* Main Application Shell */\n          <div className=\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden\">\n            {/* Top Bar Contract (Wordmark - Navigation - Actions) */}\n            <header className=\"h-14 px-4 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between gap-4 shrink-0 select-none\">\n              {/* Brand Wordmark & Icon */}\n              <div className=\"flex items-center gap-2.5\">\n                <PlayThatIcon size={32} />\n                <div className=\"flex items-baseline gap-1.5\">\n                  <span className=\"text-base font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent\">\n                    PlayThat!\n                  </span>\n                  <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-blue-950 text-blue-300 border border-blue-800/80 font-bold\">\n                    PRO\n                  </span>\n                </div>\n              </div>\n\n              {/* Right Zone Actions */}\n              <div className=\"flex items-center gap-2\">\n                {/* Active Download Badge Trigger */}\n                <button\n                  onClick={() => setActiveTab(\'downloads\')}\n                  className=\"relative p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors border border-slate-700/60\"\n                  title=\"UC Download Manager\"\n                >\n                  <ArrowDownToLine className=\"w-4 h-4\" />\n                  {activeDownloadCount > 0 && (\n                    <span className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-blue-500 text-[9px] font-bold text-white flex items-center justify-center animate-pulse\">\n                      {activeDownloadCount}\n                    </span>\n                  )}\n                </button>\n\n                {/* Encrypted Vault Trigger */}\n                <button\n                  onClick={() => setIsVaultModalOpen(true)}\n                  className=\"p-2 rounded-xl bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-400 transition-colors border border-emerald-800/60\"\n                  title=\"Open Private Vault\"\n                >\n                  <Lock className=\"w-4 h-4\" />\n                </button>\n\n                {/* Dark / Light Toggle */}\n                <button\n                  onClick={() => setIsDarkMode(!isDarkMode)}\n                  className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Toggle Dark/Light Mode\"\n                >\n                  {isDarkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </header>\n\n            {/* Active View Router */}\n            <main className=\"flex-1 w-full overflow-hidden flex flex-col\">\n              {activeTab === \'folders\' && (\n                <FileBrowser\n                  mediaItems={mediaList}\n                  onPlayMedia={handlePlayMedia}\n                  onOpenVault={() => setIsVaultModalOpen(true)}\n                  onImportLocalFile={handleImportLocalFile}\n                  onOpenStreamDialog={() => setIsStreamDialogOpen(true)}\n                  onToggleFavorite={handleToggleFavorite}\n                  onDeleteMedia={handleDeleteMedia}\n                  onAddToVault={handleAddToVault}\n                />\n              )}\n\n              {activeTab === \'browser\' && (\n                <InAppBrowser\n                  onPlayMedia={handlePlayMedia}\n                  onSaveToLibrary={handleSaveToLibrary}\n                />\n              )}\n\n              {activeTab === \'downloads\' && (\n                <UCDownloadManager\n                  onPlayMedia={handlePlayMedia}\n                  onSaveToVault={handleAddToVault}\n                />\n              )}\n\n              {activeTab === \'playlists\' && (\n                <PlaylistManager\n                  playlists={playlists}\n                  mediaItems={mediaList}\n                  onCreatePlaylist={handleCreatePlaylist}\n                  onDeletePlaylist={handleDeletePlaylist}\n                  onPlayMedia={handlePlayMedia}\n                  onRemoveFromPlaylist={handleRemoveFromPlaylist}\n                />\n              )}\n            </main>\n\n            {/* Android Bottom Navigation Bar */}\n            <nav className=\"h-16 px-2 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 grid grid-cols-4 items-center shrink-0 select-none z-30\">\n              <button\n                onClick={() => setActiveTab(\'folders\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'folders\' ? \'text-blue-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <Folder className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Media</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'browser\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'browser\' ? \'text-cyan-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <Globe className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Browser</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'downloads\')}\n                className={`relative flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'downloads\' ? \'text-amber-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <ArrowDownToLine className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Downloads</span>\n                {activeDownloadCount > 0 && (\n                  <span className=\"absolute top-1 right-5 w-2 h-2 rounded-full bg-blue-500 animate-ping\" />\n                )}\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'playlists\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'playlists\' ? \'text-purple-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <ListMusic className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Playlists</span>\n              </button>\n            </nav>\n          </div>\n        )}\n\n        {/* Subtitle Customizer Modal */}\n        <SubtitleCustomizerModal\n          isOpen={isSubtitleModalOpen}\n          onClose={() => setIsSubtitleModalOpen(false)}\n          settings={subtitleSettings}\n          onUpdateSettings={setSubtitleSettings}\n          onAddCustomTrack={handleAddCustomTrack}\n        />\n\n        {/* Private Encrypted Vault Modal */}\n        <PrivateVaultModal\n          isOpen={isVaultModalOpen}\n          onClose={() => setIsVaultModalOpen(false)}\n          onPlayDecryptedMedia={handlePlayMedia}\n          availableLibraryVideos={mediaList.filter((m) => !m.isEncrypted)}\n        />\n\n        {/* Network Stream URL Dialog */}\n        {isStreamDialogOpen && (\n          <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n            <div className=\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl flex flex-col gap-4\">\n              <div className=\"flex items-center justify-between border-b border-slate-800 pb-3\">\n                <div className=\"flex items-center gap-2\">\n                  <Radio className=\"w-5 h-5 text-cyan-400\" />\n                  <h4 className=\"text-sm font-bold text-white\">Direct Network Stream</h4>\n                </div>\n                <button\n                  onClick={() => setIsStreamDialogOpen(false)}\n                  className=\"p-1 rounded-full text-slate-400 hover:text-white\"\n                >\n                  <X className=\"w-5 h-5\" />\n                </button>\n              </div>\n\n              <form onSubmit={handleStreamSubmit} className=\"flex flex-col gap-3\">\n                <div className=\"flex flex-col gap-1\">\n                  <label className=\"text-xs font-medium text-slate-300\">Stream URL (HLS / MP4 / DASH)</label>\n                  <input\n                    type=\"url\"\n                    required\n                    placeholder=\"https://.../stream.m3u8 or .mp4\"\n                    value={streamDialogUrl}\n                    onChange={(e) => setStreamDialogUrl(e.target.value)}\n                    className=\"w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-xs font-mono text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500\"\n                  />\n                </div>\n\n                <div className=\"flex flex-col gap-1\">\n                  <label className=\"text-xs font-medium text-slate-300\">Title / Channel Name</label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. 24/7 Wildlife Stream or Cyberpunk Teaser\"\n                    value={streamDialogTitle}\n                    onChange={(e) => setStreamDialogTitle(e.target.value)}\n                    className=\"w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500\"\n                  />\n                </div>\n\n                <div className=\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400 flex flex-col gap-1\">\n                  <span className=\"font-semibold text-slate-300\">Quick Test Streams:</span>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setStreamDialogUrl(\'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\');\n                      setStreamDialogTitle(\'Mux HLS Adaptive Test Feed\');\n                    }}\n                    className=\"text-left text-blue-400 hover:underline truncate\"\n                  >\n                    \342\200\242 Mux HLS Big Buck Bunny (.m3u8)\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setStreamDialogUrl(\'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/TearsOfSteel.mp4\');\n                      setStreamDialogTitle(\'Tears of Steel 1080p\');\n                    }}\n                    className=\"text-left text-cyan-400 hover:underline truncate\"\n                  >\n                    \342\200\242 Tears of Steel MP4 (.mp4)\n                  </button>\n                </div>\n\n                <div className=\"flex justify-end gap-2 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setIsStreamDialogOpen(false)}\n                    className=\"px-4 py-2 rounded-xl bg-slate-800 text-xs font-semibold text-slate-300 hover:bg-slate-700\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs font-semibold text-white shadow-md flex items-center gap-1.5\"\n                  >\n                    <Play className=\"w-3.5 h-3.5 fill-white\" />\n                    <span>Play Stream</span>\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {/* Global Toast Notification */}\n        {toastMessage && (\n          <div className=\"fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2 bg-slate-900/95 text-white border border-slate-700 rounded-full shadow-2xl text-xs font-medium flex items-center gap-2 animate-in fade-in slide-in-from-bottom-2 duration-150\">\n            <CheckCircle className=\"w-4 h-4 text-emerald-400\" />\n            <span>{toastMessage}</span>\n          </div>\n        )}\n      </AndroidFrame>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }
