  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { Wifi, BatteryMedium, Signal, Smartphone, Monitor, Tablet } from \'lucide-react\';\n\nexport type FrameMode = \'phone\' | \'tablet\' | \'responsive\';\n\ninterface AndroidFrameProps {\n  children: React.ReactNode;\n  frameMode: FrameMode;\n  onFrameModeChange: (mode: FrameMode) => void;\n  isPlayerActive?: boolean;\n}\n\nexport const AndroidFrame: React.FC<AndroidFrameProps> = ({\n  children,\n  frameMode,\n  onFrameModeChange,\n  isPlayerActive = false,\n}) => {\n  const [currentTimeStr, setCurrentTimeStr] = useState<string>(\'12:45\');\n\n  useEffect(() => {\n    const updateTime = () => {\n      const d = new Date();\n      setCurrentTimeStr(\n        d.toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', hour12: false })\n      );\n    };\n    updateTime();\n    const interval = setInterval(updateTime, 10000);\n    return () => clearInterval(interval);\n  }, []);\n\n  if (frameMode === \'responsive\') {\n    return (\n      <div className=\"w-full min-h-screen bg-slate-950 text-slate-100 flex flex-col\">\n        {/* Subtle Top Device Switcher Floating Bar */}\n        <div className=\"sticky top-0 z-50 px-4 py-2 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">View Mode:</span>\n            <div className=\"flex items-center bg-slate-800/90 rounded-lg p-0.5 border border-slate-700\">\n              <button\n                onClick={() => onFrameModeChange(\'phone\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Phone Mockup\"\n              >\n                <Smartphone className=\"w-3.5 h-3.5\" />\n                <span>Phone</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'tablet\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Tablet Mockup\"\n              >\n                <Tablet className=\"w-3.5 h-3.5\" />\n                <span>Tablet</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'responsive\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md bg-blue-600 text-white shadow-sm flex items-center gap-1.5\"\n                title=\"Adaptive Responsive Mode\"\n              >\n                <Monitor className=\"w-3.5 h-3.5\" />\n                <span>Full Responsive</span>\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2 text-xs text-slate-400\">\n            <span>PlayThat! v2.4</span>\n            <span>\302\267</span>\n            <span className=\"text-emerald-400\">Hardware Acceleration Active</span>\n          </div>\n        </div>\n\n        {/* Content body */}\n        <div className=\"flex-1 w-full max-w-7xl mx-auto flex flex-col\">\n          {children}\n        </div>\n      </div>\n    );\n  }\n\n  const isTablet = frameMode === \'tablet\';\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 flex flex-col items-center justify-center p-2 sm:p-4 md:p-6 overflow-x-hidden\">\n      {/* Device Mode Switcher Toolbar */}\n      <div className=\"mb-3 flex items-center gap-3 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-800 shadow-md\">\n        <span className=\"text-xs text-slate-400 font-medium\">Device Frame:</span>\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={() => onFrameModeChange(\'phone\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'phone\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            <span>Android Phone</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'tablet\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'tablet\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Tablet className=\"w-3.5 h-3.5\" />\n            <span>Tablet</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'responsive\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'responsive\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Monitor className=\"w-3.5 h-3.5\" />\n            <span>Full View</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Realistic Android Hardware Chassis */}\n      <div\n        className={`relative bg-slate-900 border-[7px] border-slate-800 rounded-[44px] shadow-2xl shadow-cyan-950/20 overflow-hidden flex flex-col transition-all duration-300 ${\n          isTablet\n            ? \'w-full max-w-[960px] h-[780px]\'\n            : isPlayerActive\n            ? \'w-full max-w-[840px] h-[520px] rounded-[36px]\' // auto landscape for player\n            : \'w-full max-w-[430px] h-[870px]\'\n        }`}\n        style={{\n          boxShadow: \'0 0 0 2px rgba(255, 255, 255, 0.08), 0 25px 60px -15px rgba(0, 0, 0, 0.7)\',\n        }}\n      >\n        {/* Android Punch Hole Camera */}\n        <div className=\"absolute top-2.5 left-1/2 -translate-x-1/2 z-50 flex items-center justify-center\">\n          <div className=\"w-4 h-4 rounded-full bg-black border border-slate-800 shadow-inner flex items-center justify-center\">\n            <div className=\"w-1.5 h-1.5 rounded-full bg-slate-900/90\" />\n          </div>\n        </div>\n\n        {/* Android Status Bar */}\n        <div className=\"h-7 w-full px-6 flex items-center justify-between text-xs text-slate-300 bg-slate-950/60 backdrop-blur-sm shrink-0 z-40 select-none\">\n          <span className=\"font-semibold tracking-wide text-[11px] font-mono\">\n            {currentTimeStr}\n          </span>\n          <div className=\"flex items-center gap-2 text-slate-300\">\n            <Signal className=\"w-3 h-3\" />\n            <span className=\"text-[10px] font-mono font-medium\">5G</span>\n            <Wifi className=\"w-3 h-3\" />\n            <div className=\"flex items-center gap-0.5\">\n              <span className=\"text-[10px] font-mono font-medium\">94%</span>\n              <BatteryMedium className=\"w-3.5 h-3.5 text-emerald-400\" />\n            </div>\n          </div>\n        </div>\n\n        {/* Device Inner Screen Canvas */}\n        <div className=\"flex-1 w-full overflow-hidden flex flex-col relative bg-slate-950\">\n          {children}\n        </div>\n\n        {/* Android Navigation Gesture Pill */}\n        <div className=\"h-5 w-full flex items-center justify-center bg-slate-950 shrink-0 z-40 select-none\">\n          <div className=\"w-32 h-1 bg-slate-600/80 rounded-full hover:bg-slate-400 transition-colors cursor-pointer\" />\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/AndroidFrame.tsx"
        }
        overwrite: true
      }
    }
