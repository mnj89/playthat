    content: "      {/* 1. Main Settings List (Matches Reference Screenshot in Black, White, and Grey) */}\n      {activeSection === \'main\' && (\n        <div className=\"flex flex-col pb-8\">\n          {renderHeader(\'Settings\', onBack)}\n\n          <div className=\"flex flex-col divide-y divide-zinc-900\">\n            {/* Android .APK & Install Banner */}\n            <button\n              onClick={onOpenInstallModal}\n              className=\"flex items-center justify-between px-4 py-3.5 bg-gradient-to-r from-orange-950/30 via-zinc-900/60 to-zinc-900 border-b border-orange-500/30 hover:bg-orange-950/40 text-left transition-colors group\"\n            >\n              <div className=\"flex items-center gap-4\">\n                <div className=\"w-9 h-9 rounded-xl bg-orange-500/20 border border-orange-500/40 flex items-center justify-center text-orange-400 shrink-0\">\n                  <Smartphone className=\"w-4 h-4\" />\n                </div>\n                <div className=\"flex flex-col\">\n                  <div className=\"flex items-center gap-2\">\n                    <span className=\"text-sm font-bold text-white group-hover:text-orange-400 transition-colors\">\n                      Get Android .APK / Install on Phone\n                    </span>\n                    <span className=\"px-1.5 py-0.2 rounded bg-orange-500 text-black text-[9px] font-black font-mono\">\n                      .APK\n                    </span>\n                  </div>\n                  <span className=\"text-xs text-zinc-400\">\n                    Download standalone PlayThat.apk or install via native Android WebAPK\n                  </span>\n                </div>\n              </div>\n              <ChevronRight className=\"w-5 h-5 text-orange-400 group-hover:translate-x-0.5 transition-transform shrink-0\" />\n            </button>\n\n            {/* General */}\n            <button\n              onClick={() => setActiveSection(\'general\')}\n              className=\"flex items-center justify-between px-4 py-3.5 hover:bg-zinc-900/70 active:bg-zinc-900 text-left transition-colors group\""
    num_lines: 930
    num_bytes: 43749
