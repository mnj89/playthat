    content: "              onClick={() => audioPlayerService.togglePlay()}\n              className=\"w-8 h-8 rounded-full bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center shadow-md active:scale-95 transition-all\"\n              title={audioState.isPlaying ? \'Pause\' : \'Play\'}\n            >\n              {audioState.isPlaying ? (\n                <Pause className=\"w-4 h-4 fill-white\" />\n              ) : (\n                <Play className=\"w-4 h-4 fill-white ml-0.5\" />\n              )}\n            </button>\n\n            <button\n              onClick={() => audioPlayerService.next()}\n              className=\"p-1.5 text-slate-300 hover:text-white rounded-full hover:bg-white/10 transition-colors\"\n              title=\"Next\"\n            >\n              <SkipForward className=\"w-4 h-4 fill-slate-300\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Scrubber in Notification */}\n        <div className=\"mt-2.5 flex flex-col gap-1\">\n          <div className=\"w-full h-1 bg-slate-700/80 rounded-full overflow-hidden\">\n            <div\n              className=\"h-full bg-cyan-400 rounded-full\"\n              style={{ width: `${Math.min(100, Math.max(0, progressPercent))}%` }}\n            />\n          </div>\n          <div className=\"flex items-center justify-between text-[10px] font-mono text-slate-400\">\n            <span>{formatSecs(audioState.currentTime)}</span>\n            <span>{formatSecs(audioState.duration)}</span>\n          </div>\n        </div>\n      </div>\n    );\n  };\n\n  if (frameMode === \'responsive\') {\n    return (\n      <div className=\"w-full min-h-screen bg-slate-950 text-slate-100 flex flex-col\">\n        {/* Subtle Top Device Switcher Floating Bar */}\n        <div className=\"sticky top-0 z-50 px-4 py-2 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs font-semibold text-slate-400\">View Mode:</span>\n            <div className=\"flex items-center bg-slate-800/90 rounded-lg p-0.5 border border-slate-700\">\n              <button\n                onClick={() => onFrameModeChange(\'phone\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Phone Mockup\"\n              >\n                <Smartphone className=\"w-3.5 h-3.5\" />\n                <span>Phone</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'tablet\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors\"\n                title=\"Android Tablet Mockup\"\n              >\n                <Tablet className=\"w-3.5 h-3.5\" />\n                <span>Tablet</span>\n              </button>\n              <button\n                onClick={() => onFrameModeChange(\'responsive\')}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-md bg-blue-600 text-white shadow-sm flex items-center gap-1.5\"\n                title=\"Adaptive Responsive Mode\"\n              >\n                <Monitor className=\"w-3.5 h-3.5\" />\n                <span>Full Responsive</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Quick Notification Dropdown in Responsive Mode */}\n          <div className=\"flex items-center gap-3\">\n            {audioState.currentTrack && (\n              <button\n                onClick={() => setIsNotificationShadeOpen(!isNotificationShadeOpen)}\n                className=\"relative px-3 py-1 rounded-full bg-slate-800 hover:bg-slate-700 border border-slate-700 text-xs text-cyan-300 flex items-center gap-1.5 shadow-sm transition-colors\"\n                title=\"Notifications & Background Audio Controls\"\n              >\n                <Music className=\"w-3.5 h-3.5 text-cyan-400 animate-pulse\" />\n                <span className=\"truncate max-w-[130px] font-medium\">\n                  {audioState.currentTrack.title}\n                </span>\n                <span className=\"text-[10px] text-slate-400\">\302\267</span>\n                <span className=\"text-[10px] text-slate-400\">\n                  {audioState.isPlaying ? \'Playing\' : \'Paused\'}\n                </span>\n                <ChevronDown className=\"w-3 h-3 text-slate-400\" />\n              </button>\n            )}\n\n            <div className=\"hidden sm:flex items-center gap-2 text-xs text-slate-400\">\n              <span>PlayThat! v2.4</span>\n              <span>\302\267</span>\n              <span className=\"text-emerald-400\">Hardware Acceleration Active</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Dropdown Notification Card in Responsive Mode */}\n        {isNotificationShadeOpen && audioState.currentTrack && (\n          <div className=\"fixed top-12 right-4 z-50 w-80 animate-in fade-in slide-in-from-top-2 duration-150\">\n            {renderMediaNotificationCard(false)}\n          </div>\n        )}\n\n        {/* Content body */}\n        <div className=\"flex-1 w-full max-w-7xl mx-auto flex flex-col\">\n          {children}"
