    content: "      videoRef.current.volume = 1.0;\n    }\n  }, [volume]);\n\n  // Brightness filter handling\n  const getFilterStyle = () => {\n    const brightnessVal = brightness / 100;\n    if (decoder === \'HW+\') {\n      // HW+ mode: enhanced contrast & dynamic sharpness\n      return `brightness(${brightnessVal}) contrast(1.15) saturate(1.12)`;\n    } else if (decoder === \'SW\') {\n      // SW mode: softened software filter\n      return `brightness(${brightnessVal}) contrast(0.95)`;\n    }\n    return `brightness(${brightnessVal})`;\n  };\n\n  // Aspect ratio video styling\n  const getVideoObjectFit = (): React.CSSProperties => {\n    switch (aspectRatio) {\n      case \'stretch\':\n        return { objectFit: \'fill\', width: \'100%\', height: \'100%\' };\n      case \'16:9\':\n        return { objectFit: \'contain\', aspectRatio: \'16/9\' };\n      case \'4:3\':\n        return { objectFit: \'contain\', aspectRatio: \'4/3\' };"
