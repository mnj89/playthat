  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { Download, Folder, FolderEdit, X, Check, HardDrive, FileVideo } from \'lucide-react\';\n\nexport interface DownloadPromptData {\n  url: string;\n  defaultTitle: string;\n  type: \'mp4\' | \'m3u8\' | \'webm\';\n}\n\ninterface DownloadPromptModalProps {\n  isOpen: boolean;\n  data: DownloadPromptData | null;\n  onClose: () => void;\n  onConfirm: (confirmed: { title: string; savePath: string; url: string; type: \'mp4\' | \'m3u8\' | \'webm\' }) => void;\n}\n\nconst PRESET_PATHS = [\n  \'/Internal Storage/Download/PlayThat/\',\n  \'/Internal Storage/Movies/\',\n  \'/Internal Storage/Stream Captures/\',\n  \'/Internal Storage/DCIM/Camera/\',\n  \'/SD Card/PlayThat/Downloads/\',\n];\n\nexport const DownloadPromptModal: React.FC<DownloadPromptModalProps> = ({\n  isOpen,\n  data,\n  onClose,\n  onConfirm,\n}) => {\n  const [title, setTitle] = useState<string>(\'\');\n  const [selectedPath, setSelectedPath] = useState<string>(PRESET_PATHS[0]);\n  const [isCustomPath, setIsCustomPath] = useState<boolean>(false);\n  const [customPath, setCustomPath] = useState<string>(\'/Internal Storage/Custom/\');\n\n  useEffect(() => {\n    if (data) {\n      setTitle(data.defaultTitle);\n      setSelectedPath(PRESET_PATHS[0]);\n      setIsCustomPath(false);\n    }\n  }, [data]);\n\n  if (!isOpen || !data) return null;\n\n  const currentPath = isCustomPath ? customPath : selectedPath;\n  const sanitizedTitle = title.trim() || data.defaultTitle;\n  const fullDestination = `${currentPath.replace(/\\/?$/, \'/\')}${sanitizedTitle}`;\n\n  const handleStart = (e: React.FormEvent) => {\n    e.preventDefault();\n    onConfirm({\n      title: sanitizedTitle,\n      savePath: currentPath,\n      url: data.url,\n      type: data.type,\n    });\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\">\n      <div className=\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400\">\n              <Download className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-white leading-tight\">\n                Download Confirmation\n              </h3>\n              <span className=\"text-[10px] text-slate-400 font-mono\">\n                Verify file name & destination before downloading\n              </span>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"p-1.5 rounded-full hover:bg-slate-800 text-slate-400 hover:text-white transition-colors\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Prompt Body */}\n        <form onSubmit={handleStart} className=\"p-6 flex flex-col gap-4\">\n          {/* File Name Field */}\n          <div className=\"flex flex-col gap-1.5\">\n            <label className=\"text-xs font-semibold text-slate-300 flex items-center gap-1.5\">\n              <FileVideo className=\"w-3.5 h-3.5 text-blue-400\" />\n              File Name\n            </label>\n            <input\n              type=\"text\"\n              required\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              className=\"w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs font-medium text-slate-100 focus:outline-none focus:border-blue-500 transition-colors\"\n            />\n          </div>\n\n          {/* Download Path & Folder Selection */}\n          <div className=\"flex flex-col gap-1.5\">\n            <div className=\"flex items-center justify-between\">\n              <label className=\"text-xs font-semibold text-slate-300 flex items-center gap-1.5\">\n                <Folder className=\"w-3.5 h-3.5 text-amber-400\" />\n                Storage Destination Path\n              </label>\n              <button\n                type=\"button\"\n                onClick={() => setIsCustomPath(!isCustomPath)}\n                className=\"text-[11px] text-blue-400 hover:underline flex items-center gap-1 font-medium\"\n              >\n                <FolderEdit className=\"w-3 h-3\" />\n                <span>{isCustomPath ? \'Use Presets\' : \'Custom Path...\'}</span>\n              </button>\n            </div>\n\n            {isCustomPath ? (\n              <input\n                type=\"text\"\n                required\n                value={customPath}\n                onChange={(e) => setCustomPath(e.target.value)}\n                placeholder=\"/Internal Storage/MyFolder/\"\n                className=\"w-full px-3.5 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-cyan-300 focus:outline-none focus:border-blue-500\"\n              />\n            ) : (\n              <select\n                value={selectedPath}\n                onChange={(e) => setSelectedPath(e.target.value)}\n                className=\"w-full px-3 py-2 bg-slate-950 border border-slate-800 rounded-xl text-xs font-mono text-slate-200 focus:outline-none focus:border-blue-500 cursor-pointer\"\n              >\n                {PRESET_PATHS.map((p) => (\n                  <option key={p} value={p}>\n                    {p}\n                  </option>\n                ))}\n              </select>\n            )}\n          </div>\n\n          {/* Destination Path Preview Box */}\n          <div className=\"p-3.5 rounded-2xl bg-slate-950 border border-slate-800 flex flex-col gap-1\">\n            <span className=\"text-[10px] uppercase font-mono text-slate-500\">\n              Target Save Location:\n            </span>\n            <span className=\"text-xs font-mono text-emerald-400 break-all\">\n              {fullDestination}\n            </span>\n            <div className=\"mt-1 pt-1.5 border-t border-slate-900 flex items-center justify-between text-[10px] text-slate-400\">\n              <span>Format: {data.type.toUpperCase()}</span>\n              <span>Cloud Acceleration Ready</span>\n            </div>\n          </div>\n\n          {/* Actions */}\n          <div className=\"flex items-center justify-end gap-2.5 pt-2\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 text-xs font-semibold transition-colors\"\n            >\n              Cancel\n            </button>\n\n            <button\n              type=\"submit\"\n              className=\"px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold flex items-center gap-1.5 shadow-md transition-colors\"\n            >\n              <Download className=\"w-3.5 h-3.5\" />\n              <span>Start Download</span>\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
