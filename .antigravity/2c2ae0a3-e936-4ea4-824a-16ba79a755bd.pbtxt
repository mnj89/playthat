    content: "              {activeTab === \'playlists\' && (\n                <PlaylistManager\n                  playlists={playlists}\n                  mediaItems={mediaList}\n                  onCreatePlaylist={handleCreatePlaylist}\n                  onDeletePlaylist={handleDeletePlaylist}\n                  onPlayMedia={handlePlayMedia}\n                  onRemoveFromPlaylist={handleRemoveFromPlaylist}\n                />\n              )}\n            </main>\n\n            {/* Android Bottom Navigation Bar */}\n            <nav className=\"h-16 px-2 bg-slate-900/95 backdrop-blur-md border-t border-slate-800 grid grid-cols-4 items-center shrink-0 select-none z-30\">\n              <button\n                onClick={() => setActiveTab(\'folders\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'folders\' ? \'text-blue-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <Folder className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Media</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'browser\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'browser\' ? \'text-cyan-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <Globe className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Browser</span>\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'downloads\')}\n                className={`relative flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'downloads\' ? \'text-amber-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <ArrowDownToLine className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Downloads</span>\n                {activeDownloadCount > 0 && (\n                  <span className=\"absolute top-1 right-5 w-2 h-2 rounded-full bg-blue-500 animate-ping\" />\n                )}\n              </button>\n\n              <button\n                onClick={() => setActiveTab(\'playlists\')}\n                className={`flex flex-col items-center justify-center gap-1 transition-colors min-h-[44px] ${\n                  activeTab === \'playlists\' ? \'text-purple-400 font-bold\' : \'text-slate-400 hover:text-slate-200\'\n                }`}\n              >\n                <ListMusic className=\"w-5 h-5\" />\n                <span className=\"text-[10px] tracking-tight\">Playlists</span>\n              </button>\n            </nav>\n          </div>\n        )}\n\n        {/* Subtitle Customizer Modal */}"
