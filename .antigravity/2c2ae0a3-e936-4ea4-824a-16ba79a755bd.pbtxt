  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Folder,\n  Film,\n  Play,\n  Search,\n  Upload,\n  Radio,\n  Lock,\n  Heart,\n  MoreVertical,\n  LayoutGrid,\n  List,\n  Trash2,\n  X,\n  Music,\n} from \'lucide-react\';\nimport { MediaItem } from \'../types\';\n\ninterface FileBrowserProps {\n  mediaItems: MediaItem[];\n  onPlayMedia: (item: MediaItem) => void;\n  onOpenVault: () => void;\n  onImportLocalFile: (file: File) => void;\n  onOpenStreamDialog: () => void;\n  onToggleFavorite: (id: string) => void;\n  onDeleteMedia: (id: string) => void;\n  onAddToVault: (item: MediaItem) => void;\n}\n\nexport const FileBrowser: React.FC<FileBrowserProps> = ({\n  mediaItems,\n  onPlayMedia,\n  onOpenVault,\n  onImportLocalFile,\n  onOpenStreamDialog,\n  onToggleFavorite,\n  onDeleteMedia,\n  onAddToVault,\n}) => {\n  const [selectedFolder, setSelectedFolder] = useState<string>(\'All\');\n  const [mediaTypeFilter, setMediaTypeFilter] = useState<\'all\' | \'video\' | \'audio\'>(\'all\');\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [viewMode, setViewMode] = useState<\'grid\' | \'list\'>(\'grid\');\n  const [sortBy, setSortBy] = useState<\'date\' | \'name\' | \'size\' | \'duration\'>(\'date\');\n  const [activeMenuId, setActiveMenuId] = useState<string | null>(null);\n\n  // Calculate unique folders and counts\n  const folders = Array.from(new Set(mediaItems.map((m) => m.folder))).filter(Boolean);\n\n  // Filter media\n  const filteredMedia = mediaItems\n    .filter((item) => {\n      if (item.isEncrypted) return false;\n      const matchesFolder = selectedFolder === \'All\' || item.folder === selectedFolder;\n      const matchesSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase());\n      const isAudio = item.mediaType === \'audio\' || item.folder === \'Music\';\n      const matchesType =\n        mediaTypeFilter === \'all\' ||\n        (mediaTypeFilter === \'audio\' && isAudio) ||\n        (mediaTypeFilter === \'video\' && !isAudio);\n      return matchesFolder && matchesSearch && matchesType;\n    })\n    .sort((a, b) => {\n      if (sortBy === \'name\') return a.title.localeCompare(b.title);\n      if (sortBy === \'size\') return b.fileSize - a.fileSize;\n      if (sortBy === \'duration\') return b.duration - a.duration;\n      return b.createdAt - a.createdAt;\n    });\n\n  const formatDuration = (seconds: number) => {\n    if (isNaN(seconds)) return \'00:00\';\n    const s = Math.floor(seconds);\n    const mins = Math.floor(s / 60);\n    const secs = s % 60;\n    return `${mins}:${secs < 10 ? \'0\' : \'\'}${secs}`;\n  };\n\n  const formatFileSize = (bytes: number) => {\n    if (!bytes) return \'0 MB\';\n    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;\n  };\n\n  const handleFileInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (file) {\n      onImportLocalFile(file);\n    }\n  };\n\n  return (\n    <div className=\"flex-1 w-full flex flex-col bg-black text-white overflow-hidden\">\n      {/* Top Action Toolbar (Monochrome) */}\n      <div className=\"p-3 bg-zinc-950 border-b border-zinc-850 flex flex-col gap-2.5 shrink-0\">\n        {/* Row 1: Complete Line Search Bar */}\n        <div className=\"relative w-full\">\n          <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400 pointer-events-none\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search media by title...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full h-10 pl-10 pr-9 bg-zinc-900 border border-zinc-800 focus:border-zinc-500 rounded-2xl text-xs text-white placeholder:text-zinc-500 focus:outline-none transition-all\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-full text-zinc-400 hover:text-white hover:bg-zinc-800 transition-colors\"\n              title=\"Clear search\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {/* Row 2: Actions & View Controls Strip */}\n        <div className=\"flex items-center justify-between gap-2\">\n          {/* Quick Import & Stream Actions */}\n          <div className=\"flex items-center gap-1.5\">\n            <label\n              className=\"px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 cursor-pointer transition-colors border border-zinc-800 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Open file from device\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-white\" />\n              <span>Open File</span>\n              <input\n                type=\"file\"\n                accept=\"video/*,audio/*\"\n                onChange={handleFileInputChange}\n                className=\"hidden\"\n              />\n            </label>\n\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-200 transition-colors border border-zinc-800 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-white\" />\n              <span>Stream URL</span>\n            </button>\n          </div>\n\n          {/* Sort Selector & View Mode Toggle */}\n          <div className=\"flex items-center gap-1.5\">\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as any)}\n              className=\"bg-zinc-900 text-zinc-300 text-[11px] font-medium border border-zinc-800 rounded-xl px-2 py-1.5 focus:outline-none focus:border-zinc-600 cursor-pointer\"\n            >\n              <option value=\"date\">Latest</option>\n              <option value=\"name\">Name</option>\n              <option value=\"size\">Size</option>\n              <option value=\"duration\">Duration</option>\n            </select>\n\n            <div className=\"flex items-center bg-zinc-900 rounded-xl p-0.5 border border-zinc-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'grid\' ? \'bg-white text-black font-semibold\' : \'text-zinc-400 hover:text-white\'\n                }`}\n                title=\"Grid View\"\n              >\n                <LayoutGrid className=\"w-3.5 h-3.5\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'list\' ? \'bg-white text-black font-semibold\' : \'text-zinc-400 hover:text-white\'\n                }`}\n                title=\"List View\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {/* Row 3: Media Type Filter Strip: All / Videos / Music */}\n        <div className=\"flex items-center gap-1.5 text-xs\">\n          <button\n            onClick={() => setMediaTypeFilter(\'all\')}\n            className={`px-3 py-1 rounded-xl text-xs font-semibold transition-all ${\n              mediaTypeFilter === \'all\'\n                ? \'bg-white text-black shadow-sm\'\n                : \'bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800\'\n            }`}\n          >\n            All\n          </button>\n          <button\n            onClick={() => setMediaTypeFilter(\'video\')}\n            className={`px-3 py-1 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all ${\n              mediaTypeFilter === \'video\'\n                ? \'bg-white text-black shadow-sm\'\n                : \'bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800\'\n            }`}\n          >\n            <Film className=\"w-3.5 h-3.5\" />\n            <span>Videos</span>\n          </button>\n          <button\n            onClick={() => setMediaTypeFilter(\'audio\')}\n            className={`px-3 py-1 rounded-xl text-xs font-semibold flex items-center gap-1.5 transition-all ${\n              mediaTypeFilter === \'audio\'\n                ? \'bg-white text-black shadow-sm\'\n                : \'bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800\'\n            }`}\n          >\n            <Music className=\"w-3.5 h-3.5\" />\n            <span>Music & Audio</span>\n          </button>\n        </div>\n\n        {/* Row 4: Horizontal Folder Scroller */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-0.5 text-xs\">\n          <button\n            onClick={() => setSelectedFolder(\'All\')}\n            className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors font-medium ${\n              selectedFolder === \'All\'\n                ? \'bg-zinc-800 text-white border border-zinc-700\'\n                : \'bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800\'\n            }`}\n          >\n            All Folders ({mediaItems.filter((m) => !m.isEncrypted).length})\n          </button>\n\n          {folders.map((fName) => {\n            const count = mediaItems.filter((m) => m.folder === fName && !m.isEncrypted).length;\n            return (\n              <button\n                key={fName}\n                onClick={() => setSelectedFolder(fName)}\n                className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-medium ${\n                  selectedFolder === fName\n                    ? \'bg-zinc-800 text-white border border-zinc-700\'\n                    : \'bg-zinc-900 text-zinc-400 hover:text-white border border-zinc-800\'\n                }`}\n              >\n                <Folder className=\"w-3.5 h-3.5 text-zinc-400\" />\n                <span>{fName}</span>\n                <span className=\"text-[10px] text-zinc-500 font-mono\">({count})</span>\n              </button>\n            );\n          })}\n\n          {/* Encrypted Vault Entry Pill */}\n          <button\n            onClick={onOpenVault}\n            className=\"px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-semibold bg-zinc-900 text-zinc-200 border border-zinc-700 hover:bg-zinc-800 hover:text-white\"\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Private Vault</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Video & Audio Grid / List */}\n      <div className=\"flex-1 overflow-y-auto p-4\">\n        {filteredMedia.length === 0 ? (\n          <div className=\"flex-1 flex flex-col items-center justify-center p-12 text-center gap-3 text-zinc-500\">\n            <Film className=\"w-12 h-12 text-zinc-700\" />\n            <span className=\"text-sm font-semibold text-white\">No media files found</span>\n            <span className=\"text-xs text-zinc-400 max-w-xs\">\n              Open a local video or audio file from your device, or stream a link.\n            </span>\n          </div>\n        ) : viewMode === \'grid\' ? (\n          /* Grid View in Monochrome */\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4\">\n            {filteredMedia.map((item) => (\n              <div\n                key={item.id}\n                onClick={() => onPlayMedia(item)}\n                className=\"group relative bg-zinc-950 border border-zinc-850 hover:border-zinc-700 rounded-2xl overflow-hidden shadow-md cursor-pointer transition-all hover:scale-[1.01] flex flex-col\"\n              >\n                {/* Thumbnail Container */}\n                <div className=\"relative aspect-video w-full bg-black overflow-hidden\">\n                  <img\n                    src={item.thumbnailUrl}\n                    alt={item.title}\n                    referrerPolicy=\"no-referrer\"\n                    className=\"w-full h-full object-cover filter grayscale contrast-125 group-hover:scale-105 transition-transform duration-300\"\n                  />\n                  <div className=\"absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20\" />\n\n                  {/* Play Overlay */}\n                  <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <div className=\"w-12 h-12 rounded-full bg-white text-black flex items-center justify-center shadow-2xl transform group-hover:scale-110 transition-transform\">\n                      <Play className=\"w-5 h-5 fill-black translate-x-0.5\" />\n                    </div>\n                  </div>\n\n                  {/* Duration Pill */}\n                  <div className=\"absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md bg-black/80 border border-zinc-800 text-[10px] font-mono font-bold text-white tracking-wide\">\n                    {formatDuration(item.duration)}\n                  </div>\n\n                  {/* Resolution & Decoder Badges */}\n                  <div className=\"absolute top-2 left-2 flex items-center gap-1\">\n                    {item.mediaType === \'audio\' || item.folder === \'Music\' ? (\n                      <span className=\"px-1.5 py-0.5 rounded bg-zinc-900/90 border border-zinc-700 text-[9px] font-mono font-bold text-white flex items-center gap-1\">\n                        <Music className=\"w-2.5 h-2.5\" />\n                        <span>AUDIO</span>\n                      </span>\n                    ) : (\n                      <span className=\"px-1.5 py-0.5 rounded bg-zinc-900/90 border border-zinc-700 text-[9px] font-mono font-bold text-zinc-200\">\n                        {item.resolution}\n                      </span>\n                    )}\n                    <span className=\"px-1 py-0.5 rounded bg-black/80 border border-zinc-800 text-[9px] font-mono text-zinc-400\">\n                      {item.decoder}\n                    </span>\n                  </div>\n\n                  {/* Favorite indicator */}\n                  {item.isFavorite && (\n                    <div className=\"absolute top-2 right-2 p-1 rounded-full bg-black/70 text-white\">\n                      <Heart className=\"w-3.5 h-3.5 fill-white\" />\n                    </div>\n                  )}\n\n                  {/* Watch progress bar */}\n                  {item.currentTime > 0 && item.duration > 0 && (\n                    <div className=\"absolute bottom-0 left-0 right-0 h-1 bg-zinc-800\">\n                      <div\n                        className=\"h-full bg-white\"\n                        style={{ width: `${(item.currentTime / item.duration) * 100}%` }}\n                      />\n                    </div>\n                  )}\n                </div>\n\n                {/* Details Footer */}\n                <div className=\"p-3 flex items-start justify-between gap-2\">\n                  <div className=\"flex flex-col min-w-0\">\n                    <span className=\"text-xs font-bold text-white truncate group-hover:text-zinc-300 transition-colors\">\n                      {item.title}\n                    </span>\n                    <div className=\"flex items-center gap-2 text-[10px] text-zinc-400 font-mono mt-0.5\">\n                      <span>{item.artist || item.codec}</span>\n                      <span>\302\267</span>\n                      <span>{formatFileSize(item.fileSize)}</span>\n                    </div>\n                  </div>\n\n                  {/* Card Actions Menu */}\n                  <div className=\"relative\">\n                    <button\n                      onClick={(e) => {\n                        e.stopPropagation();\n                        setActiveMenuId(activeMenuId === item.id ? null : item.id);\n                      }}\n                      className=\"p-1 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white\"\n                    >\n                      <MoreVertical className=\"w-4 h-4\" />\n                    </button>\n\n                    {activeMenuId === item.id && (\n                      <div\n                        onClick={(e) => e.stopPropagation()}\n                        className=\"absolute right-0 bottom-full mb-1 z-30 bg-zinc-900 border border-zinc-700 rounded-xl p-1.5 shadow-xl w-44 flex flex-col gap-1 text-xs text-zinc-200\"\n                      >\n                        <button\n                          onClick={() => {\n                            onToggleFavorite(item.id);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-zinc-800 text-left flex items-center gap-2\"\n                        >\n                          <Heart className=\"w-3.5 h-3.5\" />\n                          <span>{item.isFavorite ? \'Remove Favorite\' : \'Add to Favorite\'}</span>\n                        </button>\n                        <button\n                          onClick={() => {\n                            onAddToVault(item);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-zinc-800 text-left flex items-center gap-2 text-zinc-300\"\n                        >\n                          <Lock className=\"w-3.5 h-3.5\" />\n                          <span>Move to Private Vault</span>\n                        </button>\n                        <button\n                          onClick={() => {\n                            onDeleteMedia(item.id);\n                            setActiveMenuId(null);\n                          }}\n                          className=\"px-2.5 py-1.5 rounded-lg hover:bg-zinc-800 text-left flex items-center gap-2 text-zinc-400 hover:text-white\"\n                        >\n                          <Trash2 className=\"w-3.5 h-3.5\" />\n                          <span>Delete</span>\n                        </button>\n                      </div>\n                    )}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        ) : (\n          /* List View in Monochrome */\n          <div className=\"flex flex-col gap-2\">\n            {filteredMedia.map((item) => (\n              <div\n                key={item.id}\n                onClick={() => onPlayMedia(item)}\n                className=\"group p-2.5 rounded-2xl bg-zinc-950 border border-zinc-850 hover:border-zinc-700 flex items-center justify-between gap-3 cursor-pointer transition-all hover:bg-zinc-900\"\n              >\n                <div className=\"flex items-center gap-3 min-w-0\">\n                  <div className=\"relative w-20 h-12 rounded-xl bg-black overflow-hidden shrink-0 border border-zinc-800\">\n                    <img\n                      src={item.thumbnailUrl}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-full h-full object-cover filter grayscale contrast-125\"\n                    />\n                    <div className=\"absolute bottom-1 right-1 px-1 py-0.2 bg-black/80 rounded text-[9px] font-mono text-white\">\n                      {formatDuration(item.duration)}\n                    </div>\n                  </div>\n                  <div className=\"flex flex-col min-w-0\">\n                    <span className=\"text-xs font-semibold text-white truncate group-hover:text-zinc-300 transition-colors\">\n                      {item.title}\n                    </span>\n                    <span className=\"text-[10px] font-mono text-zinc-400\">\n                      {item.artist || item.folder} \302\267 {item.resolution} \302\267 {formatFileSize(item.fileSize)}\n                    </span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={(e) => {\n                      e.stopPropagation();\n                      onPlayMedia(item);\n                    }}\n                    className=\"w-8 h-8 rounded-full bg-white text-black flex items-center justify-center hover:bg-zinc-200\"\n                  >\n                    <Play className=\"w-3.5 h-3.5 fill-black ml-0.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
