xt-zinc-400\" />\n                <span>{fName}</span>\n                <span className=\"text-[10px] text-zinc-500 font-mono\">({count})</span>\n              </button>\n            );\n          })}\n\n          {/* Encrypted Vault Entry Pill */}\n          <button\n            onClick={onOpenVault}\n            className=\"px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors flex items-center gap-1.5 font-semibold bg-zinc-900 text-zinc-200 border border-zinc-700 hover:bg-zinc-800 hover:text-white\"\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Private Vault</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Main Video & Audio Grid / List */}\n      <div className=\"flex-1 overflow-y-auto p-4\">"
