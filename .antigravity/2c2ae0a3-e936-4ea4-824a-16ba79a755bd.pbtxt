    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className={isDarkMode ? \'dark\' : \'\'}>\n      <AndroidFrame\n        frameMode={frameMode}\n        onFrameModeChange={setFrameMode}\n        isPlayerActive={!!activePlayingMedia}\n      >\n        {activePlayingMedia ? (\n          /* Full MX Player Mode */\n          <MXPlayer\n            media={activePlayingMedia}\n            onBack={() => setActivePlayingMedia(null)}\n            subtitleSettings={subtitleSettings}\n            onOpenSubtitleSettings={() => setIsSubtitleModalOpen(true)}\n            activeSubtitleTrack={activeSubtitleTrack}\n            onSelectSubtitleTrack={setActiveSubtitleTrack}\n            availableSubtitleTracks={availableSubtitleTracks}\n          />\n        ) : (\n          /* Main Application Shell */\n          <div className=\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden\">\n            {/* Top Bar Contract (Wordmark - Navigation - Actions) */}\n            <header className=\"h-14 px-4 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between gap-4 shrink-0 select-none\">\n              {/* Brand Wordmark & Icon */}\n              <div className=\"flex items-center gap-2.5\">\n                <PlayThatIcon size={32} />\n                <div className=\"flex items-baseline gap-1.5\">\n                  <span className=\"text-base font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent\">\n                    PlayThat!\n                  </span>\n                  <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-blue-950 text-blue-300 border border-blue-800/80 font-bold\">\n                    PRO\n                  </span>\n                </div>\n              </div>\n\n              {/* Right Zone Actions */}\n              <div className=\"flex items-center gap-2\">\n                {/* Active Download Badge Trigger */}\n                <button\n                  onClick={() => setActiveTab(\'downloads\')}\n                  className=\"relative p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors border border-slate-700/60\"\n                  title=\"PlayThat! Download Manager\"\n                >\n                  <ArrowDownToLine className=\"w-4 h-4\" />\n                  {activeDownloadCount > 0 && (\n                    <span className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-blue-500 text-[9px] font-bold text-white flex items-center justify-center animate-pulse\">\n                      {activeDownloadCount}\n                    </span>\n                  )}\n                </button>\n\n                {/* Encrypted Vault Trigger */}\n                <button\n                  onClick={() => setIsVaultModalOpen(true)}\n                  className=\"p-2 rounded-xl bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-400 transition-colors border border-emerald-800/60\"\n                  title=\"Open Private Vault\"\n                >\n                  <Lock className=\"w-4 h-4\" />\n                </button>\n\n                {/* Dark / Light Toggle */}\n                <button\n                  onClick={() => setIsDarkMode(!isDarkMode)}\n                  className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Toggle Dark/Light Mode\"\n                >\n                  {isDarkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </header>"
        replacement_content: "  return (\n    <div className={`${isDarkMode ? \'dark\' : \'\'} font-scale-${enhancementConfig.fontScale}`}>\n      <AndroidFrame\n        frameMode={frameMode}\n        onFrameModeChange={setFrameMode}\n        isPlayerActive={!!activePlayingMedia}\n      >\n        {activePlayingMedia ? (\n          /* Full MX Player Mode */\n          <MXPlayer\n            media={activePlayingMedia}\n            onBack={() => setActivePlayingMedia(null)}\n            subtitleSettings={subtitleSettings}\n            onOpenSubtitleSettings={() => setIsSubtitleModalOpen(true)}\n            activeSubtitleTrack={activeSubtitleTrack}\n            onSelectSubtitleTrack={setActiveSubtitleTrack}\n            availableSubtitleTracks={availableSubtitleTracks}\n            enhancementConfig={enhancementConfig}\n            onUpdateEnhancements={setEnhancementConfig}\n          />\n        ) : (\n          /* Main Application Shell */\n          <div className=\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden\">\n            {/* Top Bar Contract (Wordmark - Navigation - Actions) */}\n            <header className=\"h-14 px-4 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 flex items-center justify-between gap-4 shrink-0 select-none\">\n              {/* Brand Wordmark & Icon */}\n              <div className=\"flex items-center gap-2.5\">\n                <PlayThatIcon size={32} />\n                <div className=\"flex items-baseline gap-1.5\">\n                  <span className=\"text-base font-extrabold tracking-tight bg-gradient-to-r from-cyan-400 via-blue-400 to-indigo-400 bg-clip-text text-transparent\">\n                    PlayThat!\n                  </span>\n                  <span className=\"text-[10px] font-mono px-1.5 py-0.2 rounded bg-blue-950 text-blue-300 border border-blue-800/80 font-bold\">\n                    PRO\n                  </span>\n                </div>\n              </div>\n\n              {/* Right Zone Actions */}\n              <div className=\"flex items-center gap-2\">\n                {/* Active Download Badge Trigger */}\n                <button\n                  onClick={() => setActiveTab(\'downloads\')}\n                  className=\"relative p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors border border-slate-700/60\"\n                  title=\"PlayThat! Download Manager\"\n                >\n                  <ArrowDownToLine className=\"w-4 h-4\" />\n                  {activeDownloadCount > 0 && (\n                    <span className=\"absolute -top-1 -right-1 w-4 h-4 rounded-full bg-blue-500 text-[9px] font-bold text-white flex items-center justify-center animate-pulse\">\n                      {activeDownloadCount}\n                    </span>\n                  )}\n                </button>\n\n                {/* Audio & Video Enhancements & Font Scaling Studio */}\n                <button\n                  onClick={() => setIsEnhancementsModalOpen(true)}\n                  className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-cyan-400 hover:text-white transition-colors border border-slate-700/60\"\n                  title=\"Audio & Video Enhancements & System Font Size\"\n                >\n                  <Sparkles className=\"w-4 h-4\" />\n                </button>\n\n                {/* Encrypted Vault Trigger */}\n                <button\n                  onClick={() => setIsVaultModalOpen(true)}\n                  className=\"p-2 rounded-xl bg-emerald-950/60 hover:bg-emerald-900/60 text-emerald-400 transition-colors border border-emerald-800/60\"\n                  title=\"Open Private Vault\"\n                >\n                  <Lock className=\"w-4 h-4\" />\n                </button>\n\n                {/* Dark / Light Toggle */}\n                <button\n                  onClick={() => setIsDarkMode(!isDarkMode)}\n                  className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white transition-colors\"\n                  title=\"Toggle Dark/Light Mode\"\n                >\n                  {isDarkMode ? <Sun className=\"w-4 h-4 text-amber-400\" /> : <Moon className=\"w-4 h-4\" />}\n                </button>\n              </div>\n            </header>"
        start_line: 257
        end_line: 328
      }
