        target_content: "              {/* Subtitles Button */}\n              <button\n                onClick={onOpenSubtitleSettings}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Subtitle Customization\"\n              >\n                <Subtitles className=\"w-5 h-5\" />\n              </button>\n\n              {/* Settings Dropdown Toggle */}\n              <button\n                onClick={() => setShowSettingsMenu(!showSettingsMenu)}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Playback Settings\"\n              >\n                <Settings className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Settings Menu Modal */}\n          {showSettingsMenu && (\n            <div className=\"absolute top-16 right-4 z-50 bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl p-4 shadow-2xl w-64 text-slate-200 flex flex-col gap-3\">\n              <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Playback Settings\n              </div>"
        replacement_content: "              {/* Subtitles Button */}\n              <button\n                onClick={onOpenSubtitleSettings}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Subtitle Customization\"\n              >\n                <Subtitles className=\"w-5 h-5\" />\n              </button>\n\n              {/* Audio & Video Enhancements Button */}\n              <button\n                onClick={() => setIsEnhancementsModalOpen(true)}\n                className=\"p-2 rounded-full hover:bg-white/20 text-cyan-300 hover:text-white transition-colors\"\n                title=\"Audio & Video Enhancement Studio\"\n              >\n                <Sparkles className=\"w-5 h-5\" />\n              </button>\n\n              {/* Settings Dropdown Toggle */}\n              <button\n                onClick={() => setShowSettingsMenu(!showSettingsMenu)}\n                className=\"p-2 rounded-full hover:bg-white/20 text-slate-200 hover:text-white transition-colors\"\n                title=\"Playback Settings\"\n              >\n                <Settings className=\"w-5 h-5\" />\n              </button>\n            </div>\n          </div>\n\n          {/* Settings Menu Modal */}\n          {showSettingsMenu && (\n            <div className=\"absolute top-16 right-4 z-50 bg-slate-900/95 backdrop-blur-xl border border-slate-700/80 rounded-2xl p-4 shadow-2xl w-68 text-slate-200 flex flex-col gap-3\">\n              <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Playback Settings\n              </div>\n\n              {/* A/V Enhancements Studio Button */}\n              <button\n                onClick={() => {\n                  setIsEnhancementsModalOpen(true);\n                  setShowSettingsMenu(false);\n                }}\n                className=\"w-full py-2 px-3 rounded-xl bg-cyan-950/70 hover:bg-cyan-900/70 text-xs font-bold flex items-center justify-between text-cyan-300 border border-cyan-800/60 transition-colors shadow-sm\"\n              >\n                <div className=\"flex items-center gap-2\">\n                  <Sparkles className=\"w-4 h-4 text-cyan-400\" />\n                  <span>A/V Enhancements</span>\n                </div>\n                <span className=\"text-[10px] font-mono text-cyan-300 font-bold\">HW+ & Boost</span>\n              </button>"
        start_line: 572
