ute bottom-1 right-1 px-1 py-0.2 bg-black/80 rounded text-[9px] font-mono text-white\\\">\\n                      {formatDuration(item.duration)}\\n                    </div>\\n                  </div>\\n                  <div className=\\\"flex flex-col min-w-0\\\">\\n                    <span className=\\\"text-xs font-semibold text-white truncate group-hover:text-orange-400 transition-colors\\\">\\n                      {item.title}\\n                    </span>\\n                    <span className=\\\"text-[10px] font-mono text-zinc-400\\\">\\n                      {item.artist || item.folder} \302\267 {item.resolution} \302\267 {formatFileSize(item.fileSize)}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-1.5\\\">\\n                  <button\\n                    onClick={(e) => {\\n                      e.stopPropagation();\\n                      onPlayMedia(item);\\n                    }}\\n                    className=\\\"w-8 h-8 rounded-full bg-orange-500 hover:bg-orange-400 text-black flex items-center justify-center shadow-md shadow-orange-500/20 transition-transform active:scale-95\\\"\\n                    title=\\\"Play Media\\\"\\n                  >\\n                    <Play className=\\\"w-3.5 h-3.5 fill-black ml-0.5\\\" />\\n                  </button>\\n                  <button\\n                    onClick={(e) => {\\n                      e.stopPropagation();\\n                      setSelectedActionMedia(item);\\n                    }}\\n                    className=\\\"p-2 rounded-lg hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors\\\"\\n                    title=\\\"More Options\\\"\\n                  >\\n                    <MoreVertical className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/*