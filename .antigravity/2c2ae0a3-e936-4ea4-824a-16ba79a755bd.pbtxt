            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    if (!touchStartRef.current || isLocked) return;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
