    start_line: 239
    end_line: 284
    content: "                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, nightMode: !config.nightMode })}\n                  className={`w-11 h-6 rounded-full transition-colors p-0.5 ${\n                    config.nightMode ? \'bg-amber-500\' : \'bg-slate-800\'\n                  }`}\n                >\n                  <div\n                    className={`w-5 h-5 rounded-full bg-white transition-transform ${\n                      config.nightMode ? \'translate-x-5\' : \'translate-x-0\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </>\n          ) : (\n            /* AUDIO ENHANCEMENTS */\n            <>\n              {/* MX Extra Volume Boost (100% to 200%) */}\n              <div className=\"p-4 rounded-2xl bg-gradient-to-r from-blue-950/40 via-slate-950 to-cyan-950/40 border border-blue-500/30 flex flex-col gap-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2 text-xs font-bold text-white\">\n                    <Zap className=\"w-4 h-4 text-cyan-400\" />\n                    <span>MX Sound Amplification (Boost)</span>\n                  </div>\n                  <span className=\"text-sm font-mono font-bold text-cyan-300\">\n                    {config.volumeBoost}%\n                  </span>\n                </div>\n                <input\n                  type=\"range\"\n                  min={100}\n                  max={200}\n                  value={config.volumeBoost}\n                  onChange={(e) =>\n                    onChange({ ...config, volumeBoost: parseInt(e.target.value, 10) })\n                  }\n                  className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n                />\n                <span className=\"text-[10px] text-slate-400\">\n                  Boosts quiet audio tracks and movies up to 200% with soft limiter clipping protection.\n                </span>\n              </div>\n"
    num_lines: 429
    num_bytes: 18398
    line_range_bytes: 2078
  }
}
