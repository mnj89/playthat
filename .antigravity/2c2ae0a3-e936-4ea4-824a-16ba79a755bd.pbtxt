            lines {
              text: "## 1. Overview & Core Concept"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "**PlayThat!** recreates the beloved Android MX Player experience within a modern web technology stack, bridging high-fidelity mobile ergonomics with real media capabilities:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Touch & Gesture Media Player**: Left-edge vertical swipe for screen brightness adjustment, right-edge vertical swipe for audio volume adjustment with boost, horizontal swipe for precision time seeking with time delta and thumbnail preview, double-tap to play/pause or fast-forward (+10s / -10s), pinch-to-zoom and aspect ratio toggling (Original, Fit, Stretch, 16:9, 4:3, Crop)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Decoding Engines**: Switchable decoder modes (`HW`, `HW+`, `SW`) supporting standard video codecs, WebGL shader color correction / sharpening (simulating hardware post-processing), and audio enhancement."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Advanced Subtitle Engine**: Load external `.srt`, `.vtt`, or embedded subtitle tracks with real-time customization of font family, font size, text color, outline, background opacity, vertical position alignment, and subtitle sync delay (-5.0s to +5.0s)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **In-App Browser & M3U8-to-MP4 Converter**: Chromium-style navigation bar, bookmarks, and simulated mobile web engine with an automated stream sniffer. When an HLS `.m3u8` stream or direct media URL is detected, users get an immediate download badge to pull segments, merge chunks into an MP4 blob, and save it directly to the media library."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Encrypted Private Vault**: Dedicated \"Private Folder\" where sensitive video and audio files are encrypted with user-derived keys (PBKDF2 + AES-GCM 256-bit). Files are not accessible or inspectable without the correct PIN/Pattern, and an Emergency Disguise button instantly replaces the screen with an innocent utility app."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Media File Manager & Playlists**: Folder tree browsing, video thumbnail previews, duration and resolution tags, favorite bookmarks, custom playlists, recent watch history with resume playback timestamps, and local network streaming (HTTP/HLS/DASH/MP4 stream URLs)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "---"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
