  code_action {
    action_spec {
      command {
        instruction: "Remove grayscale filters from album art, style soundwave bars, scrub bar, play button, shuffle/loop and volume in orange"
        is_edit: true
        file {
          absolute_uri: "file:///src/components/MusicPlayerModal.tsx"
