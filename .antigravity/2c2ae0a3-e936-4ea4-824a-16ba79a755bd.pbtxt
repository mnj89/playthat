  view_file {
    absolute_path_uri: "file:///src/components/PrivateVaultModal.tsx"
    start_line: 99
    end_line: 219
    content: "    const valid = await verifyVaultPIN(enteredPin);\n    if (valid) {\n      setIsUnlocked(true);\n      setCurrentPin(enteredPin);\n      setPinInput(\'\');\n      setErrorMessage(null);\n      await loadVaultItems();\n    } else {\n      setErrorMessage(\'Incorrect PIN. Please try again.\');\n      setPinInput(\'\');\n    }\n  };\n\n  const handleSetupPin = async () => {\n    if (pinInput.length < 4) {\n      setErrorMessage(\'PIN must be at least 4 digits\');\n      return;\n    }\n\n    if (!confirmPinInput) {\n      setConfirmPinInput(pinInput);\n      setPinInput(\'\');\n      return;\n    }\n\n    if (pinInput !== confirmPinInput) {\n      setErrorMessage(\'PINs do not match. Please start over.\');\n      setConfirmPinInput(\'\');\n      setPinInput(\'\');\n      return;\n    }\n\n    // Set PIN\n    await setVaultPIN(pinInput);\n    setIsConfigured(true);\n    setIsSettingUp(false);\n    setIsUnlocked(true);\n    setCurrentPin(pinInput);\n    setPinInput(\'\');\n    setConfirmPinInput(\'\');\n    await loadVaultItems();\n  };\n\n  // Calculator disguise logic\n  const handleCalcButton = (val: string) => {\n    // Secret unlock shortcut in calculator: type PIN and press \'=\'\n    if (val === \'=\') {\n      try {\n        if (calcDisplay === currentPin && currentPin) {\n          setIsDisguised(false);\n          setIsUnlocked(true);\n          return;\n        }\n        const sanitized = calcDisplay.replace(/\303\227/g, \'*\').replace(/\303\267/g, \'/\');\n        // eslint-disable-next-line no-eval\n        const result = eval(sanitized);\n        setCalcHistory(calcDisplay + \' =\');\n        setCalcDisplay(String(result));\n      } catch {\n        setCalcDisplay(\'Error\');\n      }\n      return;\n    }\n\n    if (val === \'C\') {\n      setCalcDisplay(\'0\');\n      setCalcHistory(\'\');\n      return;\n    }\n\n    if (calcDisplay === \'0\' && !isNaN(Number(val))) {\n      setCalcDisplay(val);\n    } else {\n      setCalcDisplay((prev) => prev + val);\n    }\n  };\n\n  // Import existing media item to encrypted vault\n  const handleAddExistingToVault = async (item: MediaItem) => {\n    setIsImporting(true);\n    try {\n      const response = await fetch(item.url);\n      const blob = await response.blob();\n      const arrayBuffer = await blob.arrayBuffer();\n\n      await encryptAndSaveMedia(item.id, currentPin, arrayBuffer, {\n        title: item.title,\n        duration: item.duration,\n        fileSize: item.fileSize,\n        resolution: item.resolution,\n        codec: item.codec,\n        thumbnailUrl: item.thumbnailUrl,\n        mimeType: \'video/mp4\',\n      });\n\n      await loadVaultItems();\n      setIsImporting(false);\n    } catch (err) {\n      console.error(\'Failed to encrypt video into vault:\', err);\n      setIsImporting(false);\n    }\n  };\n\n  // Decrypt and play item from vault\n  const handlePlayVaultItem = async (itemId: string, title: string) => {\n    const res = await decryptVaultMedia(itemId, currentPin);\n    if (res && res.blobUrl) {\n      const mediaItem: MediaItem = {\n        id: itemId,\n        title: `[Private] ${title}`,\n        folder: \'Private Vault\',\n        sourceType: \'local\',\n        url: res.blobUrl,\n        thumbnailUrl:\n          res.metadata.thumbnailUrl ||\n          \'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=600&q=80\',\n        duration: res.metadata.duration || 120,\n        currentTime: 0,\n        resolution: res.metadata.resolution || \'1080p FHD\',\n        fileSize: res.metadata.fileSize || 50000000,\n        codec: res.metadata.codec || \'AES-256-GCM\',"
    num_lines: 556
    num_bytes: 20080
    line_range_bytes: 3462
  }
}
