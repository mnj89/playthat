  view_file {
    absolute_path_uri: "file:///src/components/InAppBrowser.tsx"
    start_line: 199
    end_line: 299
    content: "    });\n    setIsPromptOpen(true);\n  };\n\n  const handleConfirmDownloadPrompt = ({\n    title,\n    savePath,\n    url,\n  }: {\n    title: string;\n    savePath: string;\n    url: string;\n  }) => {\n    startDownloadAndConvert(url, title, savePath);\n  };\n\n  const startDownloadAndConvert = async (\n    streamUrl: string,\n    streamLabel: string,\n    savePath: string = \'/Internal Storage/Stream Captures/\'\n  ) => {\n    const controller = new AbortController();\n    setAbortController(controller);\n    setCompletedItem(null);\n\n    // Register with Download Manager\n    downloadManager.addDownload(streamUrl, streamLabel, savePath);\n\n    try {\n      const res = await downloadM3U8Stream(\n        streamUrl,\n        streamLabel,\n        (task) => {\n          task.savePath = savePath;\n          setActiveDownloadTask(task);\n        },\n        controller.signal\n      );\n\n      const folderName = savePath.split(\'/\').filter(Boolean).pop() || \'Stream Captures\';\n\n      const newItem: MediaItem = {\n        id: `m3u8-dl-${Date.now()}`,\n        title: streamLabel || \'Converted HLS Stream\',\n        folder: folderName,\n        sourceType: \'downloaded\',\n        url: res.blobUrl,\n        thumbnailUrl: \'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\',\n        duration: res.duration || 60,\n        currentTime: 0,\n        resolution: \'1080p Remuxed\',\n        fileSize: res.size,\n        codec: \'MP4 / H.264 AAC\',\n        decoder: \'HW\',\n        createdAt: Date.now(),\n        isFavorite: false,\n        isEncrypted: false,\n      };\n\n      setCompletedItem(newItem);\n      onSaveToLibrary(newItem);\n    } catch (err: any) {\n      console.error(\'Download error:\', err);\n    }\n  };\n\n  const cancelDownload = () => {\n    if (abortController) {\n      abortController.abort();\n      setAbortController(null);\n    }\n    setActiveDownloadTask(null);\n  };\n\n  return (\n    <div className=\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden relative\">\n      {/* Tab Limit Alert Toast */}\n      {tabLimitAlert && (\n        <div className=\"absolute top-16 left-1/2 -translate-x-1/2 z-50 px-4 py-2 bg-red-900 text-white rounded-full text-xs font-semibold shadow-xl border border-red-700 animate-in fade-in duration-200\">\n          {tabLimitAlert}\n        </div>\n      )}\n\n      {/* Chromium Desktop/Tablet Horizontal Tab Strip */}\n      <div className=\"bg-slate-950 px-2 pt-2 border-b border-slate-800 flex items-center justify-between gap-2 shrink-0 select-none\">\n        <div className=\"flex items-center gap-1 overflow-x-auto flex-1 pb-1 scrollbar-none\">\n          {tabs.map((tab) => {\n            const isActive = tab.id === activeTabId;\n            return (\n              <div\n                key={tab.id}\n                onClick={() => handleSwitchTab(tab.id)}\n                className={`group max-w-[170px] min-w-[100px] h-9 px-3 rounded-t-xl text-xs flex items-center justify-between gap-1.5 cursor-pointer transition-all border-t border-x shrink-0 ${\n                  isActive\n                    ? \'bg-slate-900 text-white border-slate-700 font-bold shadow-sm\'\n                    : \'bg-slate-950/70 text-slate-400 hover:text-slate-200 border-transparent hover:bg-slate-900/40\'\n                }`}\n              >\n                <div className=\"flex items-center gap-1.5 min-w-0\">\n                  <Globe className={`w-3.5 h-3.5 shrink-0 ${isActive ? \'text-blue-400\' : \'text-slate-500\'}`} />\n                  <span className=\"truncate\">{tab.title}</span>"
    num_lines: 731
