 className=\\\"flex items-center gap-1.5 overflow-x-auto pb-0.5 text-xs\\\">\\n          <button\\n            onClick={() => setSelectedFolder(\'All\')}\\n            className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors font-medium ${\\n              selectedFolder === \'All\'\\n                ? \'bg-slate-700 text-white shadow-sm\'\\n                : \'bg-slate-800/80 text-slate-400 hover:text-white\'\\n            }`}\\n          >\\n            All Folders ({mediaItems.filter((m) => !m.isEncrypted).length})\\n          </button>\", \"StartLine\":186, \"TargetContent\":\"        {/* Horizontal Folder Scroller (MX Player style) */}\\n        <div className=\\\"flex items-center gap-1.5 overflow-x-auto pb-0.5 text-xs\\\">\\n          <button\\n            onClick={() => setSelectedFolder(\'All\')}\\n            className={`px-3 py-1 rounded-xl whitespace-nowrap shrink-0 transition-colors font-medium ${\\n              selectedFolder === \'All\'\\n                ? \'bg-blue-600 text-white shadow-sm\'\\n                : \'bg-slate-800/80 text-slate-400 hover:text-white\'\\n            }`}\\n          >\\n            All Videos ({mediaItems.filter((m) => !m.isEncrypted).length})\\n          </button>\", \"TargetFile\":\"/src/components/FileBrowser.tsx\", \"toolAction\":\"Updating FileBrowser filter strip\", \"toolSummary\":\"Add media type filter to FileBrowser\"}"
