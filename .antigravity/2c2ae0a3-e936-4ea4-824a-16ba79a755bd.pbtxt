      thinking_signature: "\022\203\f\n\200\f\001i\024}\023\343>\2604ud\235p\266\370\024z\330\004\005\267\203\037\300\251\032\021\2052\222\260V\226P\fK\265\256\343\306\336\351\364=\3658\nj\267\021\033r\320\354F\264\342\357\344\245\343\370\0323r1\035\243~\366\245\245\265gO\371;\200\342\237\367\323\223\251\313eT/F\2560\307\340\347I\361+\243\332-@M\302%/a\356\300\t\274\036T0.\b\035\326\310\215\262\026\177\244\"Q*\263\336\016E\000\034\002\003\002\\\2458\"I\263a\265\335|\304\317\300\221\375\355g\306\021h|\030!fd\316^\337\267\325\020|\374\206l\366%u]\230H\235\006d\025R\313\t\022\325\323-g\225\373v=wS\231\275s\237O\377=H\234.\302\302S+b\222\252\r\354fh\2050\347\245mb\t\'\r\274\017\245Y\257\351\225\244N{\020\341\242W\223\022\362\314\241\272\323z.u#u\353\235\240\026\266\252\267\325pc\310\351\300\313\367tG\214\260{[\036\35726\264\350\316\227\247\343\325\254\366\240B)\334\250\305o\322,\242\\\026\277\331\003\177\275\330\235Z\2649R\006\022>\375xC4%t\266\276\0051\032\250\303\255\003R\316|\346M\305\315\222\224\240\315\374@P.\204\307u\367\b\322\360\214\203\035\\\241\310N\366;e\364\321\360 \261\347\002\033\335\326\272\377\226\267\375\362 \366S/[\377v\222\032h\n\252V\250B\220\202[\033\250\240\247\276\305t\035\336+\312r\302u\264\274\277\241\243\240\253\233\272\265~\250d\314\255\276\305\203\210\005\235\030#\334\227\200.{|g\354>j\016\020J\223\003\017\313\246\305\252t\206\020\353\3639\bc\374\310\357\371l*\322\363\206\002\335k\206:\036\371c\263\260\321\213\r\376\241\310\034u\201\362\311?\024\277p@\034\260\005oq2\242\212z^\253FE\231\245\306$\364\315\177\204\263\r\212\005\334\331\330Y\347\337Qn\236L\327@\314\033H\251Q\364\'\303\307\240\242\263\346\271!\023~\335\302\332\023\342^\342\021\224\311\0244\371\224\232o0\374q*$\345\333\304HgC\306H\252\324\210@\322f\036\n\276$=*\025P\314\211\202\314\302\346\333\334\3260\371~Cp>\2468\a.\347\325\000\307C\277\220!f\207\373\3778\344vv\037\331k\275\a\246;\r\2604gS\260\205\317\351\340_\217xF\221\301)\f\2012\251:zJc\277\216\257\371-\306\352\344D\321^\035\31