        target_content: "                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, nightMode: !config.nightMode })}\n                  className={`w-11 h-6 rounded-full transition-colors p-0.5 ${\n                    config.nightMode ? \'bg-amber-500\' : \'bg-slate-800\'\n                  }`}\n                >\n                  <div\n                    className={`w-5 h-5 rounded-full bg-white transition-transform ${\n                      config.nightMode ? \'translate-x-5\' : \'translate-x-0\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </>"
        replacement_content: "                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, nightMode: !config.nightMode })}\n                  className={`w-11 h-6 rounded-full transition-colors p-0.5 ${\n                    config.nightMode ? \'bg-amber-500\' : \'bg-slate-800\'\n                  }`}\n                >\n                  <div\n                    className={`w-5 h-5 rounded-full bg-white transition-transform ${\n                      config.nightMode ? \'translate-x-5\' : \'translate-x-0\'\n                    }`}\n                  />\n                </button>\n              </div>\n\n              {/* System Typography & Adaptive Font Size */}\n              <div className=\"flex flex-col gap-2 p-3 rounded-2xl bg-slate-950 border border-slate-800\">\n                <div className=\"flex items-center justify-between text-xs font-medium text-slate-300\">\n                  <span className=\"flex items-center gap-1.5 font-bold text-white\">\n                    <Sliders className=\"w-3.5 h-3.5 text-cyan-400\" />\n                    System Adaptive Font Size\n                  </span>\n                  <span className=\"font-mono text-cyan-400 font-bold capitalize\">{config.fontScale}</span>\n                </div>\n                <div className=\"grid grid-cols-3 gap-2\">\n                  {[\n                    { id: \'standard\', label: \'Standard\', desc: \'Default scale\' },\n                    { id: \'large\', label: \'Large (115%)\', desc: \'Comfortable\' },\n                    { id: \'xlarge\', label: \'Extra Large\', desc: \'Maximum read\' },\n                  ].map((f) => (\n                    <button\n                      key={f.id}\n                      onClick={() => onChange({ ...config, fontScale: f.id as any })}\n                      className={`p-2 rounded-xl border text-left flex flex-col gap-0.5 transition-all ${\n                        config.fontScale === f.id\n                          ? \'bg-cyan-950/40 border-cyan-500 text-white shadow-sm ring-1 ring-cyan-500/40\'\n                          : \'bg-slate-900 border-slate-800 text-slate-400 hover:border-slate-700\'\n                      }`}\n                    >\n                      <span className=\"text-xs font-bold text-white\">{f.label}</span>\n                      <span className=\"text-[10px] text-slate-400\">{f.desc}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n            </>"
