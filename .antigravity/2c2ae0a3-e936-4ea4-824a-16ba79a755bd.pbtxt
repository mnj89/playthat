      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Sparkles,\n  Volume2,\n  Sliders,\n  Eye,\n  Headphones,\n  RotateCcw,\n  X,\n  Zap,\n  Moon,\n  Tv,\n  Check,\n} from \'lucide-react\';\nimport { DecoderMode, AspectRatioMode } from \'../types\';\n\nexport interface EnhancementConfig {\n  // Video Enhancements\n  contrast: number; // 80 to 140 (%)\n  saturation: number; // 80 to 150 (%)\n  sharpnessPreset: \'natural\' | \'crisp\' | \'vivid\' | \'hdr_tone\';\n  nightMode: boolean;\n  decoder: DecoderMode;\n  aspectRatio: AspectRatioMode;\n\n  // Audio Enhancements\n  volumeBoost: number; // 100 to 200 (%)\n  bassBoost: boolean;\n  vocalClarity: boolean;\n  spatialStereo: boolean;\n  equalizerPreset: \'flat\' | \'movie\' | \'dialogue\' | \'bass\' | \'rock\' | \'concert\';\n  audioDelayMs: number; // -1000 to +1000 ms\n}\n\nexport const DEFAULT_ENHANCEMENTS: EnhancementConfig = {\n  contrast: 105,\n  saturation: 110,\n  sharpnessPreset: \'crisp\',\n  nightMode: false,\n  decoder: \'HW+\',\n  aspectRatio: \'fit\',\n  volumeBoost: 120,\n  bassBoost: true,\n  vocalClarity: true,\n  spatialStereo: true,\n  equalizerPreset: \'movie\',\n  audioDelayMs: 0,\n};\n\ninterface EnhancementsModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  config: EnhancementConfig;\n  onChange: (config: EnhancementConfig) => void;\n}\n\nexport const EnhancementsModal: React.FC<EnhancementsModalProps> = ({\n  isOpen,\n  onClose,\n  config,\n  onChange,\n}) => {\n  const [activeTab, setActiveTab] = useState<\'video\' | \'audio\'>(\'video\');\n\n  if (!isOpen) return null;\n\n  const handleReset = () => {\n    onChange(DEFAULT_ENHANCEMENTS);\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-md animate-in fade-in duration-200 select-none\">\n      <div className=\"w-full max-w-lg bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl overflow-hidden flex flex-col\">\n        {/* Modal Top Bar */}\n        <div className=\"flex items-center justify-between px-6 py-4 border-b border-slate-800\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500/20 to-blue-500/20 border border-cyan-500/30 flex items-center justify-center text-cyan-400\">\n              <Sparkles className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-sm font-bold text-white leading-tight\">\n                Audio & Video Enhancement Studio\n              </h3>\n              <span className=\"text-[10px] text-slate-400 font-mono\">\n                MX Hardware Acceleration & Acoustic Engine\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <button\n              onClick={handleReset}\n              className=\"p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n              title=\"Reset to defaults\"\n            >\n              <RotateCcw className=\"w-4 h-4\" />\n            </button>\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-full hover:bg-slate-800 text-slate-400 hover:text-white transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Tab Selector */}\n        <div className=\"flex items-center px-6 pt-3 gap-2 border-b border-slate-800\">\n          <button\n            onClick={() => setActiveTab(\'video\')}\n            className={`pb-2.5 text-xs font-semibold border-b-2 transition-colors flex items-center gap-1.5 ${\n              activeTab === \'video\'\n                ? \'border-cyan-500 text-cyan-400\'\n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Tv className=\"w-3.5 h-3.5\" />\n            <span>Video Enhancements</span>\n          </button>\n          <button\n            onClick={() => setActiveTab(\'audio\')}\n            className={`pb-2.5 text-xs font-semibold border-b-2 transition-colors flex items-center gap-1.5 ${\n              activeTab === \'audio\'\n                ? \'border-blue-500 text-blue-400\'\n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Headphones className=\"w-3.5 h-3.5\" />\n            <span>Audio & Equalizer</span>\n          </button>\n        </div>\n\n        {/* Tab Body */}\n        <div className=\"p-6 overflow-y-auto max-h-[460px] flex flex-col gap-5\">\n          {activeTab === \'video\' ? (\n            /* VIDEO ENHANCEMENTS */\n            <>\n              {/* Decoder Mode Selector */}\n              <div className=\"flex flex-col gap-2\">\n                <div className=\"flex items-center justify-between text-xs font-medium text-slate-300\">\n                  <span>Hardware Decoder Mode</span>\n                  <span className=\"font-mono text-cyan-400 font-bold\">{config.decoder}</span>\n                </div>\n                <div className=\"grid grid-cols-3 gap-2\">\n                  {[\n                    { mode: \'HW\', label: \'HW (Native GPU)\', desc: \'Lowest battery usage\' },\n                    { mode: \'HW+\', label: \'HW+ (Enhanced)\', desc: \'Dynamic HDR & Sharpness\' },\n                    { mode: \'SW\', label: \'SW (Software)\', desc: \'Compatibility filter\' },\n                  ].map((d) => (\n                    <button\n                      key={d.mode}\n                      onClick={() => onChange({ ...config, decoder: d.mode as DecoderMode })}\n                      className={`p-2.5 rounded-xl border text-left flex flex-col gap-0.5 transition-all ${\n                        config.decoder === d.mode\n                          ? \'bg-cyan-950/40 border-cyan-500 text-white shadow-sm ring-1 ring-cyan-500/40\'\n                          : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                      }`}\n                    >\n                      <span className=\"text-xs font-bold text-white\">{d.label}</span>\n                      <span className=\"text-[10px] text-slate-400\">{d.desc}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Color Sharpness Profile */}\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-xs font-medium text-slate-300\">Visual Quality Preset</span>\n                <div className=\"grid grid-cols-4 gap-1.5\">\n                  {[\n                    { id: \'natural\', label: \'Natural\' },\n                    { id: \'crisp\', label: \'Crisp Detail\' },\n                    { id: \'vivid\', label: \'Vivid Pop\' },\n                    { id: \'hdr_tone\', label: \'HDR Sim\' },\n                  ].map((p) => (\n                    <button\n                      key={p.id}\n                      onClick={() => onChange({ ...config, sharpnessPreset: p.id as any })}\n                      className={`py-1.5 px-2 rounded-xl text-xs font-medium border text-center transition-colors ${\n                        config.sharpnessPreset === p.id\n                          ? \'bg-blue-600/30 border-blue-400 text-blue-300 font-bold\'\n                          : \'bg-slate-950 border-slate-800 text-slate-400 hover:text-white\'\n                      }`}\n                    >\n                      {p.label}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Contrast Slider */}\n              <div className=\"flex flex-col gap-1.5\">\n                <div className=\"flex items-center justify-between text-xs font-medium text-slate-300\">\n                  <span>Dynamic Contrast Boost</span>\n                  <span className=\"font-mono text-cyan-400\">{config.contrast}%</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min={80}\n                  max={140}\n                  value={config.contrast}\n                  onChange={(e) =>\n                    onChange({ ...config, contrast: parseInt(e.target.value, 10) })\n                  }\n                  className=\"w-full h-1.5 bg-slate-950 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n                />\n              </div>\n\n              {/* Saturation Slider */}\n              <div className=\"flex flex-col gap-1.5\">\n                <div className=\"flex items-center justify-between text-xs font-medium text-slate-300\">\n                  <span>Color Saturation & Vibrance</span>\n                  <span className=\"font-mono text-cyan-400\">{config.saturation}%</span>\n                </div>\n                <input\n                  type=\"range\"\n                  min={70}\n                  max={150}\n                  value={config.saturation}\n                  onChange={(e) =>\n                    onChange({ ...config, saturation: parseInt(e.target.value, 10) })\n                  }\n                  className=\"w-full h-1.5 bg-slate-950 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n                />\n              </div>\n\n              {/* Night Mode & Eye Comfort */}\n              <div className=\"flex items-center justify-between p-3 rounded-2xl bg-slate-950 border border-slate-800\">\n                <div className=\"flex items-center gap-2.5\">\n                  <Moon className=\"w-4 h-4 text-amber-400\" />\n                  <div className=\"flex flex-col\">\n                    <span className=\"text-xs font-bold text-white\">Night Comfort Mode</span>\n                    <span className=\"text-[10px] text-slate-400\">\n                      Reduces blue light spectrum for bedtime viewing\n                    </span>\n                  </div>\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, nightMode: !config.nightMode })}\n                  className={`w-11 h-6 rounded-full transition-colors p-0.5 ${\n                    config.nightMode ? \'bg-amber-500\' : \'bg-slate-800\'\n                  }`}\n                >\n                  <div\n                    className={`w-5 h-5 rounded-full bg-white transition-transform ${\n                      config.nightMode ? \'translate-x-5\' : \'translate-x-0\'\n                    }`}\n                  />\n                </button>\n              </div>\n            </>\n          ) : (\n            /* AUDIO ENHANCEMENTS */\n            <>\n              {/* MX Extra Volume Boost (100% to 200%) */}\n              <div className=\"p-4 rounded-2xl bg-gradient-to-r from-blue-950/40 via-slate-950 to-cyan-950/40 border border-blue-500/30 flex flex-col gap-2\">\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-2 text-xs font-bold text-white\">\n                    <Zap className=\"w-4 h-4 text-cyan-400\" />\n                    <span>MX Sound Amplification (Boost)</span>\n                  </div>\n                  <span className=\"text-sm font-mono font-bold text-cyan-300\">\n                    {config.volumeBoost}%\n                  </span>\n                </div>\n                <input\n                  type=\"range\"\n                  min={100}\n                  max={200}\n                  value={config.volumeBoost}\n                  onChange={(e) =>\n                    onChange({ ...config, volumeBoost: parseInt(e.target.value, 10) })\n                  }\n                  className=\"w-full h-1.5 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400\"\n                />\n                <span className=\"text-[10px] text-slate-400\">\n                  Boosts quiet audio tracks and movies up to 200% with soft limiter clipping protection.\n                </span>\n              </div>\n\n              {/* Acoustic Enhancers (Toggles) */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                {/* Bass Boost */}\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, bassBoost: !config.bassBoost })}\n                  className={`p-3 rounded-2xl border text-left flex flex-col justify-between gap-2 transition-all ${\n                    config.bassBoost\n                      ? \'bg-blue-950/50 border-blue-500 text-white shadow-sm\'\n                      : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                  }`}\n                >\n                  <span className=\"text-xs font-bold text-white\">Bass Booster</span>\n                  <span className=\"text-[10px] text-slate-400\">\n                    Deepens low-end subwoofer rumble\n                  </span>\n                  <span className=\"text-[10px] font-mono font-bold text-blue-400\">\n                    {config.bassBoost ? \'ENABLED\' : \'OFF\'}\n                  </span>\n                </button>\n\n                {/* Vocal Clarity */}\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, vocalClarity: !config.vocalClarity })}\n                  className={`p-3 rounded-2xl border text-left flex flex-col justify-between gap-2 transition-all ${\n                    config.vocalClarity\n                      ? \'bg-blue-950/50 border-blue-500 text-white shadow-sm\'\n                      : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                  }`}\n                >\n                  <span className=\"text-xs font-bold text-white\">Clear Voice</span>\n                  <span className=\"text-[10px] text-slate-400\">\n                    Sharpens dialogue over loud sound FX\n                  </span>\n                  <span className=\"text-[10px] font-mono font-bold text-blue-400\">\n                    {config.vocalClarity ? \'ENABLED\' : \'OFF\'}\n                  </span>\n                </button>\n\n                {/* Spatial Stereo */}\n                <button\n                  type=\"button\"\n                  onClick={() => onChange({ ...config, spatialStereo: !config.spatialStereo })}\n                  className={`p-3 rounded-2xl border text-left flex flex-col justify-between gap-2 transition-all ${\n                    config.spatialStereo\n                      ? \'bg-blue-950/50 border-blue-500 text-white shadow-sm\'\n                      : \'bg-slate-950 border-slate-800 text-slate-400 hover:border-slate-700\'\n                  }`}\n                >\n                  <span className=\"text-xs font-bold text-white\">Spatial Sound</span>\n                  <span className=\"text-[10px] text-slate-400\">\n                    Expands virtual soundstage on speakers\n                  </span>\n                  <span className=\"text-[10px] font-mono font-bold text-blue-400\">\n                    {config.spatialStereo ? \'ENABLED\' : \'OFF\'}\n                  </span>\n                </button>\n              </div>\n\n              {/* Equalizer Presets */}\n              <div className=\"flex flex-col gap-2\">\n                <span className=\"text-xs font-medium text-slate-300\">Equalizer Tuning</span>\n                <div className=\"grid grid-cols-3 gap-2\">\n                  {[\n                    { id: \'flat\', label: \'Flat (Studio)\' },\n                    { id: \'movie\', label: \'Cinema Hall\' },\n                    { id: \'dialogue\', label: \'Dialogue Focus\' },\n                    { id: \'bass\', label: \'Mega Bass\' },\n                    { id: \'rock\', label: \'Rock Live\' },\n                    { id: \'concert\', label: \'Concert Hall\' },\n                  ].map((eq) => (\n                    <button\n                      key={eq.id}\n                      onClick={() => onChange({ ...config, equalizerPreset: eq.id as any })}\n                      className={`py-2 px-2.5 rounded-xl text-xs font-medium border text-center transition-colors ${\n                        config.equalizerPreset === eq.id\n                          ? \'bg-blue-600/30 border-blue-400 text-blue-300 font-bold\'\n                          : \'bg-slate-950 border-slate-800 text-slate-400 hover:text-white\'\n                      }`}\n                    >\n                      {eq.label}\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Bluetooth Audio Delay Sync */}\n              <div className=\"flex flex-col gap-1.5 p-3 rounded-2xl bg-slate-950 border border-slate-800\">\n                <div className=\"flex items-center justify-between text-xs font-medium text-slate-300\">\n                  <span>Bluetooth / Headphone Audio Delay</span>\n                  <span className=\"font-mono text-blue-400 font-bold\">\n                    {config.audioDelayMs > 0 ? `+${config.audioDelayMs}` : config.audioDelayMs} ms\n                  </span>\n                </div>\n                <div className=\"flex items-center gap-2\">\n                  <button\n                    onClick={() =>\n                      onChange({\n                        ...config,\n                        audioDelayMs: Math.max(-1000, config.audioDelayMs - 100),\n                      })\n                    }\n                    className=\"px-2.5 py-1 text-xs rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700\"\n                  >\n                    -100ms\n                  </button>\n                  <button\n                    onClick={() => onChange({ ...config, audioDelayMs: 0 })}\n                    className=\"px-2.5 py-1 text-xs rounded-lg bg-slate-800 text-slate-400 hover:text-white\"\n                  >\n                    0ms\n                  </button>\n                  <button\n                    onClick={() =>\n                      onChange({\n                        ...config,\n                        audioDelayMs: Math.min(1000, config.audioDelayMs + 100),\n                      })\n                    }\n                    className=\"px-2.5 py-1 text-xs rounded-lg bg-slate-800 text-slate-200 hover:bg-slate-700\"\n                  >\n                    +100ms\n                  </button>\n                </div>\n              </div>\n            </>\n          )}\n        </div>\n\n        {/* Footer */}\n        <div className=\"px-6 py-4 bg-slate-950 border-t border-slate-800 flex justify-end\">\n          <button\n            onClick={onClose}\n            className=\"px-5 py-2 text-xs font-semibold text-white bg-blue-600 hover:bg-blue-500 rounded-xl transition-colors shadow-md\"\n          >\n            Save & Apply\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
