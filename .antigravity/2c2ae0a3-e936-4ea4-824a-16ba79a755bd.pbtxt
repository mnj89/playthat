\'local\',\n    url: \'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-3.mp3\',\n    thumbnailUrl: \'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=600&q=80\',\n    duration: 346, // 5m 46s\n    currentTime: 0,\n    resolution: \'FLAC Lossless\',\n    fileSize: 26000000,\n    codec: \'FLAC 24-bit 96kHz\',\n    decoder: \'HW+\',\n    createdAt: Date.now() - 86400000 * 4,\n    isFavorite: true,\n    isEncrypted: false,\n  },\n  {\n    id: \'audio-4\',\n    title: \'Midnight Piano Reverie\',\n    artist: \'Aetheria Ensemble\',\n    album: \'Nocturne Reflections\',\n    folder: \'Music\',\n    mediaType: \'audio\',\n    sourceType: \'local\',\n    url: \'https://www.soundhelix.com/examples/mp3/SoundHelix-Song-8.mp3\',\n    thumbnailUrl: \'https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&fit=crop&w=600&q=80\',\n    duration: 315, // 5m 15s\n    currentTime: 0,\n    resolution: \'320 kbps MP3\',\n    fileSize: 7600000,\n    codec: \'MP3 Stereo 44.1kHz\',\n    decoder: \'HW\',\n    createdAt: Date.now() - 86400000 * 3,\n    isFavorite: false,\n    isEncrypted: false,\n  },\n  {\n    id: \'media-4\',\n    title: \'For Bigger Blazes (Action Demo)\',\n    folder: \'Downloads\',\n    mediaType: \'video\',\n    sourceType: \'local\',\n    url: \'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4\',\n    thumbnailUrl: \'https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=600&q=80\',\n    duration: 15,\n    currentTime: 0,\n    resolution: \'720p HD\',\n    fileSize: 18500000,\n    codec: \'H.264 / AAC\',\n    decoder: \'SW\',\n    createdAt: Date.now() - 86400000 * 1,\n    isFavorite: false,\n    isEncrypted: false,\n  },\n  {\n    id: \'media-5\',\n    title: \'HLS Live Demo Stream (Adaptive Bitrate M3U8)\',\n    folder: \'Stream Captures\',\n    mediaType: \'video\',\n    sourceType: \'stream\',\n    url: \'https://test-streams.mux.dev/x36xhzz