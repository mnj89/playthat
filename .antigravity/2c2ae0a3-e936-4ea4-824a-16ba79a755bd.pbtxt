  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@layer base {\n  html {\n    /* Adaptive system font scaling: responsive to user preference and viewport width */\n    font-size: clamp(15px, 0.95rem + 0.25vw, 18px);\n    -webkit-text-size-adjust: 100%;\n    text-size-adjust: 100%;\n  }\n\n  body {\n    font-family: \'Plus Jakarta Sans\', system-ui, -apple-system, sans-serif;\n    -webkit-tap-highlight-color: transparent;\n    touch-action: manipulation;\n    font-size: 1rem;\n    line-height: 1.5;\n  }\n\n  code, pre, .font-mono {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n/* System Adaptive Font Scaling Classes */\n.font-scale-standard {\n  font-size: 1rem;\n}\n\n.font-scale-large {\n  font-size: 1.125rem;\n}\n\n.font-scale-xlarge {\n  font-size: 1.25rem;\n}\n\n/* Custom smooth scrollbar for video lists */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: transparent;\n}\n\n::-webkit-scrollbar-thumb {\n  background: rgba(148, 163, 184, 0.25);\n  border-radius: 9999px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: rgba(148, 163, 184, 0.45);\n}\n\n/* Subtitle shadow and glow styling */\n.subtitle-text {\n  text-shadow: 0px 2px 4px rgba(0, 0, 0, 0.9), 0px -1px 2px rgba(0, 0, 0, 0.8), 2px 0px 2px rgba(0, 0, 0, 0.8), -2px 0px 2px rgba(0, 0, 0, 0.8);\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
