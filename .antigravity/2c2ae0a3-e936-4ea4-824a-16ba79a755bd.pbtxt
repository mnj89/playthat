    replacement_infos {
      original_chunk {
        target_content: "  // Download & remux state\n  const [activeDownloadTask, setActiveDownloadTask] = useState<M3U8DownloadTask | null>(null);\n  const [abortController, setAbortController] = useState<AbortController | null>(null);\n  const [completedItem, setCompletedItem] = useState<MediaItem | null>(null);\n\n  // Switch active tab\n  const handleSwitchTab = (tabId: string) => {\n    setActiveTabId(tabId);\n    const target = tabs.find((t) => t.id === tabId);\n    if (target) {\n      setUrlInput(target.url);\n    }\n    setShowTabGrid(false);\n  };\n\n  // Open new tab (up to 40)\n  const handleNewTab = (defaultUrl?: string, defaultTitle?: string) => {\n    if (tabs.length >= MAX_TABS) {\n      setTabLimitAlert(`Maximum tab limit of ${MAX_TABS} reached. Please close a tab to open a new one.`);\n      setTimeout(() => setTabLimitAlert(null), 3500);\n      return;\n    }\n\n    const newUrl = defaultUrl || \'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\';\n    const newTitle = defaultTitle || `New Tab ${tabs.length + 1}`;\n    const detected = sniffMediaStreams(newUrl);\n\n    const newTab: BrowserTab = {\n      id: `tab-${Date.now()}-${Math.random().toString(36).substring(2, 5)}`,\n      title: newTitle,\n      url: newUrl,\n      detectedStreams: detected,\n      createdAt: Date.now(),\n    };\n\n    setTabs((prev) => [...prev, newTab]);\n    setActiveTabId(newTab.id);\n    setUrlInput(newUrl);\n    setShowTabGrid(false);\n  };\n\n  // Close tab\n  const handleCloseTab = (tabId: string, e?: React.MouseEvent) => {\n    e?.stopPropagation();\n    if (tabs.length <= 1) {\n      // Keep at least 1 tab open, reset to home\n      const resetTab: BrowserTab = {\n        id: `tab-${Date.now()}`,\n        title: \'New Tab\',\n        url: \'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\',\n        detectedStreams: sniffMediaStreams(\'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\'),\n        createdAt: Date.now(),\n      };\n      setTabs([resetTab]);\n      setActiveTabId(resetTab.id);\n      setUrlInput(resetTab.url);\n      return;\n    }\n\n    const filtered = tabs.filter((t) => t.id !== tabId);\n    setTabs(filtered);\n\n    if (activeTabId === tabId) {\n      const nextActive = filtered[filtered.length - 1];\n      setActiveTabId(nextActive.id);\n      setUrlInput(nextActive.url);\n    }\n  };\n\n  // Close all tabs\n  const handleCloseAllTabs = () => {\n    const singleTab: BrowserTab = {\n      id: `tab-${Date.now()}`,\n      title: \'New Tab\',\n      url: \'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\',\n      detectedStreams: sniffMediaStreams(\'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\'),\n      createdAt: Date.now(),\n    };\n    setTabs([singleTab]);\n    setActiveTabId(singleTab.id);\n    setUrlInput(singleTab.url);\n    setShowTabGrid(false);\n  };\n\n  // Navigate active tab\n  const handleNavigate = (targetUrl: string) => {\n    setUrlInput(targetUrl);\n    const detected = sniffMediaStreams(targetUrl);\n    const fileName = targetUrl.split(\'/\').pop()?.split(\'?\')[0] || \'Web Stream\';\n\n    setTabs((prev) =>\n      prev.map((t) =>\n        t.id === activeTabId\n          ? {\n              ...t,\n              url: targetUrl,\n              title: decodeURIComponent(fileName),\n              detectedStreams: detected,\n            }\n          : t\n      )\n    );\n  };\n\n  const handleSearchSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    let query = urlInput.trim();\n    if (!query) return;\n\n    if (!query.startsWith(\'http://\') && !query.startsWith(\'https://\')) {\n      if (query.includes(\'.\') && !query.includes(\' \')) {\n        query = `https://${query}`;\n      } else {\n        query = `https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8`;\n      }\n    }\n\n    handleNavigate(query);\n  };\n\n  const startDownloadAndConvert = async (streamUrl: string, streamLabel: string) => {\n    const controller = new AbortController();\n    setAbortController(controller);\n    setCompletedItem(null);\n\n    try {\n      const res = await downloadM3U8Stream(\n        streamUrl,\n        streamLabel,\n        (task) => {\n          setActiveDownloadTask(task);\n        },\n        controller.signal\n      );\n\n      const newItem: MediaItem = {\n        id: `m3u8-dl-${Date.now()}`,\n        title: streamLabel || \'Converted HLS Stream\',\n        folder: \'Stream Captures\',\n        sourceType: \'downloaded\',\n        url: res.blobUrl,\n        thumbnailUrl: \'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\',\n        duration: res.duration || 60,\n        currentTime: 0,\n        resolution: \'1080p Remuxed\',\n        fileSize: res.size,\n        codec: \'MP4 / H.264 AAC\',\n        decoder: \'HW\',\n        createdAt: Date.now(),\n        isFavorite: false,\n        isEncrypted: false,\n      };\n\n      setCompletedItem(newItem);\n      onSaveToLibrary(newItem);\n    } catch (err: any) {\n      console.error(\'Download error:\', err);\n    }\n  };"
