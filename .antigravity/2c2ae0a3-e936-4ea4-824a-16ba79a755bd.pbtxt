  url: st.url,\n                          thumbnailUrl:\n                            \'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\',\n                          duration: 300,\n                          currentTime: 0,\n                          resolution: \'HLS Live Stream\',\n                          fileSize: 150000000,\n                          codec: \'HLS / AAC\',\n                          decoder: \'HW\',\n                          createdAt: Date.now(),\n                          isFavorite: true,\n                          isEncrypted: false,\n                        })"
