              text: "    .sort((a, b) => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (sortBy === \'name\') return a.title.localeCompare(b.title);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (sortBy === \'size\') return b.fileSize - a.fileSize;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      if (sortBy === \'duration\') return b.duration - a.duration;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return b.createdAt - a.createdAt;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
