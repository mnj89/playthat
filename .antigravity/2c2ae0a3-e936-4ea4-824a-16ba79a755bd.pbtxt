ation?: number;\\n}\\n\\nexport interface M3U8DownloadTask {\\n  id: string;\\n  title: string;\\n  manifestUrl: string;\\n  totalSegments: number;\\n  downloadedSegments: number;\\n  status: \'idle\' | \'sniffing\' | \'downloading\' | \'muxing\' | \'completed\' | \'error\';\\n  errorMessage?: string;\\n  speedKbps: number;\\n  outputBlobUrl?: string;\\n  outputSize?: number;\\n  downloadDate?: number;\\n}\\n\\nexport interface Playlist {\\n  id: string;\\n  title: string;\\n  description?: string;\\n  mediaIds: string[];\\n  createdAt: number;\\n  updatedAt: number;\\n}\\n\\nexport type ActiveTab = \'folders\' | \'browser\' | \'downloads\' | \'playlists\' | \'vault\';\\n\", \"Description\":\"Expand types to support UC-style download manager tasks and tabs\", \"Overwrite\":true, \"TargetFile\":\"/src/types/index.ts\", \"toolAction\":\"Updating type definitions\", \"toolSummary\":\"Update src/types/index.ts\"}"
