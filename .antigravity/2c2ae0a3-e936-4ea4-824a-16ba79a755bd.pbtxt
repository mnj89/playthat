            lines {
              text: "      const matchesFolder = selectedFolder === \'All\' || item.folder === selectedFolder;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const matchesSearch = item.title.toLowerCase().includes(searchQuery.toLowerCase());"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      return matchesFolder && matchesSearch;"
