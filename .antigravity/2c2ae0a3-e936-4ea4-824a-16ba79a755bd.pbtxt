      thinking_signature: "\022\275\n\n\272\n\001i\024}\023+\t\353>oG\t\3651\206\036\363c\3407\371Z\325\004o\307E\372F\361\245\025\244\351\\\t\261<\216\b\363\230-\245o\b\346\024\023\223\b\354X-\315\231\234Y\266\313\253#\225\363D\023\005\244G\214*a\211\315.S\325\300\276\274KK\346\332O0P\363L\302V\257\210\323\331\226h\\\2337\240\335s\'9\360\326\315\303i\362\261\21023B\004 7\305\240\371\211Z\365\264eoc\271\3736\212\370\273\364\351AG\202&g\204\254\351\"\035F\362\327\270\377\370\202\324Hb\321\207X\030ze\2634|\222\241\213\266\202x\375P\a\271\246\314c\346o\343\002N\243\222~\270\304\343\036\321\257\004t\002\236}\250S\274.\\\224\035\375l.ag\251\233\"\\9\"\345\020(\220\364\331Lt\327)\2514\376\376N\237(\210\026\217c\267\242V\002\027\367\250\362\026Ds6N\346 \303\3031\237q`};\344\261\177\253\217f\370\205\236\230s\373\371\016_\034\371\223\233}W\316\256|F\223\276\336A?)8\2312\372s\222K\242\321\350\256\001\326qk\336\371\221i\243\312\314DY/\225\223\257>\360\223c\331\2465\356A\304\024\327\346\310\030m\333  \202\330\201\376\371\220\330\361\303\254\234M\325\342\334\203/wV#\227\310\211\311\252\351L\332g}-nu\211\321C\267\016\3065XA\032#\320`\257XA%\306\320\341l\205\243\232\205\005v\342\252\211\325\206\256\032P\215\234\024\351\342x\r\356\035\266\271\235]\250\361,\226\027L\320\037\037\035H\325x\020\310\253xf\365v\020\023\345@o\002F)\357U\354f\205a^\213\340\311(%Q<W\263:\205\001b\036<T\345\"\357\357-\035q\302\331,T&\344\270\334\t\210\331\273\v0\202\236$\201\352|V\244lQ\336O\023\337gLx\325dt\272\375\347\tA$H\035E\006f+B\320\374\n\277_\223vy\206\253./\026\254]t\246\317\231ss\311\v^v(\364\225\251Y[d\225`{a\r\'\020\220\225\211\2603\246Q\227\231\'\322\302\221\261\025\373\356\340\353\205\230\232WJ\350\274x{81\030\260\017\000g\321\217\204=\340Y\021\200,U!\271\263\004\306\a!\234\322SOG\356\035\211\275\303?\330O\235\021K\301\257\312\232\a,y\276\367\220\373\235\017\216\210\247\330\367X9\300\001\224\232G\251V\306\2628\b\342%\f\332\267\025\0363E\231\223\355\214\021\355\342\266\277\310c\306\004\233\327`Y\365\026\023z\271\271\350\222>\306\267\311\3310\032\353\244V*\357U)4y-\202\212 U1m\346\030\365vp7\022\025`\000P\006\tg\337\241:\003\343\253\017\262\326}\240\2752\202a+\264\334\344\372\255\200\2156\352\263\305\"^\024\023\273X?I\212\235y\340l>\017\316\366\363_VK\032=\223\224\301\252Y\322\377.\267\225Z\214\fO\220\307P\210\353\347\017=\246\363\374c]\335\314\306\211\030\351d_\375\237\0348+O\275\342\307\\ug\000\340\3604\241\353\033\361b(\177u\003\270`}\001\206=\257\310!iO\337\266-\325\247\b\037\213Mt\307\275\220!\263ok{\320\377^Yk\224 \36404\223\020w\256\320\341\317Nc\342\fq\022\330\221w\277\023gD&\245\255\016\020\221\262\257\306\002\366\352\251\254\240\273\360\246X\304\003\201\034u;y\354\b(\260\205\310\343\320\206\277\254I\002\aua\310\221\312s\271\210\335\037\020s]\320\212Kgt\247&\266\227:}\365-7\260v\271\325\021\361\340nt\217\207@O\030\217\257\016O!\3207\366\375\376u\341\300k\205\330\0205\023\022(\230`\265\340\325\267\a\302\373\"\236G\003\262\000\225\037\rZ\201\f^\r@\362\367\245[\232rv\326\344\030\325Q\232\t\267v\2147\270\365\f\327\257\372i\257\272*\277\b\347\346\211T^eX\006\n\310k\210\256*\314\255^-\327\351\216\271\370f\336@\rO\326\2206>D\330\260\310\266p\265\017br\242\214\v\303\207m\251\333-Z>&\323W\262\252T\210\200j\230\f!]R@\246?\004n\377\347:f\323\264H\265\251\002\220&\250V\334\225i]\366*\257h\310M\275\340\321\251\212|\236\367\321L\270\022\242\325\323C\234\v\247\305Oe\r\304\b\316t<\205\274\023\242\201/\236_\331\366\217G6ny\231\237\274\363\305\205S\257m\226\263\376[h\2021\304T\365a\341\334\361T\314N\320!6Y[67\205\225\267\337\032\225\0176\3518\017\342\032\b\024\342\243\345yc0\304M\215{\243\367\351\005#\237\246\326\221i\3204\306\277\316yk\275\247\251\343>$\340\331\311d\363\0242\307=\243\311\'\341E/\032M\317\337\276L&x\343\313\006(\rE5(\242\021fr.v\223\233\361/<\374\005\000\310\260u%\354G#\027 \3605\366?\273\276"
