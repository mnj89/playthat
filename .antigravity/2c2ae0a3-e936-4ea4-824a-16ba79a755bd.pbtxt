    content: "          {children}\n        </div>\n      </div>\n    );\n  }\n\n  const isTablet = frameMode === \'tablet\';\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 flex flex-col items-center justify-center p-2 sm:p-4 md:p-6 overflow-x-hidden\">\n      {/* Device Mode Switcher Toolbar */}\n      <div className=\"mb-3 flex items-center gap-3 bg-slate-900/80 backdrop-blur-md px-3 py-1.5 rounded-full border border-slate-800 shadow-md\">\n        <span className=\"text-xs text-slate-400 font-medium\">Device:</span>\n        <div className=\"flex items-center gap-1\">\n          <button\n            onClick={() => onFrameModeChange(\'phone\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'phone\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            <span>Phone</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'tablet\')}\n            className={`px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n              frameMode === \'tablet\'\n                ? \'bg-blue-600 text-white shadow-sm\'\n                : \'text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Tablet className=\"w-3.5 h-3.5\" />\n            <span>Tablet</span>\n          </button>\n          <button\n            onClick={() => onFrameModeChange(\'responsive\')}\n            className=\"px-3 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors text-slate-400 hover:text-white\"\n          >\n            <Monitor className=\"w-3.5 h-3.5\" />\n            <span>Full View</span>\n          </button>\n        </div>\n\n        {/* Phone Power / Lock Button */}\n        <div className=\"h-4 w-px bg-slate-700 mx-1\" />\n        <button\n          onClick={() => {\n            setIsPhoneLocked(!isPhoneLocked);\n            setIsNotificationShadeOpen(false);\n          }}\n          className={`px-2.5 py-1 text-xs font-medium rounded-full flex items-center gap-1.5 transition-colors ${\n            isPhoneLocked\n              ? \'bg-amber-600 text-white\'\n              : \'bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700\'\n          }`}\n          title={isPhoneLocked ? \'Unlock phone\' : \'Lock phone (music plays in background)\'}\n        >\n          {isPhoneLocked ? <Unlock className=\"w-3.5 h-3.5\" /> : <Lock className=\"w-3.5 h-3.5\" />}\n          <span>{isPhoneLocked ? \'Unlock Phone\' : \'Lock Phone\'}</span>\n        </button>\n      </div>\n\n      {/* Realistic Android Hardware Chassis */}\n      <div\n        className={`relative bg-slate-900 border-[7px] border-slate-800 rounded-[44px] shadow-2xl shadow-cyan-950/20 overflow-hidden flex flex-col transition-all duration-300 ${\n          isTablet\n            ? \'w-full max-w-[960px] h-[780px]\'\n            : isPlayerActive\n            ? \'w-full max-w-[840px] h-[520px] rounded-[36px]\'\n            : \'w-full max-w-[430px] h-[870px]\'\n        }`}\n        style={{\n          boxShadow: \'0 0 0 2px rgba(255, 255, 255, 0.08), 0 25px 60px -15px rgba(0, 0, 0, 0.7)\',\n        }}\n      >\n        {/* Android Hardware Power Button on Right Chassis Side */}\n        <div\n          onClick={() => {\n            setIsPhoneLocked(!isPhoneLocked);\n            setIsNotificationShadeOpen(false);\n          }}\n          className=\"absolute -right-2 top-28 w-2 h-12 bg-slate-700 hover:bg-slate-500 rounded-r-md cursor-pointer z-50 transition-colors\"\n          title=\"Hardware Power / Lock Key\"\n        />\n\n        {/* Android Punch Hole Camera */}\n        <div className=\"absolute top-2.5 left-1/2 -translate-x-1/2 z-50 flex items-center justify-center\">\n          <div className=\"w-4 h-4 rounded-full bg-black border border-slate-800 shadow-inner flex items-center justify-center\">\n            <div className=\"w-1.5 h-1.5 rounded-full bg-slate-900/90\" />\n          </div>\n        </div>\n\n        {/* Android Status Bar (Click to toggle Notification Shade) */}\n        <div\n          onClick={() => {\n            if (!isPhoneLocked) {\n              setIsNotificationShadeOpen(!isNotificationShadeOpen);\n            }\n          }}\n          className=\"h-7 w-full px-6 flex items-center justify-between text-xs text-slate-300 bg-slate-950/80 backdrop-blur-sm shrink-0 z-40 select-none cursor-pointer hover:bg-slate-900/90 transition-colors\"\n          title=\"Tap status bar to pull down notifications\"\n        >\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-semibold tracking-wide text-[11px] font-mono\">\n              {currentTimeStr}\n            </span>\n            {audioState.currentTrack && (\n              <span className=\"flex items-center gap-1 text-[10px] text-cyan-400\">\n                <Music className=\"w-3 h-3 animate-pulse\" />\n                <span className=\"truncate max-w-[70px]\">{audioState.currentTrack.title}</span>\n              </span>\n            )}\n          </div>\n\n          <div className=\"flex items-center gap-2 text-slate-300\">\n            <Signal className=\"w-3 h-3\" />\n            <span className=\"text-[10px] font-mono font-medium\">5G</span>\n            <Wifi className=\"w-3 h-3\" />\n            <div className=\"flex items-center gap-0.5\">\n              <span className=\"text-[10px] font-mono font-medium\">94%</span>\n              <BatteryMedium className=\"w-3.5 h-3.5 text-emerald-400\" />\n            </div>\n          </div>\n        </div>\n\n        {/* Notification Shade Drawer Overlay (When user pulls down) */}\n        {isNotificationShadeOpen && !isPhoneLocked && (\n          <div className=\"absolute inset-x-0 top-7 z-40 bg-slate-950/95 backdrop-blur-2xl border-b border-slate-800 p-4 shadow-2xl flex flex-col gap-3 animate-in slide-in-from-top duration-200\">\n            {/* Quick Settings Tiles */}"
