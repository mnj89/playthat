    content: "            {isUnlocked && (\n              <button\n                onClick={() => setIsDisguised(true)}\n                className=\"px-2.5 py-1 text-xs font-medium rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center gap-1.5 transition-colors border border-slate-700\"\n                title=\"Quick Disguise as Calculator\"\n              >\n                <Calculator className=\"w-3.5 h-3.5 text-amber-400\" />\n                <span>Disguise</span>\n              </button>\n            )}\n\n            <button\n              onClick={onClose}\n              className=\"p-1.5 rounded-full hover:bg-slate-800 text-slate-400 hover:text-white transition-colors\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* UNLOCKED VIEW: Display Encrypted Videos */}\n        {isUnlocked ? (\n          <div className=\"p-6 flex flex-col gap-4 max-h-[500px] overflow-y-auto\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider\">\n                Protected Media ({vaultItems.length})\n              </span>\n              <button\n                onClick={() => {\n                  setIsUnlocked(false);\n                  setCurrentPin(\'\');\n                }}\n                className=\"text-xs text-red-400 hover:underline flex items-center gap-1\"\n              >\n                <Lock className=\"w-3.5 h-3.5\" />\n                <span>Lock Vault</span>\n              </button>\n            </div>\n\n            {vaultItems.length === 0 ? (\n              <div className=\"p-8 rounded-2xl bg-slate-950 border border-slate-800/80 flex flex-col items-center justify-center text-center gap-2\">\n                <FileKey className=\"w-10 h-10 text-slate-600 mb-1\" />\n                <span className=\"text-sm font-semibold text-white\">Your Vault is Empty</span>\n                <span className=\"text-xs text-slate-400 max-w-xs\">\n                  Videos stored here are encrypted with AES-256-GCM. Select a video from your library below to encrypt and protect it.\n                </span>\n              </div>\n            ) : (\n              <div className=\"flex flex-col gap-2.5\">\n                {vaultItems.map((item) => (\n                  <div\n                    key={item.id}\n                    className=\"p-3 rounded-2xl bg-slate-950 border border-slate-800 flex items-center justify-between gap-3 hover:border-slate-700 transition-colors\"\n                  >\n                    <div className=\"flex items-center gap-3 min-w-0\">\n                      <div className=\"w-10 h-10 rounded-xl bg-slate-900 border border-slate-800 flex items-center justify-center shrink-0\">\n                        <Lock className=\"w-5 h-5 text-emerald-400\" />\n                      </div>\n                      <div className=\"flex flex-col min-w-0\">\n                        <span className=\"text-xs font-semibold text-white truncate\">\n                          {item.title}\n                        </span>\n                        <span className=\"text-[10px] font-mono text-slate-400\">\n                          AES-256-GCM \302\267 {item.resolution}\n                        </span>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 shrink-0\">\n                      <button\n                        onClick={() => handlePlayVaultItem(item.id, item.title)}\n                        className=\"p-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white transition-colors\"\n                        title=\"Decrypt & Play\"\n                      >\n                        <Play className=\"w-4 h-4 fill-white\" />\n                      </button>\n                      <button\n                        onClick={() => handleDeleteItem(item.id)}\n                        className=\"p-2 rounded-xl bg-slate-800 hover:bg-red-600/30 text-slate-400 hover:text-red-400 transition-colors\"\n                        title=\"Remove from Vault\"\n                      >\n                        <Trash2 className=\"w-4 h-4\" />\n                      </button>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            )}\n\n            {/* Quick Add from Library */}\n            <div className=\"border-t border-slate-800 pt-4 flex flex-col gap-2\">\n              <span className=\"text-xs font-medium text-slate-300\">\n                Encrypt & Add Library Video:\n              </span>\n              <div className=\"flex flex-col gap-1.5 max-h-40 overflow-y-auto\">\n                {availableLibraryVideos.map((video) => (\n                  <div\n                    key={video.id}\n                    className=\"p-2 rounded-xl bg-slate-950/70 border border-slate-800 flex items-center justify-between text-xs\"\n                  >\n                    <span className=\"truncate max-w-[220px] text-slate-200\">\n                      {video.title}\n                    </span>\n                    <button\n                      disabled={isImporting}\n                      onClick={() => handleAddExistingToVault(video)}\n                      className=\"px-2.5 py-1 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-[11px] font-medium flex items-center gap-1 transition-colors disabled:opacity-50\"\n                    >\n                      <Plus className=\"w-3.5 h-3.5\" />\n                      <span>Encrypt</span>\n                    </button>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </div>\n        ) : (\n          /* LOCKED VIEW: PIN Pad Entry */\n          <div className=\"p-6 flex flex-col items-center gap-5\">\n            <div className=\"flex flex-col items-center gap-1 text-center\">\n              <div className=\"w-12 h-12 rounded-2xl bg-blue-600/10 border border-blue-500/20 flex items-center justify-center text-blue-400 mb-1\">\n                <Lock className=\"w-6 h-6\" />\n              </div>\n              <h4 className=\"text-base font-bold text-white\">\n                {isSettingUp\n                  ? confirmPinInput\n                    ? \'Confirm New Security PIN\'\n                    : \'Create Vault Security PIN\'\n                  : \'Enter Private PIN\'}\n              </h4>\n              <p className=\"text-xs text-slate-400 max-w-xs\">"
