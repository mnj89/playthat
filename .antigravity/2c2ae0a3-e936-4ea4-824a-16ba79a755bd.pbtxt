  view_file {
    absolute_path_uri: "file:///src/services/downloadManagerService.ts"
    start_line: 59
    end_line: 89
    content: "   * Start a direct MP4 download or M3U8 stream conversion\n   */\n  public async addDownload(\n    url: string,\n    customTitle?: string\n  ): Promise<string> {\n    const isM3U8 = url.includes(\'.m3u8\');\n    const type = isM3U8 ? \'m3u8\' : \'mp4\';\n    const fileName =\n      customTitle ||\n      url.split(\'/\').pop()?.split(\'?\')[0] ||\n      (isM3U8 ? \'Stream_Capture.m3u8\' : \'Video_Download.mp4\');\n\n    const id = `dl-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;\n    const newTask: DownloadTask = {\n      id,\n      title: decodeURIComponent(fileName),\n      url,\n      type,\n      status: \'downloading\',\n      progress: 0,\n      downloadedBytes: 0,\n      totalBytes: isM3U8 ? 60000000 : 85000000, // estimated if headers pending\n      speedBytesPerSec: 0,\n      createdAt: Date.now(),\n      thumbnailUrl: \'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=600&q=80\',\n    };\n\n    this.tasks.unshift(newTask);\n    this.notify();\n"
    num_lines: 321
    num_bytes: 9566
    line_range_bytes: 972
  }
}
