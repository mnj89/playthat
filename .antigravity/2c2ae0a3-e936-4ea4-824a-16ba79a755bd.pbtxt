    use_fast_apply: true
    replacement_infos {
      original_chunk {
        target_content: "      {/* Top Action Toolbar */}\n      <div className=\"p-3 bg-slate-900 border-b border-slate-800 flex flex-col gap-2.5 shrink-0\">\n        <div className=\"flex items-center justify-between gap-3\">\n          {/* Search Box */}\n          <div className=\"relative flex-1\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search local and streamed videos...\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              className=\"w-full pl-9 pr-3 py-1.5 bg-slate-950 border border-slate-800 rounded-xl text-xs text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500 transition-colors\"\n            />\n          </div>\n\n          {/* Quick Import & Stream Actions */}\n          <div className=\"flex items-center gap-1.5 shrink-0\">\n            {/* Native Local File Import */}\n            <label\n              className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 cursor-pointer transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Play local video from device\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span className=\"hidden sm:inline\">Open File</span>\n              <input\n                type=\"file\"\n                accept=\"video/*,audio/*\"\n                onChange={handleFileInputChange}\n                className=\"hidden\"\n              />\n            </label>\n\n            {/* Network Stream URL */}\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span className=\"hidden sm:inline\">Network Stream</span>\n            </button>\n\n            {/* View Mode Toggle */}\n            <div className=\"flex items-center bg-slate-950 rounded-lg p-0.5 border border-slate-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-md transition-colors ${\n                  viewMode === \'grid\' ? \'bg-blue-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"Grid View\"\n              >\n                <LayoutGrid className=\"w-3.5 h-3.5\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-md transition-colors ${\n                  viewMode === \'list\' ? \'bg-blue-600 text-white\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"List View\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>"
        replacement_content: "      {/* Top Action Toolbar */}\n      <div className=\"p-3 bg-slate-900 border-b border-slate-800 flex flex-col gap-2.5 shrink-0\">\n        {/* Row 1: Complete Line Search Bar */}\n        <div className=\"relative w-full\">\n          <Search className=\"absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-blue-400 pointer-events-none\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search local and streamed videos by title...\"\n            value={searchQuery}\n            onChange={(e) => setSearchQuery(e.target.value)}\n            className=\"w-full h-10 pl-10 pr-9 bg-slate-950/90 border border-slate-800 focus:border-blue-500 rounded-2xl text-xs text-slate-100 placeholder:text-slate-500 focus:outline-none transition-all shadow-inner\"\n          />\n          {searchQuery && (\n            <button\n              onClick={() => setSearchQuery(\'\')}\n              className=\"absolute right-3 top-1/2 -translate-y-1/2 p-1 rounded-full text-slate-400 hover:text-white hover:bg-slate-800 transition-colors\"\n              title=\"Clear search\"\n            >\n              <X className=\"w-3.5 h-3.5\" />\n            </button>\n          )}\n        </div>\n\n        {/* Row 2: Actions & View Controls Strip */}\n        <div className=\"flex items-center justify-between gap-2\">\n          {/* Quick Import & Stream Actions */}\n          <div className=\"flex items-center gap-1.5\">\n            {/* Native Local File Import */}\n            <label\n              className=\"px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 cursor-pointer transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Play local video from device\"\n            >\n              <Upload className=\"w-3.5 h-3.5 text-blue-400\" />\n              <span>Open File</span>\n              <input\n                type=\"file\"\n                accept=\"video/*,audio/*\"\n                onChange={handleFileInputChange}\n                className=\"hidden\"\n              />\n            </label>\n\n            {/* Network Stream URL */}\n            <button\n              onClick={onOpenStreamDialog}\n              className=\"px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 transition-colors border border-slate-700 flex items-center gap-1.5 text-xs font-semibold\"\n              title=\"Stream Network URL\"\n            >\n              <Radio className=\"w-3.5 h-3.5 text-cyan-400\" />\n              <span>Stream URL</span>\n            </button>\n          </div>\n\n          {/* Sort Selector & View Mode Toggle */}\n          <div className=\"flex items-center gap-1.5\">\n            <select\n              value={sortBy}\n              onChange={(e) => setSortBy(e.target.value as any)}\n              className=\"bg-slate-950 text-slate-300 text-[11px] font-medium border border-slate-800 rounded-xl px-2 py-1.5 focus:outline-none focus:border-blue-500 cursor-pointer\"\n            >\n              <option value=\"date\">Latest</option>\n              <option value=\"name\">Name</option>\n              <option value=\"size\">Size</option>\n              <option value=\"duration\">Duration</option>\n            </select>\n\n            <div className=\"flex items-center bg-slate-950 rounded-xl p-0.5 border border-slate-800\">\n              <button\n                onClick={() => setViewMode(\'grid\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'grid\' ? \'bg-blue-600 text-white shadow-sm\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"Grid View\"\n              >\n                <LayoutGrid className=\"w-3.5 h-3.5\" />\n              </button>\n              <button\n                onClick={() => setViewMode(\'list\')}\n                className={`p-1.5 rounded-lg transition-colors ${\n                  viewMode === \'list\' ? \'bg-blue-600 text-white shadow-sm\' : \'text-slate-400 hover:text-white\'\n                }`}\n                title=\"List View\"\n              >\n                <List className=\"w-3.5 h-3.5\" />\n              </button>\n            </div>\n          </div>\n        </div>"
        start_line: 89
        end_line: 156
      }
      num_matches: 1
    }
    description: "Place search bar on its own complete line in FileBrowser toolbar"
