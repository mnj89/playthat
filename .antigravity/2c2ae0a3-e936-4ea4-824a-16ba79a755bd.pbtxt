  view_file {
    absolute_path_uri: "file:///src/components/PWAInstallModal.tsx"
    end_line: 99
    content: "import React, { useState } from \'react\';\nimport {\n  Smartphone,\n  Download,\n  Share2,\n  PlusSquare,\n  MoreVertical,\n  Check,\n  Copy,\n  ExternalLink,\n  X,\n  QrCode,\n  ShieldCheck,\n  Sparkles,\n} from \'lucide-react\';\nimport { usePWAInstall } from \'../hooks/usePWAInstall\';\nimport { PlayThatIcon } from \'./PlayThatIcon\';\n\ninterface PWAInstallModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onShowToast?: (msg: string) => void;\n}\n\nexport const PWAInstallModal: React.FC<PWAInstallModalProps> = ({\n  isOpen,\n  onClose,\n  onShowToast,\n}) => {\n  const { isInstallable, isInstalled, isIOS, isAndroid, install } = usePWAInstall();\n  const [activeTab, setActiveTab] = useState<\'android\' | \'ios\' | \'qr\'>(\'android\');\n  const [copied, setCopied] = useState(false);\n\n  if (!isOpen) return null;\n\n  const appUrl = window.location.origin || \'https://ais-pre-mysyyuwzneh24y2ka6wxcs-69242674592.asia-east1.run.app\';\n\n  const handleCopyUrl = async () => {\n    try {\n      await navigator.clipboard.writeText(appUrl);\n      setCopied(true);\n      if (onShowToast) onShowToast(\'Link copied! Open on your phone browser.\');\n      setTimeout(() => setCopied(false), 2500);\n    } catch {\n      if (onShowToast) onShowToast(\'Failed to copy link\');\n    }\n  };\n\n  const handleInstallClick = async () => {\n    const success = await install();\n    if (success) {\n      if (onShowToast) onShowToast(\'PlayThat! PRO installed successfully!\');\n      onClose();\n    }\n  };\n\n  return (\n    <div\n      onClick={onClose}\n      className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-4 animate-in fade-in duration-200\"\n    >\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-lg bg-zinc-950 border border-zinc-800 rounded-3xl p-6 shadow-2xl flex flex-col gap-5 text-zinc-100 max-h-[90vh] overflow-y-auto\"\n      >\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-zinc-850 pb-4\">\n          <div className=\"flex items-center gap-3\">\n            <PlayThatIcon size={36} />\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-base font-bold text-white tracking-tight\">Install PlayThat! on Phone</h3>\n                <span className=\"px-1.5 py-0.5 rounded bg-orange-500/10 border border-orange-500/40 text-orange-400 text-[10px] font-mono font-bold\">\n                  PWA\n                </span>\n              </div>\n              <p className=\"text-xs text-zinc-400 mt-0.5\">\n                Run natively full-screen with offline support & MX gestures\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Installed Status Badge */}\n        {isInstalled && (\n          <div className=\"p-3 rounded-2xl bg-emerald-950/40 border border-emerald-500/40 flex items-center gap-3 text-emerald-400 text-xs\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-400 shrink-0\" />\n            <span>\n              <strong>Application is installed!</strong> You are currently running PlayThat! in standalone native app mode.\n            </span>\n          </div>\n        )}\n\n        {/* Direct One-Click Install Button (When browser supports beforeinstallprompt) */}"
    num_lines: 333
