  planner_response {
    thinking: "**Designing the UC Download Manager**\n\nI\'m now diving into the UI for the UC Browser-style Download Manager, focusing on `src/components/UCDownloadManager.tsx`. I\'m breaking down key features like tabs for \"Downloading\" and \"Completed\" downloads, and I\'m adding a counter for each. I\'m also considering how to implement a \"UC Fast Download\" or \"Turbo Speed\" toggle to match the original.\n\n\n"
    tool_calls {
      id: "call_260229"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState, useEffect } from \'react\';\\nimport {\\n  Download,\\n  Pause,\\n  Play,\\n  RotateCcw,\\n  Trash2,\\n  Plus,\\n  Zap,\\n  CheckCircle2,\\n  FileVideo,\\n  X,\\n  ExternalLink,\\n  Shield,\\n  FolderDown,\\n  Layers,\\n  ArrowDownToLine,\\n} from \'lucide-react\';\\nimport { downloadManager } from \'../services/downloadManagerService\';\\nimport { DownloadTask, MediaItem } from \'../types\';\\n\\ninterface UCDownloadManagerProps {\\n  onPlayMedia: (item: MediaItem) => void;\\n  onSaveToVault?: (item: MediaItem) => void;\\n}\\n\\nexport const UCDownloadManager: React.FC<UCDownloadManagerProps> = ({\\n  onPlayMedia,\\n  onSaveToVault,\\n}) => {\\n  const [tasks, setTasks] = useState<DownloadTask[]>([]);\\n  const [activeTab, setActiveTab] = useState<\'downloading\' | \'completed\'>(\'downloading\');\\n  const [turboMode, setTurboMode] = useState<boolean>(downloadManager.isTurboMode());\\n  const [showAddModal, setShowAddModal] = useState<boolean>(false);\\n  const [newUrlInput, setNewUrlInput] = useState<string>(\'\');\\n  const [newTitleInput, setNewTitleInput] = useState<string>(\'\');\\n\\n  useEffect(() => {\\n    const unsubscribe = downloadManager.subscribe((updatedTasks) => {\\n      setTasks(updatedTasks);\\n    });\\n    return unsubscribe;\\n  }, []);\\n\\n  const downloadingTasks = tasks.filter((t) => t.status !== \'completed\');\\n  const completedTasks = tasks.filter((t) => t.status === \'completed\');\\n\\n  const formatBytes = (bytes: number) => {\\n    if (bytes === 0 || isNaN(bytes)) return \'0 B\';\\n    const k = 1024;\\n    const sizes = [\'B\', \'KB\', \'MB\', \'GB\'];\\n    const i = Math.floor(Math.log(bytes) / Math.log(k));\\n    return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;\\n  };\\n\\n  const formatSpeed = (bytesPerSec: number) => {\\n    if (bytesPerSec <= 0 || isNaN(bytesPerSec)) return \'0 KB/s\';\\n    return `${formatBytes(bytesPerSec)}/s`;\\n  };\\n\\n  const handleToggleTurbo = () => {\\n    const next = !turboMode;\\n    setTurboMode(next);\\n    downloadManager.setTurboMode(next);\\n  };\\n\\n  const handleAddNewDownload = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!newUrlInput.trim()) return;\\n    downloadManager.addDownload(newUrlInput.trim(), newTitleInput.trim() || undefined);\\n    setNewUrlInput(\'\');\\n    setNewTitleInput(\'\');\\n    setShowAddModal(false);\\n    setActiveTab(\'downloading\');\\n  };\\n\\n  const handlePlayCompleted = (task: DownloadTask) => {\\n    const mediaItem: MediaItem = {\\n      id: `task-${task.id}`,\\n      title: task.title,\\n      folder: \'Downloads\',\\n      sourceType: \'downloaded\',\\n      url: task.outputBlobUrl || task.url,\\n      thumbnailUrl:\\n        task.thumbnailUrl ||\\n        \'https://images.unsplash.com/photo-1574717024653-61fd2cf4d44d?auto=format&fit=crop&w=600&q=80\',\\n      duration: task.duration || 120,\\n      currentTime: 0,\\n      resolution: \'1080p FHD\',\\n      fileSize: task.totalBytes,\\n      codec: task.type === \'m3u8\' ? \'HLS Remuxed\' : \'H.264 MP4\',\\n      decoder: \'HW\',\\n      createdAt: task.createdAt,\\n      isFavorite: false,\\n      isEncrypted: false,\\n    };\\n    onPlayMedia(mediaItem);\\n  };\\n\\n  return (\\n    <div className=\\\"flex-1 w-full flex flex-col bg-slate-950 text-slate-100 overflow-hidden\\\">\\n      {/* UC Browser-Style Top Header Strip */}\\n      <div className=\\\"p-4 bg-slate-900 border-b border-slate-800 flex flex-col gap-3 shrink-0\\\">\\n        <div className=\\\"flex items-center justify-between\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <div className=\\\"w-8 h-8 rounded-xl bg-blue-600/20 border border-blue-500/30 flex items-center justify-center text-blue-400\\\">\\n              <ArrowDownToLine className=\\\"w-4 h-4\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-sm font-bold text-white leading-tight\\\">\\n                UC Turbo Download Manager\\n              </h3>\\n              <span className=\\\"text-[10px] font-mono text-slate-400\\\">\\n                Direct MP4 & Multi-threaded HLS Streams\\n              </span>\\n            </div>\\n          </div>\\n\\n          {/* UC Turbo Boost Toggle Button */}\\n          <button\\n            onClick={handleToggleTurbo}\\n            className={`px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm ${\\n              turboMode\\n                ? \'bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 shadow-amber-500/20 ring-2 ring-amber-400/40\'\\n                : \'bg-slate-800 text-slate-400 hover:text-white border border-slate-700\'\\n            }`}\\n            title=\\\"Toggle UC Cloud Acceleration Engine\\\"\\n          >\\n            <Zap className={`w-3.5 h-3.5 ${turboMode ? \'fill-slate-950\' : \'\'}`} />\\n            <span>Turbo Boost: {turboMode ? \'ON\' : \'OFF\'}</span>\\n          </button>\\n        </div>\\n\\n        {/* Tab Buttons & New Action */}\\n        <div className=\\\"flex items-center justify-between gap-2 pt-1\\\">\\n          <div className=\\\"flex items-center bg-slate-950/80 p-1 rounded-xl border border-slate-800\\\">\\n            <button\\n              onClick={() => setActiveTab(\'downloading\')}\\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${\\n                activeTab === \'downloading\'\\n                  ? \'bg-blue-600 text-white shadow-sm\'\\n                  : \'text-slate-400 hover:text-white\'\\n              }`}\\n            >\\n              <span>Downloading</span>\\n              {downloadingTasks.length > 0 && (\\n                <span className=\\\"px-1.5 py-0.2 text-[10px] bg-blue-900 text-blue-200 rounded-full font-mono\\\">\\n                  {downloadingTasks.length}\\n                </span>\\n              )}\\n            </button>\\n            <button\\n              onClick={() => setActiveTab(\'completed\')}\\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${\\n                activeTab === \'completed\'\\n                  ? \'bg-blue-600 text-white shadow-sm\'\\n                  : \'text-slate-400 hover:text-white\'\\n              }`}\\n            >\\n              <span>Completed</span>\\n              {completedTasks.length > 0 && (\\n                <span className=\\\"px-1.5 py-0.2 text-[10px] bg-slate-800 text-emerald-400 rounded-full font-mono\\\">\\n                  {completedTasks.length}\\n                </span>\\n              )}\\n            </button>\\n          </div>\\n\\n          <button\\n            onClick={() => setShowAddModal(true)}\\n            className=\\\"px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-sm\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            <span>Add URL</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* Task List Container */}\\n      <div className=\\\"flex-1 overflow-y-auto p-4 flex flex-col gap-3\\\">\\n        {activeTab === \'downloading\' ? (\\n          downloadingTasks.length === 0 ? (\\n            <div className=\\\"flex-1 flex flex-col items-center justify-center p-8 text-center gap-3 text-slate-400\\\">\\n              <FolderDown className=\\\"w-12 h-12 text-slate-700\\\" />\\n              <div className=\\\"flex flex-col\\\">\\n                <span className=\\\"text-sm font-semibold text-white\\\">No active downloads</span>\\n                <span className=\\\"text-xs text-slate-400 mt-1 max-w-xs\\\">\\n                  Download MP4 movies, music videos, or HLS stream captures directly using the browser or Add URL button.\\n                </span>\\n              </div>\\n              <button\\n                onClick={() => setShowAddModal(true)}\\n                className=\\\"mt-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 border border-slate-700 transition-colors\\\"\\n              >\\n                Start New Download\\n              </button>\\n            </div>\\n          ) : (\\n            downloadingTasks.map((task) => (\\n              <div\\n                key={task.id}\\n                className=\\\"p-4 rounded-2xl bg-slate-900 border border-slate-800 shadow-md flex flex-col gap-3 hover:border-slate-700 transition-colors\\\"\\n              >\\n                <div className=\\\"flex items-start justify-between gap-3\\\">\\n                  <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                    <div className=\\\"w-10 h-10 rounded-xl bg-blue-600/15 border border-blue-500/20 flex items-center justify-center shrink-0 text-blue-400\\\">\\n                      <FileVideo className=\\\"w-5 h-5\\\" />\\n                    </div>\\n                    <div className=\\\"flex flex-col min-w-0\\\">\\n                      <span className=\\\"text-xs font-bold text-white truncate max-w-xs\\\">\\n                        {task.title}\\n                      </span>\\n                      <span className=\\\"text-[11px] font-mono text-slate-400\\\">\\n                        {task.type.toUpperCase()} \302\267 /PlayThat/Downloads\\n                      </span>\\n                    </div>\\n                  </div>\\n\\n                  {/* Task Control Buttons */}\\n                  <div className=\\\"flex items-center gap-1.5 shrink-0\\\">\\n                    {task.status === \'downloading\' ? (\\n                      <button\\n                        onClick={() => downloadManager.pauseDownload(task.id)}\\n                        className=\\\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors\\\"\\n                        title=\\\"Pause\\\"\\n                      >\\n                        <Pause className=\\\"w-3.5 h-3.5\\\" />\\n                      </button>\\n                    ) : (\\n                      <button\\n                        onClick={() => downloadManager.resumeDownload(task.id)}\\n                        className=\\\"p-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white transition-colors\\\"\\n                        title=\\\"Resume\\\"\\n                      >\\n                        <Play className=\\\"w-3.5 h-3.5 fill-white\\\" />\\n                      </button>\\n                    )}\\n                    <button\\n                      onClick={() => downloadManager.cancelDownload(task.id)}\\n                      className=\\\"p-2 rounded-xl bg-slate-800 hover:bg-red-950/60 text-slate-400 hover:text-red-400 transition-colors\\\"\\n                      title=\\\"Cancel\\\"\\n                    >\\n                      <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                {/* Progress Bar & Stats */}\\n                <div className=\\\"flex flex-col gap-1.5\\\">\\n                  <div className=\\\"w-full h-2 bg-slate-950 rounded-full overflow-hidden p-0.5\\\">\\n                    <div\\n                      className={`h-full rounded-full transition-all duration-200 ${\\n                        task.status === \'paused\'\\n                          ? \'bg-amber-500\'\\n                          : \'bg-gradient-to-r from-blue-500 to-cyan-400\'\\n                      }`}\\n                      style={{ width: `${task.progress}%` }}\\n                    />\\n                  </div>\\n\\n                  <div className=\\\"flex items-center justify-between text-[11px] font-mono text-slate-400\\\">\\n                    <span>\\n                      {formatBytes(task.downloadedBytes)} / {formatBytes(task.totalBytes)} ({task.progress}%)\\n                    </span>\\n                    <span className=\\\"font-semibold text-cyan-400\\\">\\n                      {task.status === \'paused\' ? \'PAUSED\' : formatSpeed(task.speedBytesPerSec)}\\n                    </span>\\n                  </div>\\n                </div>\\n              </div>\\n            ))\\n          )\\n        ) : completedTasks.length === 0 ? (\\n          <div className=\\\"flex-1 flex flex-col items-center justify-center p-8 text-center gap-3 text-slate-400\\\">\\n            <CheckCircle2 className=\\\"w-12 h-12 text-slate-700\\\" />\\n            <span className=\\\"text-sm font-semibold text-white\\\">No completed downloads</span>\\n            <span className=\\\"text-xs text-slate-400 max-w-xs\\\">\\n              Finished videos will appear here with instant offline playback and private vault encryption.\\n            </span>\\n          </div>\\n        ) : (\\n          <div className=\\\"flex flex-col gap-3\\\">\\n            <div className=\\\"flex items-center justify-between pb-1\\\">\\n              <span className=\\\"text-xs font-semibold text-slate-400 uppercase\\\">\\n                Finished Files ({completedTasks.length})\\n              </span>\\n              <button\\n                onClick={() => downloadManager.clearCompleted()}\\n                className=\\\"text-xs text-slate-400 hover:text-red-400 transition-colors\\\"\\n              >\\n                Clear History\\n              </button>\\n            </div>\\n\\n            {completedTasks.map((task) => (\\n              <div\\n                key={task.id}\\n                className=\\\"p-4 rounded-2xl bg-slate-900 border border-slate-800 shadow-sm flex items-center justify-between gap-3 hover:border-slate-700 transition-colors\\\"\\n              >\\n                <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n                  <div className=\\\"w-10 h-10 rounded-xl bg-emerald-500/15 border border-emerald-500/20 flex items-center justify-center shrink-0 text-emerald-400\\\">\\n                    <CheckCircle2 className=\\\"w-5 h-5\\\" />\\n                  </div>\\n                  <div className=\\\"flex flex-col min-w-0\\\">\\n                    <span className=\\\"text-xs font-bold text-white truncate max-w-xs\\\">\\n                      {task.title}\\n                    </span>\\n                    <span className=\\\"text-[11px] font-mono text-slate-400\\\">\\n                      {formatBytes(task.totalBytes)} \302\267 {task.type.toUpperCase()}\\n                    </span>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                  <button\\n                    onClick={() => handlePlayCompleted(task)}\\n                    className=\\\"px-3 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold flex items-center gap-1.5 shadow-sm transition-colors\\\"\\n                  >\\n                    <Play className=\\\"w-3.5 h-3.5 fill-white\\\" />\\n                    <span>Play</span>\\n                  </button>\\n\\n                  <a\\n                    href={task.outputBlobUrl || task.url}\\n                    download={task.title}\\n                    className=\\\"p-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 transition-colors\\\"\\n                    title=\\\"Save to Device\\\"\\n                  >\\n                    <Download className=\\\"w-4 h-4\\\" />\\n                  </a>\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Add New Download Modal */}\\n      {showAddModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-sm animate-in fade-in duration-200\\\">\\n          <div className=\\\"w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl p-6 shadow-2xl flex flex-col gap-4\\\">\\n            <div className=\\\"flex items-center justify-between border-b border-slate-800 pb-3\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <Download className=\\\"w-5 h-5 text-blue-400\\\" />\\n                <h4 className=\\\"text-sm font-bold text-white\\\">Direct MP4 / M3U8 Downloader</h4>\\n              </div>\\n              <button\\n                onClick={() => setShowAddModal(false)}\\n                className=\\\"p-1 rounded-full text-slate-400 hover:text-white\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleAddNewDownload} className=\\\"flex flex-col gap-3\\\">\\n              <div className=\\\"flex flex-col gap-1\\\">\\n                <label className=\\\"text-xs font-medium text-slate-300\\\">Video Download Link (URL)</label>\\n                <input\\n                  type=\\\"url\\\"\\n                  required\\n                  placeholder=\\\"https://example.com/movie.mp4 or .m3u8\\\"\\n                  value={newUrlInput}\\n                  onChange={(e) => setNewUrlInput(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-xs font-mono text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"flex flex-col gap-1\\\">\\n                <label className=\\\"text-xs font-medium text-slate-300\\\">File Name (Optional)</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  placeholder=\\\"e.g. Action_Clip_1080p.mp4\\\"\\n                  value={newTitleInput}\\n                  onChange={(e) => setNewTitleInput(e.target.value)}\\n                  className=\\\"w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-xl text-xs text-slate-200 placeholder:text-slate-500 focus:outline-none focus:border-blue-500\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"p-3 rounded-xl bg-slate-950 border border-slate-800 text-[11px] text-slate-400 flex flex-col gap-1\\\">\\n                <span className=\\\"font-semibold text-slate-300\\\">Quick Test Links:</span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setNewUrlInput(\'https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerBlazes.mp4\');\\n                    setNewTitleInput(\'For Bigger Blazes 1080p.mp4\');\\n                  }}\\n                  className=\\\"text-left text-blue-400 hover:underline truncate\\\"\\n                >\\n                  \342\200\242 ForBiggerBlazes.mp4 (Fast 18 MB sample)\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setNewUrlInput(\'https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8\');\\n                    setNewTitleInput(\'Mux HLS Stream Capture.m3u8\');\\n                  }}\\n                  className=\\\"text-left text-cyan-400 hover:underline truncate\\\"\\n                >\\n                  \342\200\242 Mux HLS Big Buck Bunny (M3U8 Stream)\\n                </button>\\n              </div>\\n\\n              <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddModal(false)}\\n                  className=\\\"px-4 py-2 rounded-xl bg-slate-800 text-xs font-semibold text-slate-300 hover:bg-slate-700\\\"\\n                >\\n                  Cancel\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"px-5 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs font-semibold text-white shadow-md\\\"\\n                >\\n                  Start Download\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Implement UC Browser-style download manager with Turbo mode and direct MP4 downloads\", \"Overwrite\":true, \"TargetFile\":\"/src/components/UCDownloadManager.tsx\", \"toolAction\":\"Writing UCDownloadManager component\", \"toolSummary\":\"Create src/components/UCDownloadManager.tsx\"}"
