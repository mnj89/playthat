    content: "                  {/* Play Overlay */}\n                  <div className=\"absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <div className=\"w-12 h-12 rounded-full bg-blue-600/90 text-white flex items-center justify-center shadow-lg transform group-hover:scale-110 transition-transform\">\n                      <Play className=\"w-5 h-5 fill-white translate-x-0.5\" />\n                    </div>\n                  </div>\n\n                  {/* Duration Pill */}\n                  <div className=\"absolute bottom-2 right-2 px-1.5 py-0.5 rounded-md bg-black/80 text-[10px] font-mono font-bold text-white tracking-wide\">\n                    {formatDuration(item.duration)}\n                  </div>\n\n                  {/* Resolution & Decoder Badges */}\n                  <div className=\"absolute top-2 left-2 flex items-center gap-1\">\n                    <span className=\"px-1.5 py-0.5 rounded bg-blue-950/80 border border-blue-800 text-[9px] font-mono font-bold text-blue-300\">\n                      {item.resolution}\n                    </span>\n                    <span className=\"px-1 py-0.5 rounded bg-slate-900/80 border border-slate-700 text-[9px] font-mono text-cyan-300\">\n                      {item.decoder}\n                    </span>\n                  </div>\n\n                  {/* Favorite indicator */}\n                  {item.isFavorite && (\n                    <div className=\"absolute top-2 right-2 p-1 rounded-full bg-black/60 text-red-400\">\n                      <Heart className=\"w-3.5 h-3.5 fill-red-400\" />\n                    </div>\n                  )}\n\n                  {/* Watch progress bar if partially played */}\n                  {item.currentTime > 0 && item.duration > 0 && (\n                    <div className=\"absolute bottom-0 left-0 right-0 h-1 bg-slate-800\">\n                      <div\n                        className=\"h-full bg-blue-500\"\n                        style={{ width: `${(item.currentTime / item.duration) * 100}%` }}\n                      />"
