            }
            lines {
              text: "  const cycleAspectRatio = () => {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    const modes: AspectRatioMode[] = [\'fit\', \'stretch\', \'16:9\', \'4:3\', \'zoom\'];"
