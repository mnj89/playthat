              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {/* How to Install Downloaded APK on Phone */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span className=\"font-bold text-white flex items-center gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <FileCheck className=\"w-4 h-4 text-orange-400\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                How to install the downloaded .APK on your Android phone:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <ol className=\"list-decimal pl-5 space-y-1.5 text-zinc-400 text-xs\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <li>Download the generated <strong className=\"text-zinc-200\">PlayThat.apk</strong> file.</li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <li>Tap the downloaded file in your browser or Android File Manager.</li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  If prompted with <em>\"Install unknown apps\"</em>, toggle <strong className=\"text-orange-400\">Allow from this source</strong> in Android Settings."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                </li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <li>Tap <strong className=\"text-white\">Install</strong> to complete!</li>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </ol>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        )}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {/* Tab 2: Android Automatic WebAPK (Zero-download native APK) */}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        {activeTab === \'webapk\' && ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"flex flex-col gap-3.5 text-xs text-zinc-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <span className=\"font-bold text-white flex items-center gap-2\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                <Smartphone className=\"w-4 h-4 text-orange-400\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                What is an Android WebAPK?"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </span>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <p className=\"text-zinc-400 leading-relaxed\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                When you tap <strong>\"Install app\"</strong> in Chrome on Android, Google Chrome automatically mints a signed Android Package (<code className=\"text-orange-400 font-mono text-[11px]\">org.chromium.webapk.*.apk</code>) and installs it directly via the Android Package Manager."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <div className=\"p-2.5 rounded-xl bg-black/60 border border-zinc-800 text-[11px] text-zinc-300\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                It appears in Android <strong>Settings &gt; Apps</strong>, has its own notification channel, and runs natively with full-screen gesture support."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
