            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "## 5. Implementation Sequence & Milestones"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "1. **Brand Identity & Iconography**: Design the custom **PlayThat!** icon, SVG branding, and update `metadata.json` and `index.html`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "2. **Core App Shell & Android Frame**: Implement responsive container with Android status bar, dynamic island/notch, navigation bar, and dark/light mode toggle."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "3. **MX Gesture Video Player**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Dual-edge vertical gesture handlers for Brightness (left) and Volume (right) with HUD overlays."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Horizontal scrub gesture for time delta seeking."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Decoder switch (`HW`, `HW+`, `SW`), WebGL post-processing filter pipeline, playback speed, aspect ratio options, and screen lock."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "4. **Custom Subtitle Engine**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Full `.srt` and `.vtt` file loader and parser."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Live subtitle rendering with customizable font size, text/background/outline colors, and time sync offset."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "5. **In-App Browser & M3U8 Stream Downloader**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Chromium-like navigation bar with URL entry, search, and sample stream catalog."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Automated stream sniffer detecting `.m3u8` playlists and media streams."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Download manager with segment-by-segment progress bar and MP4 packaging."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Express backend proxy (`/api/stream-proxy`) for handling CORS-protected streams."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "6. **Encrypted Private Vault**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - WebCrypto AES-GCM 256-bit encryption/decryption module."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - PIN entry and 3x3 pattern lock dialogs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - One-tap Emergency Disguise (Calculator mockup)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Secure import/export and vault file viewer."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "7. **File Browser, Playlists & Network Streaming**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Folder structure, search, sorting (date, name, size), and batch actions."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Custom playlist creation and reordering."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Direct network stream URL input (HLS/MP4/DASH)."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "8. **Verification & Polish**:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Test touch and mouse gestures, theme switching, download pipeline, and vault encryption."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "   - Run compilation verification and final UI polish."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
          }
