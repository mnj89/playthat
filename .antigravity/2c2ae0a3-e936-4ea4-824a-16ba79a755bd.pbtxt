  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  ChevronDown,\n  Play,\n  Pause,\n  SkipBack,\n  SkipForward,\n  Shuffle,\n  Repeat,\n  Repeat1,\n  Volume2,\n  VolumeX,\n  ListMusic,\n  Heart,\n  Sparkles,\n  Music2,\n  Sliders,\n  Check,\n  X,\n} from \'lucide-react\';\nimport { AudioPlayerState, audioPlayerService } from \'../services/audioPlayerService\';\nimport { MediaItem } from \'../types\';\n\ninterface MusicPlayerModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  state: AudioPlayerState;\n  onOpenEnhancements: () => void;\n  onToggleFavorite?: (mediaId: string) => void;\n}\n\nexport const MusicPlayerModal: React.FC<MusicPlayerModalProps> = ({\n  isOpen,\n  onClose,\n  state,\n  onOpenEnhancements,\n  onToggleFavorite,\n}) => {\n  const [isQueueOpen, setIsQueueOpen] = useState<boolean>(false);\n  const [isDraggingSeek, setIsDraggingSeek] = useState<boolean>(false);\n  const [seekValue, setSeekValue] = useState<number>(0);\n\n  if (!isOpen || !state.currentTrack) return null;\n\n  const { currentTrack, isPlaying, currentTime, duration, volume, isShuffle, loopMode, queue, queueIndex } = state;\n\n  const activeTime = isDraggingSeek ? seekValue : currentTime;\n  const progressPercent = duration > 0 ? (activeTime / duration) * 100 : 0;\n\n  const formatTime = (secs: number) => {\n    if (isNaN(secs) || secs < 0) return \'0:00\';\n    const m = Math.floor(secs / 60);\n    const s = Math.floor(secs % 60);\n    return `${m}:${s < 10 ? \'0\' : \'\'}${s}`;\n  };\n\n  const remainingTime = Math.max(0, duration - activeTime);\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/90 backdrop-blur-2xl animate-in fade-in zoom-in-95 duration-200 select-none overflow-hidden\">\n      <div className=\"w-full h-full max-w-lg flex flex-col justify-between p-5 sm:p-6 bg-gradient-to-b from-slate-900 via-[#0a0c14] to-black text-white relative\">\n        {/* Top Header Bar */}\n        <div className=\"flex items-center justify-between z-10 pt-1\">\n          <button\n            onClick={onClose}\n            className=\"p-2 -ml-2 rounded-full text-slate-400 hover:text-white hover:bg-white/10 active:scale-95 transition-all\"\n            title=\"Minimize Player\"\n            aria-label=\"Minimize\"\n          >\n            <ChevronDown className=\"w-6 h-6\" />\n          </button>\n\n          <div className=\"flex flex-col items-center\">\n            <span className=\"text-[10px] uppercase font-bold tracking-widest text-slate-400\">\n              Playing from {currentTrack.folder || \'Library\'}\n            </span>\n            <span className=\"text-xs font-semibold text-slate-200\">PlayThat! Hi-Res Audio</span>\n          </div>\n\n          <div className=\"flex items-center gap-1\">\n            <button\n              onClick={onOpenEnhancements}\n              className=\"p-2 rounded-full text-cyan-400 hover:text-white hover:bg-white/10 active:scale-95 transition-all\"\n              title=\"Audio Enhancements & 200% Boost\"\n            >\n              <Sparkles className=\"w-5 h-5\" />\n            </button>\n            <button\n              onClick={() => setIsQueueOpen(!isQueueOpen)}\n              className={`p-2 rounded-full transition-all ${\n                isQueueOpen ? \'text-blue-400 bg-blue-950/60\' : \'text-slate-400 hover:text-white hover:bg-white/10\'\n              }`}\n              title=\"Playback Queue\"\n            >\n              <ListMusic className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* Main Content: Center Artwork or Queue View */}\n        {isQueueOpen ? (\n          /* Queue Drawer */\n          <div className=\"flex-1 my-4 flex flex-col bg-slate-900/80 border border-slate-800 rounded-3xl p-4 overflow-hidden backdrop-blur-md animate-in fade-in duration-150\">\n            <div className=\"flex items-center justify-between pb-3 border-b border-slate-800\">\n              <div className=\"flex items-center gap-2\">\n                <ListMusic className=\"w-4 h-4 text-blue-400\" />\n                <h4 className=\"text-sm font-bold text-white\">Up Next ({queue.length})</h4>\n              </div>\n              <button\n                onClick={() => setIsQueueOpen(false)}\n                className=\"p-1 rounded-full text-slate-400 hover:text-white\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"flex-1 overflow-y-auto divide-y divide-slate-800/40 my-2 pr-1\">\n              {queue.map((item, idx) => {\n                const isCurrent = item.id === currentTrack.id;\n                return (\n                  <button\n                    key={item.id}\n                    onClick={() => {\n                      audioPlayerService.playTrack(item, queue);\n                    }}\n                    className={`w-full flex items-center gap-3 p-2.5 rounded-xl text-left transition-colors ${\n                      isCurrent\n                        ? \'bg-blue-600/20 text-blue-300 font-semibold\'\n                        : \'hover:bg-white/5 text-slate-300\'\n                    }`}\n                  >\n                    <div className=\"w-6 text-center text-xs text-slate-500 font-mono\">\n                      {isCurrent ? (\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-blue-400 mx-auto animate-ping\" />\n                      ) : (\n                        idx + 1\n                      )}\n                    </div>\n                    <img\n                      src={item.thumbnailUrl}\n                      alt={item.title}\n                      referrerPolicy=\"no-referrer\"\n                      className=\"w-10 h-10 rounded-lg object-cover bg-slate-800 shrink-0\"\n                    />\n                    <div className=\"flex flex-col min-w-0 flex-1\">\n                      <span className=\"text-xs truncate\">{item.title}</span>\n                      <span className=\"text-[11px] text-slate-500 truncate\">\n                        {item.artist || item.folder}\n                      </span>\n                    </div>\n                    <span className=\"text-[11px] font-mono text-slate-500 shrink-0\">\n                      {formatTime(item.duration)}\n                    </span>\n                  </button>\n                );\n              })}\n            </div>\n          </div>\n        ) : (\n          /* Album Artwork + Soundwaves */\n          <div className=\"flex-1 flex flex-col items-center justify-center my-4\">\n            <div className=\"relative w-64 h-64 sm:w-72 sm:h-72 rounded-[36px] overflow-hidden shadow-2xl border border-white/10 group\">\n              <img\n                src={currentTrack.thumbnailUrl}\n                alt={currentTrack.title}\n                referrerPolicy=\"no-referrer\"\n                className={`w-full h-full object-cover transition-transform duration-1000 ${\n                  isPlaying ? \'scale-105\' : \'scale-100\'\n                }`}\n              />\n\n              {/* Ambient Glow */}\n              <div\n                className=\"absolute -inset-10 -z-10 rounded-full blur-3xl opacity-40 bg-gradient-to-tr from-blue-600 to-cyan-500 pointer-events-none\"\n              />\n\n              {/* Live Soundwave Equalizer Overlay */}\n              {isPlaying && (\n                <div className=\"absolute bottom-3 left-4 right-4 flex items-end justify-center gap-1.5 h-8 bg-black/40 backdrop-blur-md rounded-2xl px-3 py-1.5 border border-white/10\">\n                  {[40, 75, 55, 90, 65, 80, 45, 95, 60, 85, 50, 70].map((h, i) => (\n                    <div\n                      key={i}\n                      className=\"w-1 rounded-full bg-gradient-to-t from-cyan-400 to-blue-400 transition-all duration-300\"\n                      style={{\n                        height: `${Math.max(15, (h * (0.6 + Math.sin(Date.now() / 200 + i) * 0.4)))}%`,\n                      }}\n                    />\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Audio Format Pill */}\n            <div className=\"mt-5 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/80 text-[11px] font-mono text-cyan-300\">\n              <span className=\"w-2 h-2 rounded-full bg-cyan-400 animate-pulse\" />\n              <span>{currentTrack.codec || \'MP3 \302\267 320 KBPS \302\267 44.1 KHZ\'}</span>\n              <span>\302\267</span>\n              <span className=\"text-slate-400 font-sans\">HI-RES</span>\n            </div>\n          </div>\n        )}\n\n        {/* Track Metadata & Favorite */}\n        <div className=\"flex items-center justify-between gap-4 px-1 mb-2\">\n          <div className=\"flex flex-col min-w-0\">\n            <h3 className=\"text-lg font-bold text-white tracking-wide truncate\">\n              {currentTrack.title}\n            </h3>\n            <p className=\"text-xs text-slate-400 truncate mt-0.5\">\n              {currentTrack.artist || \'Unknown Artist\'} {currentTrack.album ? `\342\200\224 ${currentTrack.album}` : \'\'}\n            </p>\n          </div>\n\n          <button\n            onClick={() => onToggleFavorite && onToggleFavorite(currentTrack.id)}\n            className={`p-2.5 rounded-full border transition-colors shrink-0 ${\n              currentTrack.isFavorite\n                ? \'bg-rose-950/60 border-rose-800/80 text-rose-400\'\n                : \'bg-slate-900 border-slate-800 text-slate-400 hover:text-white\'\n            }`}\n            title=\"Favorite Track\"\n          >\n            <Heart className={`w-5 h-5 ${currentTrack.isFavorite ? \'fill-rose-400\' : \'\'}`} />\n          </button>\n        </div>\n\n        {/* Interactive Scrubbing Slider */}\n        <div className=\"flex flex-col gap-1 px-1 my-2\">\n          <input\n            type=\"range\"\n            min=\"0\"\n            max={duration || 100}\n            step=\"0.5\"\n            value={activeTime}\n            onMouseDown={() => setIsDraggingSeek(true)}\n            onTouchStart={() => setIsDraggingSeek(true)}\n            onChange={(e) => setSeekValue(Number(e.target.value))}\n            onMouseUp={() => {\n              setIsDraggingSeek(false);\n              audioPlayerService.seek(seekValue);\n            }}\n            onTouchEnd={() => {\n              setIsDraggingSeek(false);\n              audioPlayerService.seek(seekValue);\n            }}\n            className=\"w-full accent-cyan-400 cursor-pointer h-1.5 bg-slate-800 rounded-lg appearance-none\"\n          />\n\n          <div className=\"flex items-center justify-between text-[11px] font-mono text-slate-400 px-0.5\">\n            <span>{formatTime(activeTime)}</span>\n            <span>-{formatTime(remainingTime)}</span>\n          </div>\n        </div>\n\n        {/* Primary Playback Controls */}\n        <div className=\"flex items-center justify-between px-2 py-2\">\n          {/* Shuffle */}\n          <button\n            onClick={() => audioPlayerService.toggleShuffle()}\n            className={`p-3 rounded-full transition-colors ${\n              isShuffle ? \'text-cyan-400 bg-cyan-950/40\' : \'text-slate-400 hover:text-white\'\n            }`}\n            title={isShuffle ? \'Shuffle On\' : \'Shuffle Off\'}\n          >\n            <Shuffle className=\"w-5 h-5\" />\n          </button>\n\n          {/* Previous Track */}\n          <button\n            onClick={() => audioPlayerService.previous()}\n            className=\"p-3 text-slate-200 hover:text-white rounded-full hover:bg-white/10 active:scale-95 transition-all\"\n            title=\"Previous Track\"\n          >\n            <SkipBack className=\"w-7 h-7 fill-slate-200\" />\n          </button>\n\n          {/* Large Neon Play/Pause Button */}\n          <button\n            onClick={() => audioPlayerService.togglePlay()}\n            className=\"w-16 h-16 rounded-full bg-gradient-to-tr from-blue-600 to-cyan-500 text-white flex items-center justify-center shadow-lg shadow-cyan-500/30 hover:scale-105 active:scale-95 transition-all\"\n            title={isPlaying ? \'Pause\' : \'Play\'}\n          >\n            {isPlaying ? (\n              <Pause className=\"w-7 h-7 fill-white\" />\n            ) : (\n              <Play className=\"w-7 h-7 fill-white ml-1\" />\n            )}\n          </button>\n\n          {/* Next Track */}\n          <button\n            onClick={() => audioPlayerService.next()}\n            className=\"p-3 text-slate-200 hover:text-white rounded-full hover:bg-white/10 active:scale-95 transition-all\"\n            title=\"Next Track\"\n          >\n            <SkipForward className=\"w-7 h-7 fill-slate-200\" />\n          </button>\n\n          {/* Repeat Mode */}\n          <button\n            onClick={() => audioPlayerService.toggleLoopMode()}\n            className={`p-3 rounded-full transition-colors ${\n              loopMode !== \'off\' ? \'text-cyan-400 bg-cyan-950/40\' : \'text-slate-400 hover:text-white\'\n            }`}\n            title={`Repeat: ${loopMode.toUpperCase()}`}\n          >\n            {loopMode === \'one\' ? <Repeat1 className=\"w-5 h-5\" /> : <Repeat className=\"w-5 h-5\" />}\n          </button>\n        </div>\n\n        {/* Bottom MX Volume Boost (up to 200%) */}\n        <div className=\"flex items-center gap-3 px-3 py-2 bg-slate-900/60 border border-slate-800/80 rounded-2xl mt-1\">\n          <button\n            onClick={() => audioPlayerService.toggleMute()}\n            className=\"text-slate-400 hover:text-white\"\n          >\n            <Volume2 className=\"w-4 h-4 text-emerald-400\" />\n          </button>\n          <input\n            type=\"range\"\n            min=\"0\"\n            max=\"2\"\n            step=\"0.05\"\n            value={volume}\n            onChange={(e) => audioPlayerService.setVolume(Number(e.target.value))}\n            className=\"flex-1 accent-emerald-400 cursor-pointer h-1.5\"\n          />\n          <span className=\"text-[11px] font-mono font-bold text-emerald-400 min-w-[45px] text-right\">\n            {Math.round(volume * 100)}%\n          </span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/MusicPlayerModal.tsx"
        }
        overwrite: true
      }
    }
