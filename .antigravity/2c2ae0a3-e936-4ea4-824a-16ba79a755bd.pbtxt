  view_file {
    absolute_path_uri: "file:///src/components/UCDownloadManager.tsx"
    start_line: 119
    end_line: 219
    content: "              </span>\n            </div>\n          </div>\n\n          {/* UC Turbo Boost Toggle Button */}\n          <button\n            onClick={handleToggleTurbo}\n            className={`px-3 py-1.5 rounded-full text-xs font-semibold flex items-center gap-1.5 transition-all shadow-sm ${\n              turboMode\n                ? \'bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 shadow-amber-500/20 ring-2 ring-amber-400/40\'\n                : \'bg-slate-800 text-slate-400 hover:text-white border border-slate-700\'\n            }`}\n            title=\"Toggle UC Cloud Acceleration Engine\"\n          >\n            <Zap className={`w-3.5 h-3.5 ${turboMode ? \'fill-slate-950\' : \'\'}`} />\n            <span>Turbo Boost: {turboMode ? \'ON\' : \'OFF\'}</span>\n          </button>\n        </div>\n\n        {/* Tab Buttons & New Action */}\n        <div className=\"flex items-center justify-between gap-2 pt-1\">\n          <div className=\"flex items-center bg-slate-950/80 p-1 rounded-xl border border-slate-800\">\n            <button\n              onClick={() => setActiveTab(\'downloading\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${\n                activeTab === \'downloading\'\n                  ? \'bg-blue-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <span>Downloading</span>\n              {downloadingTasks.length > 0 && (\n                <span className=\"px-1.5 py-0.2 text-[10px] bg-blue-900 text-blue-200 rounded-full font-mono\">\n                  {downloadingTasks.length}\n                </span>\n              )}\n            </button>\n            <button\n              onClick={() => setActiveTab(\'completed\')}\n              className={`px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1.5 ${\n                activeTab === \'completed\'\n                  ? \'bg-blue-600 text-white shadow-sm\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              <span>Completed</span>\n              {completedTasks.length > 0 && (\n                <span className=\"px-1.5 py-0.2 text-[10px] bg-slate-800 text-emerald-400 rounded-full font-mono\">\n                  {completedTasks.length}\n                </span>\n              )}\n            </button>\n          </div>\n\n          <button\n            onClick={() => setShowAddModal(true)}\n            className=\"px-3.5 py-1.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold flex items-center gap-1.5 transition-colors shadow-sm\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add URL</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Task List Container */}\n      <div className=\"flex-1 overflow-y-auto p-4 flex flex-col gap-3\">\n        {activeTab === \'downloading\' ? (\n          downloadingTasks.length === 0 ? (\n            <div className=\"flex-1 flex flex-col items-center justify-center p-8 text-center gap-3 text-slate-400\">\n              <FolderDown className=\"w-12 h-12 text-slate-700\" />\n              <div className=\"flex flex-col\">\n                <span className=\"text-sm font-semibold text-white\">No active downloads</span>\n                <span className=\"text-xs text-slate-400 mt-1 max-w-xs\">\n                  Download MP4 movies, music videos, or HLS stream captures directly using the browser or Add URL button.\n                </span>\n              </div>\n              <button\n                onClick={() => setShowAddModal(true)}\n                className=\"mt-2 px-4 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-medium text-slate-200 border border-slate-700 transition-colors\"\n              >\n                Start New Download\n              </button>\n            </div>\n          ) : (\n            downloadingTasks.map((task) => (\n              <div\n                key={task.id}\n                className=\"p-4 rounded-2xl bg-slate-900 border border-slate-800 shadow-md flex flex-col gap-3 hover:border-slate-700 transition-colors\"\n              >\n                <div className=\"flex items-start justify-between gap-3\">\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <div className=\"w-10 h-10 rounded-xl bg-blue-600/15 border border-blue-500/20 flex items-center justify-center shrink-0 text-blue-400\">\n                      <FileVideo className=\"w-5 h-5\" />\n                    </div>\n                    <div className=\"flex flex-col min-w-0\">\n                      <span className=\"text-xs font-bold text-white truncate max-w-xs\">\n                        {task.title}\n                      </span>\n                      <span className=\"text-[11px] font-mono text-slate-400\">\n                        {task.type.toUpperCase()} \302\267 /PlayThat/Downloads\n                      </span>"
    num_lines: 446
    num_bytes: 19816
