              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            {isInstallable ? ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <button"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                onClick={handleInstallClick}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
