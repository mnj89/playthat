  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Smartphone,\n  Download,\n  Share2,\n  PlusSquare,\n  MoreVertical,\n  Check,\n  Copy,\n  ExternalLink,\n  X,\n  QrCode,\n  ShieldCheck,\n  Package,\n  Terminal,\n  FileCheck,\n  AlertTriangle,\n} from \'lucide-react\';\nimport { usePWAInstall } from \'../hooks/usePWAInstall\';\nimport { PlayThatIcon } from \'./PlayThatIcon\';\n\ninterface PWAInstallModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onShowToast?: (msg: string) => void;\n}\n\nexport const PWAInstallModal: React.FC<PWAInstallModalProps> = ({\n  isOpen,\n  onClose,\n  onShowToast,\n}) => {\n  const { isInstallable, isInstalled, isIOS, isAndroid, install } = usePWAInstall();\n  const [activeTab, setActiveTab] = useState<\'apk\' | \'webapk\' | \'ios\' | \'cli\'>(\'apk\');\n  const [copied, setCopied] = useState(false);\n  const [copiedCli, setCopiedCli] = useState(false);\n\n  if (!isOpen) return null;\n\n  const appUrl = window.location.origin || \'https://ais-pre-mysyyuwzneh24y2ka6wxcs-69242674592.asia-east1.run.app\';\n  const pwaBuilderUrl = `https://www.pwabuilder.com/reportcard?site=${encodeURIComponent(appUrl)}`;\n\n  const handleCopyUrl = async () => {\n    try {\n      await navigator.clipboard.writeText(appUrl);\n      setCopied(true);\n      if (onShowToast) onShowToast(\'Link copied! Open on your phone browser.\');\n      setTimeout(() => setCopied(false), 2500);\n    } catch {\n      if (onShowToast) onShowToast(\'Failed to copy link\');\n    }\n  };\n\n  const handleCopyCli = async () => {\n    const cmd = `npx @bubblewrap/cli init --manifest=${appUrl}/manifest.webmanifest && npx @bubblewrap/cli build`;\n    try {\n      await navigator.clipboard.writeText(cmd);\n      setCopiedCli(true);\n      if (onShowToast) onShowToast(\'Bubblewrap build command copied!\');\n      setTimeout(() => setCopiedCli(false), 2500);\n    } catch {\n      if (onShowToast) onShowToast(\'Failed to copy command\');\n    }\n  };\n\n  const handleInstallClick = async () => {\n    const success = await install();\n    if (success) {\n      if (onShowToast) onShowToast(\'PlayThat! PRO WebAPK installed successfully!\');\n      onClose();\n    }\n  };\n\n  return (\n    <div\n      onClick={onClose}\n      className=\"fixed inset-0 z-50 bg-black/85 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 animate-in fade-in duration-200\"\n    >\n      <div\n        onClick={(e) => e.stopPropagation()}\n        className=\"w-full max-w-lg bg-zinc-950 border border-zinc-800 rounded-3xl p-5 sm:p-6 shadow-2xl flex flex-col gap-4 text-zinc-100 max-h-[92vh] overflow-y-auto\"\n      >\n        {/* Header */}\n        <div className=\"flex items-center justify-between border-b border-zinc-850 pb-3.5\">\n          <div className=\"flex items-center gap-3\">\n            <PlayThatIcon size={38} />\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-base font-bold text-white tracking-tight\">Android .APK & Installation</h3>\n                <span className=\"px-1.5 py-0.5 rounded bg-orange-500 text-black text-[10px] font-mono font-black\">\n                  .APK\n                </span>\n              </div>\n              <p className=\"text-xs text-zinc-400 mt-0.5\">\n                PlayThat! PRO package for Android devices\n              </p>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            className=\"p-2 rounded-xl bg-zinc-900 hover:bg-zinc-800 text-zinc-400 hover:text-white transition-colors\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Installed Status Badge */}\n        {isInstalled && (\n          <div className=\"p-3 rounded-2xl bg-emerald-950/40 border border-emerald-500/40 flex items-center gap-3 text-emerald-400 text-xs\">\n            <ShieldCheck className=\"w-5 h-5 text-emerald-400 shrink-0\" />\n            <span>\n              <strong>Application Installed:</strong> PlayThat! is active in standalone mode with full hardware acceleration.\n            </span>\n          </div>\n        )}\n\n        {/* Tab Switcher */}\n        <div className=\"grid grid-cols-4 p-1 rounded-2xl bg-zinc-900 border border-zinc-800 text-center\">\n          <button\n            onClick={() => setActiveTab(\'apk\')}\n            className={`py-2 px-1 text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-1.5 ${\n              activeTab === \'apk\'\n                ? \'bg-zinc-800 text-orange-400 shadow-sm\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            <Package className=\"w-3.5 h-3.5\" />\n            <span className=\"truncate\">Download .APK</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'webapk\')}\n            className={`py-2 px-1 text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-1.5 ${\n              activeTab === \'webapk\'\n                ? \'bg-zinc-800 text-orange-400 shadow-sm\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            <Smartphone className=\"w-3.5 h-3.5\" />\n            <span className=\"truncate\">Auto WebAPK</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'cli\')}\n            className={`py-2 px-1 text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-1.5 ${\n              activeTab === \'cli\'\n                ? \'bg-zinc-800 text-orange-400 shadow-sm\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            <Terminal className=\"w-3.5 h-3.5\" />\n            <span className=\"truncate\">Build APK</span>\n          </button>\n\n          <button\n            onClick={() => setActiveTab(\'ios\')}\n            className={`py-2 px-1 text-xs font-semibold rounded-xl transition-colors flex items-center justify-center gap-1.5 ${\n              activeTab === \'ios\'\n                ? \'bg-zinc-800 text-orange-400 shadow-sm\'\n                : \'text-zinc-400 hover:text-white\'\n            }`}\n          >\n            <Share2 className=\"w-3.5 h-3.5\" />\n            <span className=\"truncate\">iOS</span>\n          </button>\n        </div>\n\n        {/* Tab 1: Direct Download APK via PWABuilder / Cloud APK */}\n        {activeTab === \'apk\' && (\n          <div className=\"flex flex-col gap-3.5 text-xs text-zinc-300\">\n            {/* Direct 1-Click APK Generator Box */}\n            <div className=\"p-4 rounded-2xl bg-gradient-to-br from-orange-950/40 via-zinc-900 to-zinc-900 border border-orange-500/40 flex flex-col gap-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-white font-bold text-sm\">\n                  <Package className=\"w-4 h-4 text-orange-400\" />\n                  <span>1-Click .APK Generator</span>\n                </div>\n                <span className=\"text-[10px] font-mono px-2 py-0.5 rounded bg-orange-500/20 text-orange-400 border border-orange-500/30\">\n                  Android APK\n                </span>\n              </div>\n              <p className=\"text-zinc-400 text-xs leading-relaxed\">\n                Google & Microsoft\'s official <strong>PWABuilder</strong> packages this web app into a signed, ready-to-install Android <code className=\"text-orange-400 font-mono\">.apk</code> file in under 30 seconds.\n              </p>\n\n              <a\n                href={pwaBuilderUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"w-full py-3 px-4 rounded-xl bg-orange-500 hover:bg-orange-400 text-black font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-orange-500/25 text-center active:scale-[0.99]\"\n              >\n                <Download className=\"w-4 h-4 stroke-[2.5]\" />\n                <span>Generate & Download PlayThat.apk</span>\n                <ExternalLink className=\"w-3.5 h-3.5 stroke-[2.5] ml-1\" />\n              </a>\n            </div>\n\n            {/* How to Install Downloaded APK on Phone */}\n            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2.5\">\n              <span className=\"font-bold text-white flex items-center gap-2\">\n                <FileCheck className=\"w-4 h-4 text-orange-400\" />\n                How to install the downloaded .APK on your Android phone:\n              </span>\n              <ol className=\"list-decimal pl-5 space-y-1.5 text-zinc-400 text-xs\">\n                <li>Download the generated <strong className=\"text-zinc-200\">PlayThat.apk</strong> file.</li>\n                <li>Tap the downloaded file in your browser or Android File Manager.</li>\n                <li>\n                  If prompted with <em>\"Install unknown apps\"</em>, toggle <strong className=\"text-orange-400\">Allow from this source</strong> in Android Settings.\n                </li>\n                <li>Tap <strong className=\"text-white\">Install</strong> to complete!</li>\n              </ol>\n            </div>\n          </div>\n        )}\n\n        {/* Tab 2: Android Automatic WebAPK (Zero-download native APK) */}\n        {activeTab === \'webapk\' && (\n          <div className=\"flex flex-col gap-3.5 text-xs text-zinc-300\">\n            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2\">\n              <span className=\"font-bold text-white flex items-center gap-2\">\n                <Smartphone className=\"w-4 h-4 text-orange-400\" />\n                What is an Android WebAPK?\n              </span>\n              <p className=\"text-zinc-400 leading-relaxed\">\n                When you tap <strong>\"Install app\"</strong> in Chrome on Android, Google Chrome automatically mints a signed Android Package (<code className=\"text-orange-400 font-mono text-[11px]\">org.chromium.webapk.*.apk</code>) and installs it directly via the Android Package Manager.\n              </p>\n              <div className=\"p-2.5 rounded-xl bg-black/60 border border-zinc-800 text-[11px] text-zinc-300\">\n                It appears in Android <strong>Settings &gt; Apps</strong>, has its own notification channel, and runs natively with full-screen gesture support.\n              </div>\n            </div>\n\n            {/* Direct One-Click Install Button */}\n            {isInstallable ? (\n              <button\n                onClick={handleInstallClick}\n                className=\"w-full py-3.5 px-4 rounded-xl bg-orange-500 hover:bg-orange-400 text-black font-bold text-xs flex items-center justify-center gap-2 transition-all shadow-md shadow-orange-500/25 active:scale-[0.99]\"\n              >\n                <Download className=\"w-4 h-4 stroke-[2.5]\" />\n                <span>Install Native WebAPK on this Device Now</span>\n              </button>\n            ) : (\n              <div className=\"p-3 rounded-xl bg-zinc-900 border border-zinc-850 flex flex-col gap-2\">\n                <span className=\"font-bold text-white\">Manual 2-Step Android Install:</span>\n                <p className=\"text-zinc-400\">\n                  1. In Android Chrome, tap the <MoreVertical className=\"w-3.5 h-3.5 text-zinc-300 inline\" /> menu in top right.<br />\n                  2. Tap <strong>\"Install app\"</strong> or <strong>\"Add to Home screen\"</strong>.\n                </p>\n              </div>\n            )}\n          </div>\n        )}\n\n        {/* Tab 3: Build APK via CLI / Bubblewrap */}\n        {activeTab === \'cli\' && (\n          <div className=\"flex flex-col gap-3 text-xs text-zinc-300\">\n            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2\">\n              <span className=\"font-bold text-white flex items-center gap-2\">\n                <Terminal className=\"w-4 h-4 text-orange-400\" />\n                Compile .APK with Google Bubblewrap CLI\n              </span>\n              <p className=\"text-zinc-400 leading-relaxed text-[11px]\">\n                If you have Node.js and Android SDK installed on your PC, you can compile the production APK in two commands:\n              </p>\n              <div className=\"relative p-2.5 rounded-xl bg-black font-mono text-[11px] text-orange-300 border border-zinc-800 overflow-x-auto\">\n                <code>\n                  npx @bubblewrap/cli init --manifest={appUrl}/manifest.webmanifest<br />\n                  npx @bubblewrap/cli build\n                </code>\n              </div>\n              <button\n                onClick={handleCopyCli}\n                className=\"self-end px-3 py-1.5 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-white text-[11px] font-semibold flex items-center gap-1.5 transition-colors border border-zinc-700\"\n              >\n                {copiedCli ? <Check className=\"w-3.5 h-3.5 text-emerald-400\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n                <span>{copiedCli ? \'Copied Command!\' : \'Copy CLI Command\'}</span>\n              </button>\n            </div>\n            <p className=\"text-zinc-500 text-[11px] px-1\">\n              Outputs <code className=\"text-zinc-300\">app-release-signed.apk</code> ready to sideload via <code className=\"text-zinc-300\">adb install</code> or direct transfer.\n            </p>\n          </div>\n        )}\n\n        {/* Tab 4: iOS Safari */}\n        {activeTab === \'ios\' && (\n          <div className=\"flex flex-col gap-3 text-xs text-zinc-300\">\n            <div className=\"p-3.5 rounded-2xl bg-zinc-900/80 border border-zinc-850 flex flex-col gap-2\">\n              <span className=\"font-bold text-white flex items-center gap-2\">\n                <Share2 className=\"w-4 h-4 text-orange-400\" />\n                iOS (iPhone / iPad) Home Screen Installation\n              </span>\n              <p className=\"text-zinc-400 leading-relaxed text-[11px]\">\n                Apple does not support direct .APK files (iOS uses IPA). To run PlayThat! on iPhone:\n              </p>\n              <ol className=\"list-decimal pl-5 space-y-1 text-zinc-400 text-xs\">\n                <li>Open this link in <strong className=\"text-zinc-200\">Safari</strong>.</li>\n                <li>Tap the <strong className=\"text-orange-400\">Share</strong> icon at the bottom.</li>\n                <li>Scroll and tap <strong className=\"text-white\">Add to Home Screen</strong>.</li>\n              </ol>\n            </div>\n          </div>\n        )}\n\n        {/* Share / Copy App Link Box */}\n        <div className=\"flex items-center gap-2 p-2.5 rounded-2xl bg-zinc-900 border border-zinc-800\">\n          <input\n            type=\"text\"\n            readOnly\n            value={appUrl}\n            className=\"flex-1 bg-transparent text-xs font-mono text-zinc-300 outline-none truncate px-1\"\n          />\n          <button\n            onClick={handleCopyUrl}\n            className=\"px-3 py-1.5 rounded-xl bg-orange-500 hover:bg-orange-400 text-black text-xs font-bold flex items-center gap-1.5 transition-colors shrink-0\"\n          >\n            {copied ? <Check className=\"w-3.5 h-3.5\" /> : <Copy className=\"w-3.5 h-3.5\" />}\n            <span>{copied ? \'Copied!\' : \'Copy Link\'}</span>\n          </button>\n        </div>\n\n        {/* Footer Close */}\n        <button\n          onClick={onClose}\n          className=\"w-full py-2.5 rounded-2xl bg-zinc-900 hover:bg-zinc-850 text-zinc-400 hover:text-white text-xs font-semibold transition-colors\"\n        >\n          Close\n        </button>\n      </div>\n    </div>\n  );\n};\n"
